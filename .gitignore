__pycache__/
*.pyc
node_modules/
.pytest_cache/
.lycheecache
mutants/
reports/
.artifacts/
.cautilus/
.agents/charness-discovery/
.charness/quality/bootstrap.json
.charness/quality/runtime-signals.json
.charness/quality/runtime-smoothing.json
.charness/quality/history/runtime-signals-*.jsonl
.charness/bootstrap-python/
.charness/retro/
.charness/closeout/
.charness/tasks/
.charness/hitl/runtime/
.charness/reviewer-boundary/
.charness/dup-ratchet*
.charness/t-events/
.charness/usage-episodes/
integrations/locks/*.json
!integrations/locks/.gitkeep
!integrations/locks/lock.schema.json
plugins/*/integrations/locks/*.json
!plugins/*/integrations/locks/.gitkeep
!plugins/*/integrations/locks/lock.schema.json
skills/support/generated/*
!skills/support/generated/.gitkeep
pytest-tmp/
charness-artifacts/efficiency/**/preserved/**/stream.jsonl

# Python coverage data (ad-hoc local runs)
.coverage
.coverage.*

# Personal Claude Code overrides (local sandbox permissions, etc.)
.claude/settings.local.json

# Ephemeral specdown config written by scripts/specdown_ephemeral_config.py so an
# automated gate does not rewrite the tracked .charness/specdown/ report.
.specdown.ephemeral.json
