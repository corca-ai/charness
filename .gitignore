# The plugin export is GENERATED, not authored. `charness init`/`update` and
# `.githooks/pre-push` both run `scripts/sync_root_plugin_manifests.py`, and the
# Claude marketplace reads `./plugins/charness` from the checkout ON DISK -- it
# never needed to be in history. Tracking it cost 1,042 files, 11 MB, and 934 of
# the last 2,498 commits (37%) as pure regenerated churn, and it put a byte-identical
# second copy of every script into every corpus scan and every test fixture copy.
plugins/
.charness/retro/
.charness/closeout/
.charness/hitl/runtime/
.charness/reviewer-boundary/
.charness/reviewer-round-2/
# File-backed bounded-review runtime is evidence input, not a tracked source surface.
# Keep every round-specific runtime ignored before boundary snapshots are taken.
.charness/reviewer-round-*/
# Critique angle prompts, carriers, receipts, and stderr/stdout are likewise
# ephemeral worker runtime. Durable findings belong under charness-artifacts/critique/.
.charness/critique/
.charness/dup-ratchet*
.charness/standing-pytest/
.charness/quality-failure-logs/
integrations/locks/*.json
!integrations/locks/.gitkeep
!integrations/locks/lock.schema.json
skills/support/generated/*
!skills/support/generated/.gitkeep
pytest-tmp/
charness-artifacts/efficiency/**/preserved/**/stream.jsonl

# Python coverage data (ad-hoc local runs)
.coverage
.coverage.*

# Personal Claude Code overrides (local sandbox permissions, etc.)
.claude/settings.local.json

# Host-created subagent worktrees. A worktree-isolated subagent gets a checkout
# INSIDE this repo, and while it runs the directory is a live embedded git repo:
# `git add -A` stages it as one (the staged-worktree gate refuses the commit), and
# `collect_changed_paths` reports it as a changed path with no owning surface, which
# turns the closeout-bundle and final-bundle preflights red for the duration. Both
# symptoms are the same missing line: the changed-path collector reads
# `git ls-files --others --exclude-standard`, so ignoring the path answers both.
# Scoped to `worktrees/` on purpose -- `.claude/agents/` is tracked.
.claude/worktrees/

# Ephemeral specdown config written by scripts/specdown_ephemeral_config.py so an
# automated gate does not rewrite the tracked .charness/specdown/ report.
.specdown.ephemeral.json
