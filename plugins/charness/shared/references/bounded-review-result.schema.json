{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://charness.corca.ai/schemas/bounded-review-result.v1.json",
  "title": "Charness bounded review result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "lens",
    "packet_sha256",
    "reviewed_input_identity_sha256",
    "verdict",
    "findings",
    "counterweight_triage",
    "next_move",
    "non_claims"
  ],
  "properties": {
    "kind": {
      "type": "string",
      "const": "charness.bounded_review.v1"
    },
    "lens": {
      "type": "string",
      "minLength": 1
    },
    "packet_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "reviewed_input_identity_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "verdict": {
      "type": "string",
      "enum": ["pass", "block", "defer"]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "severity", "summary", "evidence", "action"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "severity": {"type": "string", "minLength": 1},
          "summary": {"type": "string", "minLength": 1},
          "evidence": {"type": "array", "items": {"type": "string"}},
          "action": {"type": "string", "minLength": 1}
        }
      }
    },
    "counterweight_triage": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["concern", "bin", "disposition"],
        "properties": {
          "concern": {"type": "string", "minLength": 1},
          "bin": {"type": "string", "minLength": 1},
          "disposition": {"type": "string", "minLength": 1}
        }
      }
    },
    "next_move": {
      "type": "string",
      "minLength": 1
    },
    "non_claims": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    }
  }
}
