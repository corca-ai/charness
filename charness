def main(argv: list[str] | None = None) -> int:
    raw_argv = list(sys.argv[1:] if argv is None else argv)
    if raw_argv == ["--version"]:
        raw_argv = ["version"]
    parser = build_parser()
    args = parser.parse_args(raw_argv)
    is_worktree_exec = (
        getattr(args, "command", None) == "worktree"
        and getattr(args, "worktree_command", None) == "exec"
    )
    is_task_run = (
        getattr(args, "command", None) == "task" and getattr(args, "task_command", None) == "run"
    )
    runtime_configured = False
    if not (is_worktree_exec or is_task_run):
        runtime_configured = _configure_runtime_for_repo(
            _runtime_repo_for_args(args), required=False
        )
    if not (
        getattr(args, "command", None) == "version"
        and not getattr(args, "verbose", False)
        and not getattr(args, "check", False)
    ) and not (is_worktree_exec or is_task_run):
        maybe_record_self_version_state(args)
    if _EARLY_BYTECODE_GUARD and runtime_configured:
        sys.dont_write_bytecode = False
    try:
        return args.func(args)
    finally:
        if _EARLY_BYTECODE_GUARD:
            sys.dont_write_bytecode = False


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except CharnessError as exc:
        print(str(exc), file=sys.stderr)
        raise SystemExit(1)
