def __getattr__(name: str):
    """Lazy payload access for in-process callers (tests call helpers directly)."""
    module_name = _CLI_FEATURE_OWNER.get(name)
    if module_name is None:
        raise AttributeError(f"module {__name__!r} has no attribute {name!r}")  # pragma: no cover - in-process-only reachability; entry coverage measures spawned runs.
    return _load_feature(module_name, name)


