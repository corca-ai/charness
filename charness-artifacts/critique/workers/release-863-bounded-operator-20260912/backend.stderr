  {
    "carrier_path": ".charness/scratch/critique-review/review-6390f5374984acd028e8aa9b0e4d9f08/semantic-input/0014-content.bin",
    "carrier_sha256": "5240200b0dc756d0fbeff02607f3bf29ba9574b3e0dee895cb494d5bcda2d9f9",
