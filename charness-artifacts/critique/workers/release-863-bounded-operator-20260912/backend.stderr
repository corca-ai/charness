gration_fixture\": {\n            \"packet_preparation\": \"installed plugin prepare_packet.py\",\n            \"review_execution\": \"installed plugin run_review.py with file-backed worker\",\n            \"retained_recovery\": \"installed plugin --resume-retained-attempt\",\n      \"timeout_reconciliation\": \"real installed reviewer inside the timed-out callback, retained same-attempt recovery, process-group cleanup, bounded probes, and terminal readback\",\n            \"targeted_rerun\": \"installed plugin run_review.py against the changed follow-up packet\",\n            \"stage_gate_negative_control\": \"shared dispatcher blocks publish after blocked/deferred/failed/unproven or contradictory-open prerequisites\",\n      \"negative_controls\": [\n        \"replace partial-result and update its manifest descriptor while leaving backend.stdout unchanged\",\n        \"change one reviewer packet identity and derive only that reviewer as rerunnable\",\n        \"substitute a readable terminal carrier from another attempt and require reconciliation to remain pending\",\n        \"substitute a readable non-terminal carrier for the expected attempt and require reconciliation to remain pending\",\n        \"launch a non-returning reviewer descendant and require the owned process group to terminate it\",\n        \"make artifact discovery never return and require initial/reconciliation probes to remain bounded\",\n        \"run a command worker under spawn and fail a non-serializable callback closed as blocked-unproven\",\n        \"return a reviewer result while its child remains alive and require bounded shutdown\",\n        \"read and resume a release-run receipt from a fresh process without replaying completed stages\",\n        \"reject a conflicting packet for the same intent at both resume and new-run creation\"\n        ,\"reject foreign stage/attempt/key/run/readback identities during crash recovery\",\n                \"serialize two concurrent resume processes so one executes and one reads back complete\",\n                \"reject a sequential second receipt path for the same intent, scope, and packet\",\n                \"serialize concurrent receipt creation so one canonical owner executes and the loser has no stage effect\",\n                \"block a terminal closed stage until an adapter readback proves its effect state\",\n                \"reject durable creation without a resume command\",\n                \"keep requested and observed bindings separate for foreign receipt contention\",\n                \"retain stage attempt and readback history when an authorized retry fails\"\n      ]\n    },\n    \"sample_measurements\": {\n            \"initial_review_count\": 2,\n            \"diagnostic_failure_review_count\": 1,\n            \"resume_review_count\": 1,\n      \"timeout_reviewer_invocation_count\": 2,\n      \"recovery_invocation_count\": 1,\n            \"review_retry_count\": 1,\n            \"targeted_rerun_count\": 1,\n            \"total_review_invocations\": 6,\n            \"parallel_review_elapsed_seconds\": 1.243144,\n            \"dogfood_elapsed_seconds\": 10.95334,\n            \"timeout_probe_seconds\": 0.05,\n            \"partial_only_reuse\": true,\n            \"targeted_rerun_executed\": true,\n      \"timeout_reconciled\": true,\n      \"timeout_identity_joined\": true,\n      \"timeout_negative_controls_pending\": true,\n      \"timeout_resume_readback\": true,\n      \"timeout_successor_attempt\": false,\n      \"timeout_process_group_clean\": true,\n      \"timeout_probes_bounded\": true,\n      \"spawn_command_boundary_verified\": true,\n      \"result_ready_child_cleanup_verified\": true,\n      \"durable_release_run_receipt\": true,\n      \"durable_release_resume_cross_process\": true,\n      \"durable_release_completed_stage_replay\": false,\n      \"intent_packet_conflict_refused\": true,\n      \"durable_release_crash_resume\": true,\n      \"durable_release_inflight_readback\": true,\n      \"durable_release_idempotency_key_preserved\": true,\n      \"durable_release_readback_join_controls\": true,\n            \"durable_release_concurrent_resume_single_owner\": true,\n            \"durable_release_duplicate_intent_refused\": true,\n            \"durable_release_concurrent_creation_single_owner\": true,\n            \"durable_release_terminal_closed_readback_required\": true,\n            \"durable_release_resume_command_required\": true,\n            \"durable_release_foreign_contention_binding_separated\": true,\n            \"durable_release_retry_history_preserved\": true,\n      \"durable_release_readback_identity_recomputed\": true,\n      \"durable_release_lock_contention_bounded\": true,\n            \"workflow_blocked_by\": \"critique\",\n            \"downstream_not_run\": [\n                \"claims-review\",\n                \"quality\",\n                \"publish\"\n            ],\n      \"critical_path\": [\n        \"release\",\n        \"critique\",\n        \"claims-review\",\n        \"quality\",\n        \"publish\"\n      ],\n      \"non_implicit_stages\": [\n        \"implementation\",\n        \"issue-closeout\",\n        \"full-quality\"\n      ]\n    },\n    \"adapter_probe\": \".agents/release-adapter.yaml:fresh_checkout_probes\",\n    \"publish_executed\": false\n  },\n  \"non_claims\": [\n    \"This artifact does not claim that a public release was pushed or published.\",\n    \"The dogfood timing is a deterministic contract sample, not a prediction of external model latency.\",\n    \"The reported baseline combines the operator's incident measurement with the retained reviewer receipts; it is not a cross-repo benchmark.\",\n    \"Issue closeout for #764, #812, or #813 is outside this implementation slice.\"\n  ]\n}\n",
