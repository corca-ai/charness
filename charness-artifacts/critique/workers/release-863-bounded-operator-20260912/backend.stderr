    "prompt_content": "{\n  \"kind\": \"charness.bounded_review.v1\",\n  \"lens\": \"Operator and publication checklist\",\n  \"packet_sha256\": \"6e9f145db2761d4b8c1cf53d41031b6f430066d3684b62ded65ca077948c6f46\",\n  \"reviewed_input_identity_sha256\": \"cbd552ae77b16df3e4e209ad59ba2523746c2331d1a3f1da501629b45283ce44\",\n  \"verdict\": \"block\",\n  \"target_observations\": null,\n  \"findings\": [\n    {\n      \"id\": \"OP-001\",\n      \"severity\": \"blocker\",\n      \"summary\": \"The Claude review backend does not enforce read-only execution or credential isolation.\",\n      \"evidence\": [\n        \"run-local-eval-test.mjs applies --sandbox only through codexArgs; claudeArgs has no sandbox enforcement and makes permission/tool restrictions optional.\",\n        \"runClaudeEvaluation passes process.env wholesale and does not isolate HOME/config/MCP state.\",\n        \"The prompt-level instruction not to modify files is not an enforcement boundary; the native tests cover parsing and exit handling, not mutation or credential access.\"\n      ],\n      \"action\": \"Block release use of this backend until it has an enforced read-only tool policy, isolated config/environment, and mutation/credential-canary tests.\"\n    },\n    {\n      \"id\": \"OP-002\",\n      \"severity\": \"blocker\",\n      \"summary\": \"The default isolated Codex home can place copied credentials inside the review workspace.\",\n      \"evidence\": [\n        \"codex-eval-runtime.mjs falls back to options.repoRoot/.charness for temporaryCodexHome when CHARNESS_RUNTIME_ROOT is absent.\",\n        \"authMode=inherit copies source auth.json into that temporary home, while runCodexEvaluation gives the child that CODEX_HOME and the workspace.\",\n        \"The tests only assert that the path is an owned scratch path; they do not establish that it is outside the model-readable workspace or that credentials are inaccessible to review tools.\"\n      ],\n      \"action\": \"Put credential-bearing runtime state outside the workspace or behind a host-mediated auth boundary, scrub tool-visible secrets, and add a canary test proving the reviewer cannot read them.\"\n    },\n    {\n      \"id\": \"OP-003\",\n      \"severity\": \"blocker\",\n      \"summary\": \"A non-claims release can become published but non-resumable when post-publication closeout fails before its carrier commit.\",\n      \"evidence\": [\n        \"publish_release_common.py runs install refresh, installed readback, release observer, and issue closeout before _commit_final_release_artifact.\",\n        \"publish_release_resume.py has explicit post-publication recovery only for classified carrier/final phases; otherwise a state with tag_remote and release_exists raises that the publish is already complete.\",\n        \"Thus a failure in an earlier closeout step can leave no durable post-publication phase marker while resume treats the external publication as terminal.\"\n      ],\n      \"action\": \"Persist a durable post-publication closeout marker before the first closeout step, or make resume recognize and safely continue an externally published release with incomplete closeout; add failure-injection tests for each pre-carrier step.\"\n    },\n    {\n      \"id\": \"OP-004\",\n      \"severity\": \"blocker\",\n      \"summary\": \"The reader-facing recovery advice is destructive and not copy-safe.\",\n      \"evidence\": [\n        \"publish_release_resume.py tells the published marker case to use git reset --hard <claims-evidence-commit>.\",\n        \"The message contains a placeholder rather than a verified commit identity and gives no backup, clean-tree check, or confirmation that only the generated commit will be removed.\",\n        \"The pre-publication branch says to reset to one prepared record without identifying the exact safe command or boundary.\"\n      ],\n      \"action\": \"Replace this with non-destructive inspection and backup instructions, print verified commit IDs, and require explicit operator confirmation before any history rewrite.\"\n    },\n    {\n      \"id\": \"OP-005\",\n      \"severity\": \"high\",\n      \"summary\": \"The install-facing import smoke is not established as an isolated fresh-install check.\",\n      \"evidence\": [\n        \"validate_packaging_install_surface.py defines smoke_exported_plugin_imports but the bound validate_materialized_plugin_export path shows no call to it; any external caller is outside this review input.\",\n        \"The smoke subprocess runs with cwd=Path.cwd(), which can leave the source checkout on Python's import path and allow source-tree modules to mask missing exported-package imports.\",\n        \"The packet does not bind the smoke template or a consumer-level invocation that proves this isolation.\"\n      ],\n      \"action\": \"Bind the smoke to the packaging validator, run it from an isolated directory with only the exported tree importable, and add a deliberate dev-tree-only import failure test.\"\n    },\n    {\n      \"id\": \"OP-006\",\n      \"severity\": \"high\",\n      \"summary\": \"Fresh-checkout probing has an exit-0 opt-out that can be mistaken for release proof.\",\n      \"evidence\": [\n        \"check_fresh_checkout_probes.py returns status=not_configured and exit 0 when the adapter declares no probes.\",\n        \"The current packet does not include the v8.6.3 release adapter or a release-policy check requiring probes, so it cannot establish that fresh-checkout behavior was tested.\"\n      ],\n      \"action\": \"Require at least one release probe for v8.6.3, or explicitly render and gate not_configured as an accepted opt-out rather than a passed fresh-checkout claim.\"\n    }\n  ],\n  \"counterweight_triage\": [\n    {\n      \"concern\": \"Claude review execution can mutate the checkout or access host credentials.\",\n      \"bin\": \"Act Before Ship\",\n      \"disposition\": \"Critical boundary failure; prompt-only restrictions are insufficient.\"\n    },\n    {\n      \"concern\": \"Codex auth material can be readable from the workspace.\",\n      \"bin\": \"Act Before Ship\",\n      \"disposition\": \"Credential isolation must be proven before release review execution.\"\n    },\n    {\n      \"concern\": \"Published releases may strand before closeout recovery is recorded.\",\n      \"bin\": \"Act Before Ship\",\n      \"disposition\": \"The publication boundary needs a durable resumable state before post-publication side effects.\"\n    },\n    {\n      \"concern\": \"Recovery guidance uses an unsafe placeholder reset command.\",\n      \"bin\": \"Act Before Ship\",\n      \"disposition\": \"Reader-facing instructions must be safe and directly executable.\"\n    },\n    {\n      \"concern\": \"Install smoke wiring and import-path isolation are not bound by the packet.\",\n      \"bin\": \"Valid but Defer\",\n      \"disposition\": \"Do not count install proof until the isolated consumer invocation is evidenced.\"\n    },\n    {\n      \"concern\": \"No declared fresh-checkout probes can exit successfully.\",\n      \"bin\": \"Valid but Defer\",\n      \"disposition\": \"Resolve against the v8.6.3 adapter policy before claiming fresh-checkout coverage.\"\n    },\n    {\n      \"concern\": \"Purely internal task-run and lesson-ledger details outside the operator/publication boundary.\",\n      \"bin\": \"Over-Worry\",\n      \"disposition\": \"Ignored per scope.\"\n    },\n    {\n      \"concern\": \"Failure-injection and credential-canary tests for the repairs.\",\n      \"bin\": \"Bundle Anyway\",\n      \"disposition\": \"Add with the boundary fixes as the minimum follow-up evidence.\"\n    }\n  ],\n  \"next_move\": \"Block v8.6.3 publication. Repair enforced backend isolation, workspace credential handling, pre-closeout resume state, and recovery instructions; then run isolated install/import and fresh-checkout proof with a release-bound receipt.\",\n  \"non_claims\": [\n    \"No current workspace, live release, clone, install, or generated-mirror state was inspected; this result judges only the identity-bound inline payload.\",\n    \"The packet does not establish a current generated-surface synchronization receipt or installed readback.\",\n    \"#764 remains deferred and is not judged here.\"\n  ],\n  \"capability_non_claims\": [],\n  \"capability_non_claims_sha256\": \"4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945\"\n}\n",
