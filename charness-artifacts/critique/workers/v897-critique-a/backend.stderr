  {
    "carrier_path": ".charness/scratch/critique-review/review-8df11fdd8c182a4fa6067397867cad93/semantic-input/0005-content.bin",
    "carrier_sha256": "6223b4b0c5795bc795f8871d37fbe9ea53f1b62c43a21f6e738dc796ce39cfb5",
