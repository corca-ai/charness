  {
    "carrier_path": ".charness/scratch/critique-review/review-6e8570cedbd943f81b26213bf6171926/semantic-input/0004-content.bin",
    "carrier_sha256": "9b3ef8d40cc2f80873ecfcf6f11ca28faca4acca4a098efc92e81b27ad6bfc47",
    "content_sha256": "31e8d5473e5c67173884c56c59d55407197bd52d63473a215e7baf0f10f3a71c",
    "disposition": "present",
    "path": "tests/charness_cli/test_task_run_merge_checkpoint_877.py",
    "prompt_content": "\"\"\"Interrupted-lane WIP checkpoint across merges and clean trees (#877).\n\nA lane that ends mid-merge must either commit the resolved merge as its\nWIP merge candidate or report a distinct `unresolved merge in progress`\nblocker naming the conflicted paths — never a generic partial-commit\nfailure. A lane that ends with a clean tree on top of its own commits\nnames the branch tip as the candidate instead of failing the checkpoint.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport subprocess\nfrom pathlib import Path\n\nimport pytest\n\nfrom scripts.task_run import task_run_lane_runner\nfrom scripts.task_run.task_run_contract import MixedScopeMergeError, UnresolvedMergeError\n\nfrom .test_task_run_fixtures import _codex, _commit, _git, _repo, _run\n\n_SPECS = [{\"path\": \"module.py\", \"kind\": \"exact\"}]\n_IDENTITY = (\"-c\", \"user.email=test@example.com\", \"-c\", \"user.name=test\")\n\n\ndef _git_no_check(repo: Path, *args: str) -> subprocess.CompletedProcess[str]:\n    return subprocess.run(\n        [\"git\", *args], cwd=repo, check=False, capture_output=True, text=True\n    )\n\n\ndef _start_merge(repo: Path) -> None:\n    _git(repo, \"checkout\", \"-qb\", \"side-change\")\n    (repo / \"module.py\").write_text(\"SIDE = 1\\n\", encoding=\"utf-8\")\n    _commit(repo, \"side change\", \"module.py\")\n    _git(repo, \"checkout\", \"-q\", \"-\")\n    (repo / \"module.py\").write_text(\"LANE = 1\\n\", encoding=\"utf-8\")\n    _commit(repo, \"lane change\", \"module.py\")\n    merge = _git_no_check(repo, *_IDENTITY, \"merge\", \"--no-commit\", \"side-change\")\n    assert merge.returncode != 0\n\n\ndef test_resolved_merge_commits_a_wip_merge_candidate(tmp_path: Path) -> None:\n    repo = _repo(tmp_path)\n    base = _git(repo, \"rev-parse\", \"HEAD\").stdout.strip()\n    _start_merge(repo)\n    _git(repo, \"checkout\", \"--ours\", \"--\", \"module.py\")\n    _git(repo, \"add\", \"--\", \"module.py\")\n\n    commit = task_run_lane_runner._checkpoint_interrupted_lane(\n        repo, base, [dict(_SPECS[0])]\n    )\n\n    assert commit[\"status\"] == \"committed\"\n    parents = (\n        _git(repo, \"rev-list\", \"--parents\", \"-n\", \"1\", commit[\"sha\"])\n        .stdout.strip()\n        .split()\n    )\n    assert len(parents) == 3\n\n\ndef test_unresolved_merge_raises_a_distinct_blocker(tmp_path: Path) -> None:\n    repo = _repo(tmp_path)\n    base = _git(repo, \"rev-parse\", \"HEAD\").stdout.strip()\n    _start_merge(repo)\n\n    with pytest.raises(UnresolvedMergeError) as raised:\n        task_run_lane_runner._checkpoint_interrupted_lane(\n            repo, base, [dict(_SPECS[0])]\n        )\n\n    assert raised.value.conflicted_paths == [\"module.py\"]\n    assert str(raised.value) == \"unresolved merge in progress: module.py\"\n\n\ndef test_resolved_merge_with_out_of_scope_changes_is_not_committed(\n    tmp_path: Path,\n) -> None:\n    \"\"\"A resolved merge touching out-of-scope paths keeps the worktree and reports.\"\"\"\n    repo = _repo(tmp_path)\n    (repo / \"other.py\").write_text(\"OTHER = 1\\n\", encoding=\"utf-8\")\n    _commit(repo, \"add out-of-scope file\", \"other.py\")\n    base = _git(repo, \"rev-parse\", \"HEAD\").stdout.strip()\n    _start_merge(repo)\n    (repo / \"other.py\").write_text(\"OTHER = 2\\n\", encoding=\"utf-8\")\n    _git(repo, \"checkout\", \"--ours\", \"--\", \"module.py\")\n    _git(repo, \"add\", \"--\", \"module.py\", \"other.py\")\n    head_before = _git(repo, \"rev-parse\", \"HEAD\").stdout.strip()\n\n    with pytest.raises(MixedScopeMergeError) as raised:\n        task_run_lane_runner._checkpoint_interrupted_lane(\n            repo, base, [dict(_SPECS[0])]\n        )\n\n    assert raised.value.out_of_scope_paths == [\"other.py\"]\n    assert \"outside the declared scope: other.py\" in str(raised.value)\n    assert _git(repo, \"rev-parse\", \"HEAD\").stdout.strip() == head_before\n\n\ndef test_resolved_merge_with_unrelated_residue_is_not_committed(\n    tmp_path: Path,\n) -> None:\n    repo = _repo(tmp_path)\n    base = _git(repo, \"rev-parse\", \"HEAD\").stdout.strip()\n    _start_merge(repo)\n    _git(repo, \"checkout\", \"--ours\", \"--\", \"module.py\")\n    _git(repo, \"add\", \"--\", \"module.py\")\n    (repo / \"stray_untracked.py\").write_text(\"STRAY = 1\\n\", encoding=\"utf-8\")\n    (repo / \"staged_extra.py\").write_text(\"EXTRA = 1\\n\", encoding=\"utf-8\")\n    _git(repo, \"add\", \"--\", \"staged_extra.py\")\n\n    with pytest.raises(MixedScopeMergeError) as raised:\n        task_run_lane_runner._checkpoint_interrupted_lane(\n            repo, base, [dict(_SPECS[0])]\n        )\n\n    assert raised.value.out_of_scope_paths == [\"staged_extra.py\", \"stray_untracked.py\"]\n\n\ndef test_clean_tree_with_lane_commits_reuses_the_tip(tmp_path: Path) -> None:\n    repo = _repo(tmp_path)\n    base = _git(repo, \"rev-parse\", \"HEAD\").stdout.strip()\n    (repo / \"module.py\").write_text(\"VALUE = 2\\n\", encoding=\"utf-8\")\n    tip = _commit(repo, \"lane commit\", \"module.py\")\n\n    commit = task_run_lane_runner._checkpoint_interrupted_lane(\n        repo, base, [dict(_SPECS[0])]\n    )\n\n    assert commit[\"status\"] == \"committed\"\n    assert commit[\"sha\"] == tip\n    assert commit[\"correctness_verified\"] is False\n\n\ndef test_failed_lane_mid_merge_reports_the_distinct_blocker(tmp_path: Path) -> None:\n    repo = _repo(tmp_path)\n    executable = _codex(\n        tmp_path,\n        \"branch=$(git symbolic-ref --short HEAD)\\n\"\n        \"git checkout -qb side-change\\n\"\n        \"printf 'SIDE = 1\\\\n' > module.py\\n\"\n        \"git add -- module.py\\n\"\n        \"git -c user.email=test@example.com -c user.name=test commit -m 'side change'\\n\"\n        'git checkout -q \"$branch\"\\n'\n        \"printf 'LANE = 1\\\\n' > module.py\\n\"\n        \"git add -- module.py\\n\"\n        \"git -c user.email=test@example.com -c user.name=test commit -m 'lane change'\\n\"\n        \"git -c user.email=test@example.com -c user.name=test merge --no-commit side-change\\n\"\n        \"exit 1\",\n    )\n\n    payload = _run(repo, tmp_path, executable)\n\n    assert payload[\"status\"] == \"failed\", payload\n    assert payload[\"blocker\"] == \"unresolved merge in progress: module.py\"\n    assert payload[\"candidate\"][\"commit\"][\"status\"] == \"failed\"\n    assert (\n        payload[\"candidate\"][\"commit\"][\"error\"]\n        == \"unresolved merge in progress: module.py\"\n    )\n\n\ndef test_failed_lane_with_mixed_merge_reports_the_scope_blocker(\n    tmp_path: Path,\n) -> None:\n    repo = _repo(tmp_path)\n    executable = _codex(\n        tmp_path,\n        \"branch=$(git symbolic-ref --short HEAD)\\n\"\n        \"git checkout -qb side-change\\n\"\n        \"printf 'SIDE = 1\\\\n' > module.py\\n\"\n        \"git add -- module.py\\n\"\n        \"git -c user.email=test@example.com -c user.name=test commit -m 'side change'\\n\"\n        'git checkout -q \"$branch\"\\n'\n        \"printf 'LANE = 1\\\\n' > module.py\\n\"\n        \"git add -- module.py\\n\"\n        \"git -c user.email=test@example.com -c user.name=test commit -m 'lane change'\\n\"\n        \"git -c user.email=test@example.com -c user.name=test merge --no-commit side-change\\n\"\n        \"git checkout -q --ours -- module.py\\n\"\n        \"git add -- module.py\\n\"\n        \"printf 'OTHER = 1\\\\n' > other.py\\n\"\n        \"exit 1\",\n    )\n\n    payload = _run(repo, tmp_path, executable)\n\n    assert payload[\"status\"] == \"failed\", payload\n    assert (\n        payload[\"blocker\"]\n        == \"resolved merge changes paths outside the declared scope: other.py\"\n    )\n\n\ndef test_failed_lane_with_clean_tree_names_the_tip(tmp_path: Path) -> None:\n    repo = _repo(tmp_path)\n    executable = _codex(\n        tmp_path,\n        \"printf 'VALUE = 2\\\\n' > module.py\\n\"\n        \"git add -- module.py\\n\"\n        \"git -c user.email=test@example.com -c user.name=test commit -m 'lane commit'\\n\"\n        \"exit 1\",\n    )\n\n    payload = _run(repo, tmp_path, executable)\n    tip = _git(repo, \"rev-parse\", \"lane/task-run\").stdout.strip()\n\n    assert payload[\"status\"] == \"failed\", payload\n    assert payload[\"target_sha\"] == tip\n    assert payload[\"candidate\"][\"status\"] == \"wip\"\n    assert \"WIP candidate commit failed\" not in (payload[\"blocker\"] or \"\")\n",
    "prompt_encoding": "utf-8",
    "size_bytes": 7808,
    "source": "working-tree:tests/charness_cli/test_task_run_merge_checkpoint_877.py"
  }
]
