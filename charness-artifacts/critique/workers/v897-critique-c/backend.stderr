    "carrier_path": ".charness/scratch/critique-review/review-500f54b378e7e858c147e47fb1a6ef6f/semantic-input/0001-content.bin",
    "carrier_sha256": "4a3654332d6d42b868c3c08c09608174c94dd4dd3d48933e886680b81404c932",
    "content_sha256": "4a3654332d6d42b868c3c08c09608174c94dd4dd3d48933e886680b81404c932",
