[
  {
    "carrier_path": "charness-artifacts/critique/workers/review-20260921T104030Z-763442/semantic-input/0000-content.bin",
    "carrier_sha256": "7fef8577f9d1bd9ffd10de9b2f38b78553c1a32069a00346bc53284b420e45ca",
