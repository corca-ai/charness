d/scripts/reviewer_process.py\n  verify: python3 -m tools.validate_public_skill_dogfood --repo-root .\n- repo-python: Repo-owned Python code and tests.\n  source matches: scripts/cli/install_delivery.py, scripts/review/critique_packet_lib.py, scripts/runtime_bootstrap.py, scripts/runtime_scratch.py, scripts/runtime_scratch_registry.py, scripts/task_run/task_run_progress.py, scripts/task_run/task_run_progress_rule.py, scripts/worktree/worktree_exec_lib.py, tests/charness_cli/test_codex_cache_refresh.py, tests/charness_cli/test_entry_cov_e4_874.py, tests/charness_cli/test_task_run_implementation_lane.py, tests/charness_cli/test_task_run_muse_stream_886.py, tests/charness_cli/test_worktree_exec.py, tests/coverage_debt/test_batch10.py, tests/quality_gates/fixtures/release_publish_fake_git.sh, tests/quality_gates/support.py, tests/quality_gates/test_chmod_allowlist.py, tests/quality_gates/test_quality_runner.py, tests/quality_gates/test_release_publish_fake_git.py, tests/test_critique_prepare_packet.py, tests/test_debug_risk_class_prose.py, tests/test_reviewer_process_shell_line.py, tests/test_runtime_root_snapshot.py, tests/test_runtime_scratch.py\n  verify: ./scripts/check-python-lint.sh, python3 scripts/gates/check_code_lengths.py --repo-root . --require-git-file-listing, python3 -m tools.validate_attention_state_visibility --repo-root . --scan-root scripts --scan-root skills --scan-root-map ../charness-support=skills/support, python3 scripts/gates/check_test_repo_copy_invariants.py --repo-root ., python3 scripts/gates/check_subprocess_form.py --repo-root . --require-git-file-listing, ./scripts/check-shell.sh, python3 scripts/gates_support/run_standing_pytest.py --repo-root . --mode read-only\n- python-scan-hygiene: Repo and skill Python that traverses the filesystem must stay gitignore-aware, so a committed non-gitignore-aware scanner does not ship latent until the next push.\n  source matches: scripts/cli/install_delivery.py, scripts/review/critique_packet_lib.py, scripts/runtime_bootstrap.py, scripts/runtime_scratch.py, scripts/runtime_scratch_registry.py, scripts/task_run/task_run_progress.py, scripts/task_run/task_run_progress_rule.py, scripts/worktree/worktree_exec_lib.py, skills/public/debug/scripts/debug_artifact_declarations.py\n  verify: python3 skills/public/quality/scripts/inventory_gitignore_scan_hygiene.py --repo-root . --require-empty --require-git-file-listing\n\nPlanned sync commands before validators:\n- python3 scripts/plugin_export/sync_root_plugin_manifests.py --repo-root .\n",
