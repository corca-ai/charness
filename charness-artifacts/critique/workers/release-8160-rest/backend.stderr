  {
    "carrier_path": "/home/hwidong/.cache/tmp/charness/runtime/811b9f8f8a808bfa/scratch/critique-review/review-30f1a349efaff8139807f9b38a55911c/semantic-input/0015-content.bin",
    "carrier_sha256": "149e2b4dc39a2d236b2ded4b364094b1237005fecd9f48fa8ef3edf1f0eb11b0",
