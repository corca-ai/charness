    "carrier_path": "/home/hwidong/.cache/tmp/charness/runtime/811b9f8f8a808bfa/scratch/critique-review/review-30f1a349efaff8139807f9b38a55911c/semantic-input/0005-content.bin",
    "carrier_sha256": "f085be82bbd7236abc77ab58ac06eaddd9bf3558e3f2df3b00dd9f7d75d045cf",
