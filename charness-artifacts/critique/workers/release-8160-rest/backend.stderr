  },
  {
    "carrier_path": "/home/hwidong/.cache/tmp/charness/runtime/811b9f8f8a808bfa/scratch/critique-review/review-30f1a349efaff8139807f9b38a55911c/semantic-input/0006-content.bin",
    "carrier_sha256": "6dc793e456cd5b7690efc84aa8f80163d1cb985ac3979b08f7825163e6b48662",
    "content_sha256": "7424ce7d14d701e46e2df32e49e7b826ef167426d7621455f028c96e4aed33c5",
    "disposition": "present",
    "path": "scripts/task_run/task_run_progress.py",
    "prompt_content": "\"\"\"Live phase relay, the every-lane progress rule, and the require-change guards (#815).\"\"\"\n\nfrom __future__ import annotations\n\nimport os\nimport threading\nimport time\nfrom pathlib import Path\nfrom typing import Any, Callable, Mapping, Sequence\n\n\ndef _load_repo_runtime_bootstrap():\n    pathlib, sys = __import__(\"pathlib\"), __import__(\"sys\")\n    marker = (\"scripts\", \"adapter_lib.py\")\n    parents = pathlib.Path(__file__).resolve().parents\n    root = next((p for p in parents if p.joinpath(*marker).is_file()), None)\n    if root is not None and str(root) not in sys.path:\n        sys.path.insert(0, str(root))\n\n\n_load_repo_runtime_bootstrap()\n\nfrom scripts.task_run import task_run_evidence as _evidence  # noqa: E402\nfrom scripts.task_run import task_run_execution as _execution  # noqa: E402\nfrom scripts.task_run import task_run_lane_signals as _signals  # noqa: E402\nfrom scripts.task_run import task_run_progress_rule as _rule  # noqa: E402\nfrom scripts.task_run import task_run_support as _support  # noqa: E402\n\n_env_seconds = _execution._env_seconds\n_guard_phases = _execution._guard_phases\n_guard_stop_reason = _execution._guard_stop_reason\n\nLANE_PHASES = _signals.LANE_PHASES\nNO_PROGRESS_STOP_PREFIX = _signals.NO_PROGRESS_STOP_PREFIX\nlane_progress = _signals.lane_progress\n_transcript_lines = _signals._transcript_lines\n_event_texts = _signals._event_texts\nno_progress_stop_due = _signals.no_progress_stop_due\nscoped_diff_present = _signals.scoped_diff_present\n_worktree_liveliness = _signals._worktree_liveliness\n\n\n#: Wall-clock budget between `CONTRACT-READ` and the first scoped signal\n#: (`EDITING` or a real scoped diff) before a require-change lane is stopped\n#: as a typed no-progress blocker. `<= 0` turns the stop off.\nNO_PROGRESS_BUDGET_ENV = \"CHARNESS_TASK_RUN_NO_PROGRESS_SECONDS\"\nPROGRESS_POLL_ENV = \"CHARNESS_TASK_RUN_PROGRESS_POLL_SECONDS\"\nBLOCKED_GRACE_ENV = \"CHARNESS_TASK_RUN_BLOCKED_GRACE_SECONDS\"\nDEFAULT_NO_PROGRESS_BUDGET_SECONDS = 300.0\nDEFAULT_PROGRESS_POLL_SECONDS = 15.0\n#: Grace after a declared `BLOCKED:` marker before a still-running lane is\n#: stopped. Compliant executors exit promptly on their own; only a lane that\n#: lingers past the grace is killed, so a block declaration cannot become a\n#: full-timeout consumption.\nDEFAULT_BLOCKED_GRACE_SECONDS = 60.0\n#: Consecutive failed progress checks before the watch stops the lane: with\n#: no wall clock, a watch that cannot check must not leave a lane unbounded.\nMAX_RULE_FAILURES = 8\n\n\nclass LaneProgressWatch:\n    \"\"\"Live phase relay and progress guards for one lane.\n\n    Every watched lane runs the progress rule (`task_run_progress_rule`); a\n    require-change lane also gets the first-edit budget and BLOCKED grace.\n\n    The carrier cannot stream the executor's own pipes (they are redirected\n    into the lane logs), so the watch tails those logs on a poll cadence and\n    relays phase changes as `PROGRESS` lines on the carrier's own stderr —\n    the parent observes \"alive and editing\" versus \"alive but exploring\"\n    without tailing private executor logs (#815). When the lane announced\n    `CONTRACT-READ` but shows no `EDITING` and no real scoped diff once the\n    budget is spent, the watch records a typed `NO-PROGRESS-STOP` marker on\n    the transcript and kills the lane instead of letting it spend its run in\n    analysis (first-edit budget, require-change lanes only).\n\n    The clock is injectable so tests drive `tick` deterministically; only the\n    thin `_run` loop touches wall-clock time.\n    \"\"\"\n\n    def __init__(\n        self,\n        *,\n        stdout_log: Path,\n        stderr_log: Path,\n        worktree: Path,\n        base_sha: str,\n        scope_specs: Sequence[Mapping[str, Any]],\n        budget_seconds: float,\n        poll_seconds: float,\n        blocked_grace_seconds: float = DEFAULT_BLOCKED_GRACE_SECONDS,\n        clock: Callable[[], float] = time.monotonic,\n        observe: Callable[[dict[str, Any]], None] | None = None,\n        budget_source: str = \"env\",\n        budget_raw: str | None = None,\n        progress_rule: _rule.ProgressRule | None = None,\n    ) -> None:\n        self._stdout_log = stdout_log\n        self._stderr_log = stderr_log\n        self._worktree = worktree\n        self._base_sha = base_sha\n        self._scope_specs = list(scope_specs)\n        self._budget_seconds = budget_seconds\n        self._budget_source = budget_source\n        self._budget_raw = budget_raw\n        self._poll_seconds = max(poll_seconds, 0.05)\n        self._blocked_grace_seconds = blocked_grace_seconds\n        self._clock = clock\n        self._observe = observe\n        self._last_log_sizes: tuple[int, int] = (-1, -1)\n        self._last_growth_at: float | None = None\n        self._contract_read_at: float | None = None\n        self._blocker_at: float | None = None\n        self._blocker: str | None = None\n        self._last_phases: list[str] = []\n        self._started_at: float | None = None\n        self._emit: Callable[[list[str], float], None] | None = None\n        self._kill: Callable[[], None] | None = None\n        self._stopped = threading.Event()\n        self._thread: threading.Thread | None = None\n        self.stop_reason: str | None = None\n        self._first_scoped_paths: list[str] | None = None\n        self._first_scoped_diff: str | None = None\n        self._first_scoped_truncated: bool = False\n        self._first_scoped_elapsed: float | None = None\n        from scripts.task_run import task_run_lane_runner as _lane_runner\n\n        self._steer_queue = _lane_runner.steer_queue_path(stdout_log.parent)\n        self._steer_seen: set[str] = set()\n        self._steer_messages: list[dict[str, Any]] = []\n        self._progress_rule = progress_rule\n        self._action_lock = threading.Lock()\n        self._preempted = False\n        self.preemptions = 0\n        self._rule_failures = 0\n        self.suppressed_actions = 0\n        self._undelivered: list[dict[str, Any]] = []\n\n    def start(\n        self,\n        *,\n        emit: Callable[[list[str], float], None],\n        kill: Callable[[], None],\n    ) -> None:\n        \"\"\"Begin polling beside the running lane; `kill` stops its process group.\"\"\"\n        self._emit = emit\n        self._kill = kill\n        self._started_at = self._clock()\n        if self._progress_rule is not None:\n            self._progress_rule.start(self._started_at)\n        self._stopped.clear()\n        self._thread = threading.Thread(\n            target=self._run, name=\"charness-lane-progress\", daemon=True\n        )\n        self._thread.start()\n\n    def stop(self) -> None:\n        \"\"\"Halt polling; safe to call when the lane already exited.\"\"\"\n        self._stopped.set()\n        if self._thread is not None:\n            self._thread.join(timeout=self._poll_seconds + 5)\n\n    def observe_completion(self) -> None:\n        \"\"\"Record final drained output without enforcing live-only stop rules.\"\"\"\n        try:\n            self._poll(self._clock())\n        except OSError:  # A closed progress stream must not interrupt cleanup.\n            pass\n\n    def receipt(self) -> dict[str, Any]:\n        \"\"\"The guard configuration and outcome for the lane receipt.\"\"\"\n        return {\n            \"enabled\": True,\n            \"stop_enabled\": self._budget_seconds > 0,\n            \"linger_stop_enabled\": self._blocked_grace_seconds > 0,\n            \"budget_seconds\": self._budget_seconds,\n            \"budget_source\": self._budget_source,\n            \"budget_raw\": self._budget_raw,\n            \"blocked_grace_seconds\": self._blocked_grace_seconds,\n            \"poll_seconds\": self._poll_seconds,\n            \"stop_reason\": self.stop_reason,\n            \"preemptions\": self.preemptions,\n            \"suppressed_actions\": self.suppressed_actions,\n            \"progress_rule\": (\n                None if self._progress_rule is None else self._progress_rule.receipt()\n            ),\n            \"last_phases\": list(self._last_phases),\n            \"first_scoped_diff\": {\n                \"observed\": self._first_scoped_paths is not None,\n                \"changed_paths\": list(self._first_scoped_paths or []),\n                \"diff\": self._first_scoped_diff,\n                \"truncated\": self._first_scoped_truncated,\n                \"observed_elapsed_s\": self._first_scoped_elapsed,\n            },\n        }\n\n    def tick(self, now: float) -> str | None:\n        \"\"\"One poll: relay new phases, publish a live snapshot, report a stop reason.\"\"\"\n        try:\n            self._poll_steer_queue()\n            self._track_log_growth(now)\n            reason = self._poll(now)\n        except Exception:  # noqa: BLE001 - the progress rule below must still run\n            reason = None\n        # The progress rule is the lane's only bound, so it runs even when the\n        # phase or queue poll above fails.\n        reason = reason or self._tick_rule(now)\n        if self._observe is not None:\n            try:\n                self._observe(self.snapshot(now))\n            except Exception:  # noqa: BLE001 - a failed snapshot must not kill the watch\n                pass\n        return reason\n\n    def _tick_rule(self, now: float) -> str | None:\n        if self._progress_rule is None:\n            return None\n        checks_before = len(self._progress_rule.checks)\n        try:\n            action = self._progress_rule.on_tick(now)\n        except Exception as exc:  # noqa: BLE001 - counted; repeated failure stops the lane\n            self._rule_failures += 1\n            if self._rule_failures < MAX_RULE_FAILURES:\n                return None\n            return (\n                f\"progress watch failed {self._rule_failures} consecutive checks \"\n                f\"({type(exc).__name__}: {exc}); the lane cannot be bounded\"\n            )\n        if len(self._progress_rule.checks) > checks_before:\n            # Only a completed due check proves the rule works; a no-op poll\n            # between failing checks must not reset the count.\n            self._rule_failures = 0\n        if action is not None and action.kind == \"stop\":\n            return action.text\n        self._apply(action)\n        return None\n\n    def finish_lane(self, *, ended_normally: bool) -> None:\n        \"\"\"The executor stopped running; resolve an outstanding checkpoint request.\"\"\"\n        if self._progress_rule is not None:\n            self._progress_rule.finish(ended_normally=ended_normally)\n\n    def observe_event(self, event: Mapping[str, Any]) -> None:\n        \"\"\"Feed one executor event to the progress rule (runs on the event reader).\"\"\"\n        if self._progress_rule is None or self.stop_reason is not None:\n            return\n        action = self._progress_rule.on_event(event)\n        if action is not None and action.kind == \"stop\":\n            self._stop_now(action.text)\n        else:\n            self._apply(action)\n\n    def _apply(self, action: _rule.Action | None) -> None:\n        \"\"\"Deliver the rule's message now: queue it as a steer, then preempt.\n\n        The kill ends this executor invocation; the execution loop sees the\n        preemption and resumes the same session with the queued message.\n        \"\"\"\n        if action is None or self._kill is None:\n            return\n        from scripts.task_run import task_run_lane_runner as _lane_runner\n\n        with self._action_lock:\n            # First wins: once the lane is stopping (here or in the rule), a\n            # message would never be delivered, so it is suppressed and counted.\n            rule = self._progress_rule\n            if self.stop_reason is not None or (rule is not None and rule.stop_reason):\n                self.suppressed_actions += 1\n                return\n            self._undelivered.append(\n                _lane_runner.enqueue_steer(\n                    self._steer_queue,\n                    self._stdout_log.parent.name,\n                    action.text,\n                    reason=action.reason_code,\n                    actor=\"charness-progress-rule\",\n                )\n            )\n            if not self._preempted:\n                # One preemption per invocation; later messages ride along.\n                self._preempted = True\n                self.preemptions += 1\n                self._kill()\n\n    def take_preempted(self) -> bool:\n        \"\"\"Whether the last invocation ended because the watch preempted it.\"\"\"\n        preempted, self._preempted = self._preempted, False\n        return preempted\n\n    def _stop_now(self, reason: str) -> None:\n        from scripts.task_run import task_run_lane_runner as _lane_runner\n\n        with self._action_lock:\n            if self.stop_reason is not None:\n                return\n            self.stop_reason = reason\n            # A message queued in this invocation will never be delivered: the\n            # stop supersedes it, and its preemption did not happen as one.\n            for record in self._undelivered:\n                _lane_runner.update_steer_queue(\n                    self._steer_queue,\n                    {**record, \"disposition\": \"nacked\", \"reason_code\": \"superseded-by-stop\"},\n                )\n                self.suppressed_actions += 1\n            self._undelivered = []\n            if self._preempted:\n                self._preempted = False\n                self.preemptions -= 1\n        try:\n            self.fire(reason)\n        except Exception:  # noqa: BLE001 - a failed stop must not kill the reader\n            pass\n\n    def pending_steers(self) -> list[dict[str, Any]]:\n        \"\"\"Read the queue once more at the turn boundary and return undelivered entries.\"\"\"\n        self._poll_steer_queue()\n        return [message for message in self._steer_messages if message.get(\"delivered_at\") is None]\n\n    def record_steer_delivery(\n        self, messages: Sequence[Mapping[str, Any]], *, resume_path: str\n    ) -> None:\n        \"\"\"Record the typed delivery disposition after the next invocation starts.\"\"\"\n        by_id = {item.get(\"message_id\"): item for item in self._steer_messages}\n        delivered = {message.get(\"message_id\") for message in messages}\n        with self._action_lock:\n            self._undelivered = [\n                item for item in self._undelivered if item.get(\"message_id\") not in delivered\n            ]\n        stamp = _support.utc_now_iso()\n        from scripts.task_run import task_run_lane_runner as _lane_runner\n\n        for message in messages:\n            current = by_id.get(message.get(\"message_id\"))\n            if current is not None:\n                current.update(\n                    delivered_at=stamp,\n                    disposition=\"accepted\",\n                    reason=None,\n                    resume_path=resume_path,\n                )\n                _lane_runner.update_steer_queue(self._steer_queue, current)\n\n    def _poll_steer_queue(self) -> None:\n        from scripts.task_run import task_run_lane_runner as _lane_runner\n\n        for message in _lane_runner.read_steer_queue(self._steer_queue):\n            message_id = message.get(\"message_id\")\n            if not isinstance(message_id, str) or message_id in self._steer_seen:\n                continue\n            self._steer_seen.add(message_id)\n            self._steer_messages.append(dict(message))\n\n    def snapshot(self, now: float) -> dict[str, Any]:\n        \"\"\"Cheap live lane signal for result.json pollers (#829).\n\n        Phase plus worktree truth the orchestrator previously re-derived by\n        hand: changed-file count, lane-branch commit count, and the last\n        commit subject. Tool-call counts are executor-private and stay out;\n        log silence is reported as seconds since the logs last grew.\n        \"\"\"\n        lively = _worktree_liveliness(self._worktree, self._base_sha)\n        lively = lively if isinstance(lively, dict) else {}\n        age = None if self._last_growth_at is None else max(0.0, now - self._last_growth_at)\n        progress = None if self._progress_rule is None else self._progress_rule.snapshot(now)\n        return {\n            \"progress_rule\": progress,\n            \"phase\": self._last_phases[-1] if self._last_phases else None,\n            \"phases\": list(self._last_phases),\n            \"files_changed\": lively.get(\"files_changed\"),\n            \"commits\": lively.get(\"commits\"),\n            \"last_commit_subject\": lively.get(\"last_commit_subject\"),\n            \"seconds_since_log_growth\": age,\n        }\n\n    def _track_log_growth(self, now: float) -> None:\n        try:\n            sizes = (\n                self._stdout_log.stat().st_size if self._stdout_log.is_file() else 0,\n                self._stderr_log.stat().st_size if self._stderr_log.is_file() else 0,\n            )\n        except OSError:\n            return\n        if sizes != self._last_log_sizes:\n            self._last_log_sizes = sizes\n            self._last_growth_at = now\n\n    def _poll(self, now: float) -> str | None:\n        \"\"\"One poll: relay new phases and report a stop reason, if due.\n\n        Cumulative: markers are one-line events the executor need not\n        repeat, so phases union into the watched set and the first\n        `CONTRACT-READ` observation time is kept. A marker that aged out of\n        the tail window still counts (#815).\n        \"\"\"\n        progress = lane_progress(\n            _evidence._tail_text(self._stdout_log),\n            _evidence._tail_text(self._stderr_log),\n        )\n        fresh = [phase for phase in progress[\"phases\"]]\n        new = [phase for phase in LANE_PHASES if phase in fresh and phase not in self._last_phases]\n        if new:\n            self._last_phases = [\n                phase\n                for phase in LANE_PHASES\n                if phase in self._last_phases or phase in fresh\n            ]\n            if self._emit is not None and self._started_at is not None:\n                self._emit(list(self._last_phases), now - self._started_at)\n        phases = list(self._last_phases)\n        # The declared blocker is cumulative like phases: a marker that ages\n        # out of the tail window still counts, so a lingering lane cannot\n        # evade the grace by emitting enough output after declaring BLOCKED.\n        observed = progress[\"blocker\"]\n        if observed is not None and self._blocker is None:\n            self._blocker = observed\n        blocker = observed if observed is not None else self._blocker\n        if blocker is not None:\n            # A declared block is terminal semantics, not a stall to watch:\n            # a lane that lingers past the grace after declaring BLOCKED is\n            # stopped, so the declaration cannot burn the full timeout. A\n            # non-positive grace turns the linger stop off independently of\n            # the no-progress budget.\n            if self._blocked_grace_seconds <= 0:\n                return None\n            if self._blocker_at is None:\n                self._blocker_at = now\n                return None\n            if now - self._blocker_at < self._blocked_grace_seconds:\n                return None\n            return (\n                f\"lane declared BLOCKED ({blocker}) but kept running; \"\n                f\"stopped after {self._blocked_grace_seconds:g}s\"\n            )\n        if \"CONTRACT-READ\" not in phases:\n            return None\n        if self._contract_read_at is None:\n            self._contract_read_at = now\n        diff_present = scoped_diff_present(\n            self._worktree, self._base_sha, self._scope_specs\n        )\n        if diff_present:\n            self._maybe_snapshot_scoped_diff(now)\n        return no_progress_stop_due(\n            phases=phases,\n            contract_read_at=self._contract_read_at,\n            now=now,\n            budget_seconds=self._budget_seconds,\n            diff_present=diff_present,\n        )\n\n    def _maybe_snapshot_scoped_diff(self, now: float) -> None:\n        \"\"\"Keep the first observed scoped diff so a self-revert stays recoverable (#834).\n\n        Best-effort and once-only: the guard must never fail a lane it is\n        watching, so any unobservable worktree simply leaves the snapshot\n        empty for the receipt backstop to report as unobserved.\n        \"\"\"\n        if self._first_scoped_paths is not None:\n            return\n        snapshot = _signals.scoped_diff_snapshot(self._worktree, self._base_sha, self._scope_specs)\n        if snapshot is None:\n            return\n        self._first_scoped_paths, self._first_scoped_diff, self._first_scoped_truncated = snapshot\n        if self._started_at is not None:\n            self._first_scoped_elapsed = max(0.0, now - self._started_at)\n\n    def fire(self, reason: str) -> None:\n        \"\"\"Record the typed stop on the transcript and kill the stalled lane.\"\"\"\n        try:\n            with self._stderr_log.open(\"a\", encoding=\"utf-8\") as handle:\n                handle.write(f\"{NO_PROGRESS_STOP_PREFIX} {reason}\\n\")\n        except OSError:\n            pass\n        finally:\n            if self._kill is not None:\n                self._kill()\n\n    def _run(self) -> None:\n        while not self._stopped.wait(self._poll_seconds):\n            if self.stop_reason is not None:\n                return\n            try:\n                reason = self.tick(self._clock())\n            except Exception:  # noqa: BLE001 - a failed poll must not kill the watch\n                continue\n            if reason is None:\n                continue\n            self._stop_now(reason)\n            return\n\n\ndef build_progress_watch(\n    *,\n    require_change: bool,\n    stdout_log: Path,\n    stderr_log: Path,\n    worktree: Path,\n    base_sha: str,\n    scope_specs: Sequence[Mapping[str, Any]],\n    observe: Callable[[dict[str, Any]], None] | None = None,\n    budget_override: float | None = None,\n) -> LaneProgressWatch | None:\n    \"\"\"The live watch for a lane, or None when nothing would be watched.\n\n    Every lane gets the progress rule (`task_run_progress_rule`), the one\n    stop a lane has once no wall clock bounds it; `CHARNESS_TASK_RUN_PROGRESS_WINDOW_SECONDS`\n    sets its window and `0` turns it off. A require-change lane also gets the\n    first-edit budget and the BLOCKED linger grace. The guard owns queue\n    polling for watched lanes. Execution checks the same queue at every\n    natural executor boundary when this guard is absent. An explicit\n    ``budget_override`` (``--no-progress-seconds``) wins over the environment\n    so a contract-heavy lane records its budget as a deliberate per-lane\n    choice (#835).\n    \"\"\"\n    window_seconds, window_parsed = _env_seconds(\n        _rule.PROGRESS_WINDOW_ENV, _rule.DEFAULT_PROGRESS_WINDOW_SECONDS\n    )\n    if window_seconds < 0:  # only an explicit 0 turns off a lane's one bound\n        window_seconds, window_parsed = _rule.DEFAULT_PROGRESS_WINDOW_SECONDS, False\n    if not require_change and window_seconds <= 0:\n        return None\n    progress_rule = _rule.ProgressRule(\n        window_seconds=window_seconds,\n        fingerprint=lambda: _rule.worktree_fingerprint(worktree),\n        window_source=\"env\" if window_parsed else \"default\",\n    )\n    budget_raw = os.environ.get(NO_PROGRESS_BUDGET_ENV)\n    if not require_change:\n        budget_seconds, budget_source = 0.0, \"disabled\"\n    elif budget_override is None:\n        budget_seconds, budget_parsed = _env_seconds(\n            NO_PROGRESS_BUDGET_ENV, DEFAULT_NO_PROGRESS_BUDGET_SECONDS\n        )\n        budget_source = \"env\" if budget_parsed else \"default\"\n    else:\n        budget_seconds = budget_override\n        budget_source = \"flag\"\n    poll_seconds, _ = _env_seconds(PROGRESS_POLL_ENV, DEFAULT_PROGRESS_POLL_SECONDS)\n    grace_seconds, _ = _env_seconds(BLOCKED_GRACE_ENV, DEFAULT_BLOCKED_GRACE_SECONDS)\n    return LaneProgressWatch(\n        stdout_log=stdout_log,\n        stderr_log=stderr_log,\n        worktree=worktree,\n        base_sha=base_sha,\n        scope_specs=scope_specs,\n        budget_seconds=budget_seconds,\n        poll_seconds=poll_seconds,\n        blocked_grace_seconds=grace_seconds if require_change else 0.0,\n        observe=observe,\n        budget_source=budget_source,\n        budget_raw=budget_raw,\n        progress_rule=progress_rule,\n    )\n\n\ndef _execute_watched_lane(payload: dict[str, Any], command: list[str], **kwargs: Any) -> dict[str, Any]:\n    \"\"\"Run the lane executor; the attempt loop owns retries (see task_run_attempts).\"\"\"\n    from scripts.task_run import task_run_attempts as _attempts\n\n    return _attempts._execute_watched_lane(payload, command, **kwargs)\n",
    "prompt_encoding": "utf-8",
    "size_bytes": 24331,
    "source": "working-tree:scripts/task_run/task_run_progress.py"
  },
  {
    "carrier_path": "/home/hwidong/.cache/tmp/charness/runtime/811b9f8f8a808bfa/scratch/critique-review/review-30f1a349efaff8139807f9b38a55911c/semantic-input/0007-content.bin",
    "carrier_sha256": "75e457c9e771100670981fe7845b9e35c915193c7095bfa722241caa9eb9c0f8",
    "content_sha256": "2bd7d994aac9e7d94f9f5235a05b2ed7c506921128d4443c6de249d760a8d3f3",
    "disposition": "present",
    "path": "scripts/task_run/task_run_progress_rule.py",
    "prompt_content": "\"\"\"The lane progress rule: the one stop condition a task-run lane has.\n\nA wall-clock timeout killed productive lanes mid-edit and let a looping lane\nburn its whole budget. This rule replaces it with progress. Progress since the\nlast check is any of: a new commit, a file change, or a new command outcome\n(a completed command whose (command text, worktree fingerprint) pair this lane\nhas not completed before; rerunning a command on an unchanged tree is not\nnew, and a completion without command text always is). Every progress window the rule checks. A window without progress earns\na checkpoint request; a second one in a row, with the request unanswered,\nstops the lane. A command the rule has seen start since the previous check,\nstill running, defers the request, and so the stop, by one check, or by two\nwhen the rule first sees it start while a check is probing the tree (a start\nthe event reader has not delivered yet is unseen). Windows are\nnominal: the watch runs a due check at its next poll. A hung command, a silent model and a dead executor are the\nsame case, so there is no second timer.\n\nLoops are judged at each command completion: the third completion of the\nsame test, lint or typecheck command on an unchanged worktree asks the lane\nto switch to the debug skill, the fourth asks it to checkpoint and stop, and\nthe fifth stops it.\n\nThe rule is pure over its inputs: the clock is the caller's `now`, the\nworktree is read through an injected fingerprint. An unobservable worktree\n(`None`) shows neither progress nor its absence: the window check falls back\nto the executor's own events, so a silent lane is still stopped, and no loop\nis claimed without seeing the tree. The watch (`task_run_progress`) applies its actions.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport hashlib\nimport os\nimport threading\nfrom dataclasses import dataclass\nfrom pathlib import Path\nfrom typing import Any, Callable, Mapping\n\n\ndef _load_repo_runtime_bootstrap():\n    pathlib, sys = __import__(\"pathlib\"), __import__(\"sys\")\n    marker = (\"scripts\", \"adapter_lib.py\")\n    parents = pathlib.Path(__file__).resolve().parents\n    root = next((p for p in parents if p.joinpath(*marker).is_file()), None)\n    if root is not None and str(root) not in sys.path:\n        sys.path.insert(0, str(root))\n\n\n_load_repo_runtime_bootstrap()\n\nfrom scripts.core.subprocess_guard import run_process  # noqa: E402\nfrom scripts.task_run import task_run_claude_events as _claude_events  # noqa: E402\nfrom scripts.task_run import task_run_event_timing as _timing  # noqa: E402\n\n#: Muse task kinds that change files (seen in ceal lane logs, 2026-10-20);\n#: reads, searches, todo lists and bash input are activity, not outcomes.\nMUSE_EDIT_TOOL_KINDS = frozenset({\"tool.edit\", \"tool.edit_file\", \"tool.write_file\"})\nPROGRESS_WINDOW_ENV = \"CHARNESS_TASK_RUN_PROGRESS_WINDOW_SECONDS\"\n_NO_PROBE = object()  # sentinel: no tree probe was taken before the lock\nDEFAULT_PROGRESS_WINDOW_SECONDS = 1200.0\nLOOP_FAMILIES = frozenset({\"test\", \"lint\", \"typecheck\"})\n_FINGERPRINT_PROBE_SECONDS = 60.0\n\nCHECKPOINT_REQUEST = (\n    \"charness progress check: no commit, file change, or new command result in the \"\n    \"last {window}. If your work has a coherent state, commit it now (hooks must \"\n    \"pass; never --no-verify) and write your final report naming what remains. If \"\n    \"you are blocked, reply on its own line: BLOCKED: <reason>. If you are still \"\n    \"making progress, continue; charness stops this lane if the next {window} also \"\n    \"shows no commit, file change, or new command result.\"\n)\nLOOP_DEBUG_REQUEST = (\n    \"charness loop check: `{command}` has now completed {count} times with no file \"\n    \"change between runs{exit}. Running it again will not change the result. Switch \"\n    \"to the debug skill: read the failure output, state one falsifiable hypothesis, \"\n    \"and change code, test, or approach before you run it again.\"\n)\nLOOP_CHECKPOINT_REQUEST = (\n    \"charness loop check: `{command}` ran a {count}th time on an unchanged worktree. \"\n    \"Checkpoint now: commit the coherent part of your work if there is one (hooks \"\n    \"must pass; never --no-verify), write your final report naming what is \"\n    \"unresolved, and stop. One more identical run stops this lane.\"\n)\n\n\n@dataclass(frozen=True)\nclass Action:\n    \"\"\"What the watch must do now: send `message` (preempting) or `stop`.\"\"\"\n\n    kind: str\n    text: str\n    reason_code: str\n\n\ndef worktree_fingerprint(worktree: Path) -> str | None:\n    \"\"\"One hash of HEAD, the tracked diff, and untracked files, or None if unobservable.\n\n    Ignored files (build output, caches) do not count. Untracked files are\n    read by size and modification time, not content, so a rewrite counts as a\n    change; the error is toward progress, never toward a false stop.\n    \"\"\"\n    digest = hashlib.sha256()\n    for args in (\n        (\"rev-parse\", \"HEAD\"),\n        (\"diff\", \"HEAD\", \"--no-ext-diff\", \"--no-color\", \"--binary\"),\n        (\"ls-files\", \"--others\", \"--exclude-standard\", \"-z\"),\n    ):\n        try:\n            result = run_process(\n                [\"git\", *args], cwd=worktree, timeout_seconds=_FINGERPRINT_PROBE_SECONDS\n            )\n        except OSError:\n            return None\n        if result.returncode != 0:\n            return None\n        digest.update(result.stdout.encode(\"utf-8\", \"surrogateescape\") + b\"\\0\")\n        if args[0] == \"ls-files\":\n            for name in sorted(filter(None, result.stdout.split(\"\\0\"))):\n                try:\n                    stat = os.stat(worktree / name, follow_symlinks=False)\n                except OSError:\n                    continue\n                digest.update(f\"{name}\\0{stat.st_size}\\0{stat.st_mtime_ns}\\0\".encode(\n                    \"utf-8\", \"surrogateescape\"\n                ))\n    return digest.hexdigest()\n\n\ndef _duration(seconds: float) -> str:\n    return f\"{seconds / 60:g} minutes\" if seconds >= 60 else f\"{seconds:g} seconds\"\n\n\nclass ProgressRule:\n    \"\"\"Window checks and loop detection for one lane; thread-safe.\n\n    `on_event` runs on the event reader as each executor line arrives;\n    `on_tick` runs on the watch's poll. Both return an `Action` or None.\n    Request states: None, `deferred` (a command was in flight at an empty\n    check; delivery waits for its completion or the next check),\n    `delivered-between-checks` (delivered at a command completion; the next\n    check starts the request's full window instead of stopping), and\n    `delivered` (an empty check stops the lane, unless a command younger\n    than one window is running, which defers the stop a check).\n    \"\"\"\n\n    def __init__(\n        self,\n        *,\n        window_seconds: float,\n        fingerprint: Callable[[], str | None],\n        window_source: str = \"default\",\n    ) -> None:\n        self.window_seconds = window_seconds\n        self.window_source = window_source\n        self._fingerprint = fingerprint\n        self._lock = threading.Lock()\n        self._completion_state: object = _NO_PROBE\n        self._timeline = _timing._Timeline(on_complete=self._on_complete)\n        self._muse_kinds: dict[str, str] = {}\n        self._claude_edits: set[str] = set()\n        self._outcomes: dict[tuple[str, str], int] = {}\n        self._pending: Action | None = None\n        self._last_check_at: float | None = None\n        self._last_state: str | None = None\n        self._last_progress_at: float | None = None\n        self._new_outcomes = 0\n        self._request: str | None = None\n        self._in_flight_at_check: set[str] = set()\n        self._invocation = 0\n        self.checks: list[dict[str, Any]] = []\n        self.messages: list[dict[str, Any]] = []\n        self.stop_reason: str | None = None\n\n    def start(self, now: float) -> None:\n        \"\"\"Begin observing at `now`; a later call starts the next invocation.\n\n        Window state carries over a preemption; command state does not: the\n        previous executor process is dead, and a resumed Codex session reuses\n        item ids, so each invocation gets a fresh timeline and its own keys.\n        \"\"\"\n        with self._lock:\n            if self._last_check_at is None:\n                self._last_check_at = now\n                self._last_progress_at = now\n                self._last_state = self._fingerprint()\n            else:\n                self._invocation += 1\n                self._timeline = _timing._Timeline(on_complete=self._on_complete)\n                self._muse_kinds = {}\n                self._claude_edits = set()\n\n    def _in_flight(self) -> dict[str, str]:\n        return {\n            f\"{self._invocation}:{key}\": command\n            for key, command in self._timeline.in_flight().items()\n        }\n\n    def on_event(self, event: Mapping[str, Any]) -> Action | None:\n        # A command completion keys its outcome to the tree; probe it before\n        # taking the lock, so a window check is never held behind it. The\n        # event reader itself still waits for the probe before it reads the\n        # next line, so a start arriving during it is seen only afterwards.\n        state = self._fingerprint() if self._is_command_completion(event) else _NO_PROBE\n        with self._lock:\n            if self.stop_reason is not None or self.window_seconds <= 0:\n                return None  # stopped, or the rule is off: no message reaches the lane\n            self._count_edit_outcome(event)\n            self._completion_state = state\n            self._timeline.feed(None, event)\n            action, self._pending = self._pending, None\n            return self._record(action)\n\n    def _is_command_completion(self, event: Mapping[str, Any]) -> bool:\n        item = event.get(\"item\")\n        if event.get(\"type\") == \"item.completed\" and isinstance(item, Mapping):\n            return item.get(\"type\") == \"command_execution\"\n        if event.get(\"type\") == \"user\":\n            return any(\n                block.get(\"type\") == \"tool_result\"\n                and str(block.get(\"tool_use_id\")) in self._timeline.bash_tasks()\n                for block in _claude_events.content_blocks(event)\n            )\n        payload = event.get(\"payload\")\n        return (\n            event.get(\"payload_type\") == \"task.lifecycle.completed\"\n            and isinstance(payload, Mapping)\n            and str(payload.get(\"task_id\")) in self._timeline.bash_tasks()\n        )\n\n    def _count_edit_outcome(self, event: Mapping[str, Any]) -> None:\n        \"\"\"File edits the executor reports are outcomes even when git cannot be read.\"\"\"\n        for block in _claude_events.content_blocks(event):\n            if event.get(\"type\") == \"assistant\" and block.get(\"type\") == \"tool_use\" and block.get(\"name\") in {\"Edit\", \"Write\", \"NotebookEdit\"}:\n                self._claude_edits.add(str(block.get(\"id\")))\n            elif event.get(\"type\") == \"user\" and block.get(\"type\") == \"tool_result\":\n                key = str(block.get(\"tool_use_id\"))\n                if key in self._claude_edits:\n                    self._claude_edits.discard(key)\n                    if not block.get(\"is_error\"):\n                        self._new_outcomes += 1\n        item = event.get(\"item\")\n        if (\n            event.get(\"type\") == \"item.completed\"\n            and isinstance(item, Mapping)\n            and item.get(\"type\") == \"file_change\"\n        ):\n            self._new_outcomes += 1\n            return\n        payload = event.get(\"payload\")\n        if not isinstance(payload, Mapping):\n            return\n        task_id = str(payload.get(\"task_id\"))\n        inner = payload.get(\"event\")\n        if event.get(\"payload_type\") == \"task.lifecycle.proposed\" and isinstance(inner, Mapping):\n            self._muse_kinds[task_id] = str(inner.get(\"task_kind\") or \"\")\n        elif event.get(\"payload_type\") == \"task.lifecycle.completed\":\n            if self._muse_kinds.get(task_id, \"\") in MUSE_EDIT_TOOL_KINDS:\n                self._new_outcomes += 1\n\n    def _on_complete(self, command: str | None, exit_code: object) -> None:\n        if not command:\n            self._new_outcomes += 1  # an unnamed command cannot be proven a repeat\n            return\n        state = self._completion_state\n        if state is _NO_PROBE:\n            state = self._fingerprint()\n        # An unreadable tree is one unknown state: a new command is still new,\n        # a rerun is not, and no loop is claimed without seeing the tree.\n        key = (command.strip(), state or \"unobservable\")\n        count = self._outcomes.get(key, 0) + 1\n        self._outcomes[key] = count\n        if count == 1:\n            self._new_outcomes += 1\n        if count > 1 and self._request == \"deferred\" and not self._in_flight():\n            # The deferred request waited for this boundary, and the command\n            # produced nothing new: deliver it now. It arrives between checks,\n            # so the next check opens its full window rather than stopping.\n            self._request = \"delivered-between-checks\"\n            self._pending = self._checkpoint_request(interrupted=[])\n            return\n        if state is None:\n            return\n        if count < 3 or not LOOP_FAMILIES & set(_timing.command_families(command)):\n            return\n        shown = command.strip()[:200]\n        if count == 3:\n            ending = f\" (last exit code {exit_code})\" if isinstance(exit_code, int) else \"\"\n            self._pending = Action(\n                \"message\",\n                LOOP_DEBUG_REQUEST.format(command=shown, count=count, exit=ending),\n                \"loop-debug\",\n            )\n        elif count == 4:\n            self._pending = Action(\n                \"message\",\n                LOOP_CHECKPOINT_REQUEST.format(command=shown, count=count),\n                \"loop-checkpoint\",\n            )\n        elif count == 5:\n            self._pending = Action(\n                \"stop\",\n                f\"loop: `{shown}` completed {count} times on an unchanged worktree; \"\n                \"the debug and checkpoint requests went unanswered\",\n                \"loop-stop\",\n            )\n\n    def _checkpoint_request(self, *, interrupted: list[str]) -> Action:\n        text = CHECKPOINT_REQUEST.format(window=_duration(self.window_seconds))\n        if interrupted:\n            # The kill takes the executor's whole process group, so every\n            # running command is interrupted, not only the oldest one.\n            named = [f\"`{command[:200]}`\" for command in interrupted if command]\n            unnamed = len(interrupted) - len(named)\n            if unnamed:  # e.g. a Muse bash task killed before its first output\n                named.append(f\"{unnamed} command(s) whose text was not yet seen\")\n            text += (\n                f\" Every command still running was interrupted ({', '.join(named)}), \"\n                \"each after \"\n                f\"running for at least {_duration(self.window_seconds)}; they may have \"\n                \"left partial output or files. Do not simply rerun them: run a narrower \"\n                \"or faster variant, or report that one needs longer.\"\n            )\n        return Action(\"message\", text, \"no-progress\")\n\n    def on_tick(self, now: float) -> Action | None:\n        with self._lock:\n            if self.window_seconds <= 0 or self._last_check_at is None:\n                return None\n            if now - self._last_check_at < self.window_seconds:\n                return None\n            # Only commands already running before this probe count as seen at\n            # this check: one that starts mid-probe stays young at the next\n            # check too, so no seen command is killed before it has run a full\n            # window (a start not yet delivered by the event reader is unseen).\n            seen_before_probe = set(self._in_flight())\n        # Probe the tree without the lock, so executor events keep arriving: a\n        # command that starts during a slow probe is in flight (and young) below\n        # instead of waiting on the lock while the check decides to preempt.\n        state = self._fingerprint()\n        with self._lock:\n            tree_changed = state is not None and state != self._last_state\n            progressed = tree_changed or self._new_outcomes > 0\n            in_flight = self._in_flight()\n            young = set(in_flight) - self._in_flight_at_check\n            self._in_flight_at_check = seen_before_probe & set(in_flight)\n            check = {\n                \"elapsed_s\": round(now - self._last_check_at, 3),\n                \"progress\": progressed,\n                \"new_outcomes\": self._new_outcomes,\n                \"tree_changed\": tree_changed,\n                \"tree_observable\": state is not None,\n                \"commands_in_flight\": len(in_flight),\n                \"commands_started_since_check\": len(young),\n                \"request_before\": self._request,\n            }\n            self.checks.append(check)\n            self._last_check_at = now\n            self._last_state = state if state is not None else self._last_state\n            self._new_outcomes = 0\n            if progressed:\n                self._last_progress_at = now\n                if self._request in (\"delivered\", \"delivered-between-checks\"):\n                    self._mark_answered(True, \"progress\")\n                self._request = None\n                return None\n            if young:\n                # A command started after the last check has run less than one\n                # window, and preemption never kills a command that young: the\n                # request (or stop) waits for its completion or the next check.\n                check[\"deferred_for_young_command\"] = True\n                if self._request is None:\n                    self._request = \"deferred\"\n                return None\n            if self._request == \"delivered-between-checks\":\n                # Less than a window has passed since delivery: start it now.\n                self._request = \"delivered\"\n                check[\"request_window_started\"] = True\n                return None\n            if self._request in (None, \"deferred\"):\n                self._request = \"delivered\"\n                return self._record(self._checkpoint_request(interrupted=list(in_flight.values())))\n            self._mark_answered(False, \"unanswered\")\n            window = _duration(self.window_seconds)\n            running = [f\"`{command[:200]}`\" if command else \"an unnamed command\"\n                       for command in in_flight.values()]\n            killed = f\"; interrupted: {', '.join(running)}\" if running else \"\"\n            return self._record(\n                Action(\n                    \"stop\",\n                    f\"no commit, file change, or new command result in two consecutive \"\n                    f\"{window} windows; the checkpoint request went unanswered{killed}\",\n                    \"no-progress-stop\",\n                )\n            )\n\n    def _mark_answered(self, answered: bool, by: str) -> None:\n        for message in reversed(self.messages):\n            if message[\"reason_code\"] == \"no-progress\":\n                if \"answered\" not in message:\n                    message.update(answered=answered, answered_by=by)\n                return\n\n    def finish(self, *, ended_normally: bool) -> None:\n        \"\"\"The executor stopped running; a clean end answers a delivered request.\n\n        A clean end is the executor's own exit 0 (its final report or a\n        `BLOCKED:` line ends the turn); a timeout, interruption, or failure\n        leaves the request unanswered.\n        \"\"\"\n        with self._lock:\n            if self._request in (\"delivered\", \"delivered-between-checks\"):\n                if ended_normally:\n                    self._mark_answered(True, \"lane-ended\")\n                else:\n                    self._mark_answered(False, \"lane-failed\")\n            self._request = None\n\n    def _record(self, action: Action | None) -> Action | None:\n        if action is None:\n            return None\n        if action.kind == \"stop\":\n            self.stop_reason = action.text\n        else:\n            self.messages.append({\"reason_code\": action.reason_code, \"text\": action.text})\n        return action\n\n    def snapshot(self, now: float) -> dict[str, Any]:\n        with self._lock:\n            since = None if self._last_progress_at is None else now - self._last_progress_at\n            return {\n                \"window_seconds\": self.window_seconds,\n                \"seconds_since_progress_seen\": (\n                    None if since is None else round(max(0.0, since), 3)\n                ),\n                \"checkpoint_request\": self._request,\n            }\n\n    def receipt(self) -> dict[str, Any]:\n        with self._lock:\n            return {\n                \"window_seconds\": self.window_seconds,\n                \"window_source\": self.window_source,\n                \"stop_enabled\": self.window_seconds > 0,\n                \"checks\": list(self.checks),\n                \"messages\": [dict(message) for message in self.messages],\n                \"stop_reason\": self.stop_reason,\n            }\n",
    "prompt_encoding": "utf-8",
    "size_bytes": 20949,
    "source": "working-tree:scripts/task_run/task_run_progress_rule.py"
