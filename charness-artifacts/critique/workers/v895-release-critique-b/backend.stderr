    "prompt_content": "#!/usr/bin/env bash\nset -euo pipefail\nREPO_ROOT=\"$(git rev-parse --show-toplevel)\"\ncd \"$REPO_ROOT\"\n\nMUTATION_RECOVERY_DIR=\"$(git rev-parse --git-dir)/charness-mutation-recovery\"\nif [[ -e \"$MUTATION_RECOVERY_DIR\" || -e \"$REPO_ROOT/.charness/mutation-recovery\" ]]; then\n  echo \"charness pre-commit: interrupted mutation recovery is REQUIRED; run python3 scripts/mutation/mutate_and_restore.py --repo-root . --check-recovery, then --recover\" >&2\n  exit 2\nfi\n\n# Commit-time validation is intentionally local and cheap; broader release proof\n# belongs to the explicit release quality lane.\nif ! git diff --cached --check; then\n  echo \"charness pre-commit: staged whitespace errors\" >&2\n  exit 2\nfi\n\n# This is advisory-only: it reads staged Python test hunks in two batched Git\n# queries and names direct process/Git fixture construction without blocking a\n# commit. A non-empty pytest.mark.boundary_contract(reason=\"...\") records why a\n# delivery boundary is intentional; this staged advisory makes new direct\n# crossings visible without blocking the commit.\nif ! python3 -B scripts/hooks/check_staged_test_boundaries.py --repo-root \"$REPO_ROOT\"; then\n  echo \"ADVISORY: staged test boundary review unavailable; commit was not blocked.\" >&2\nfi\n\n# This is an advisory boundary: the conditional consumes the checker's failure\n# status while preserving its finding or unavailable-check output.\nif ! python3 -B skills/public/quality/scripts/check_regenerable_facts.py --repo-root \"$REPO_ROOT\" --staged-paths; then\n  echo \"ADVISORY: regenerable-facts checker unavailable; commit was not blocked.\" >&2\nfi\n\n# Commit identity is stamped here and becomes expensive to repair after push.\n# This existing checker caught the historical 62-commit `.invalid` incident;\n# keep it wired directly to the cheap commit boundary instead of hiding it in a\n# broad quality lane.\n# Preserve every identity override Git exposes to the hook. `-B` prevents this\n# small stdlib-only checker from leaving bytecode in the worktree without\n# clearing Git configuration variables first.\npython3 -B scripts/gates/check_git_identity.py --repo-root \"$REPO_ROOT\"\n\n# The first-read instruction router is shared state for every future session, and\n# the prose rule asking an agent to stop before editing it did not hold on its\n# own. This refusal makes stopping the default; CHARNESS_ALLOW_ROUTER_CHANGE=1 is\n# how the operator's approval takes effect.\npython3 -B scripts/hooks/check_staged_router_change.py --repo-root \"$REPO_ROOT\"\n\n# Slice-reopen skips the release-lane receipt, not these owners. Docs-length,\n# Python tokei caps, the module-eviction form, and the debug seam-risk index\n# are the cheap class that the full --release lane was naming one miss at a time.\npython3 -B scripts/hooks/check_staged_cheap_owners.py --repo-root \"$REPO_ROOT\"\n",
