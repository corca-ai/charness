  {
    "carrier_path": "/home/hwidong/.cache/tmp/charness/runtime/811b9f8f8a808bfa/scratch/critique-review/review-c55418ca492342351d27ff5ca42eedcf/semantic-input/0010-content.bin",
    "carrier_sha256": "54aedd90198468fafcd7c777b4df8c4fec6ebd9ecbf99252b49eadf501115817",
