_source_checkout_under_work(args: argparse.Namespace) -> Path | None:\n        \"\"\"The parent repo itself, when it is a charness source checkout.\n\n        `charness task run --repo-root .` inside this repository must run THIS\n        checkout's task runner, not the managed checkout under `~/.agents/src`:\n        on 2026-09-02 a runner fix (the worktree `.agents/` sandbox grant) sat\n        unused for a session because the installed CLI loaded the stale managed\n        copy. An explicit `--charness-checkout` still wins; a parent that is not a\n        source checkout falls through to the managed resolution.\n        \"\"\"\n        # Called only from the unembedded-only resolver above, so the whole body\n        # is likewise unreachable in measured runs.\n        parent = getattr(args, \"repo_root\", None)  # pragma: no cover - unembedded-only caller; see above.\n        if parent is None:  # pragma: no cover - unembedded-only caller; see above.\n            return None\n        candidate = Path(parent).resolve()  # pragma: no cover - unembedded-only caller; see above.\n        if (candidate / \"packaging\" / f\"{PACKAGE_ID}.json\").is_file() and (  # pragma: no cover - unembedded-only caller; see above.\n            candidate / \"scripts\" / \"task_run\" / \"task_run.py\"\n        ).is_file():\n            return candidate\n        return None  # pragma: no cover - unembedded-only caller; see above.\n\n    def bool_env(name: str) -> bool:\n        # The FIFTH copy of the table owned by `scripts/core/env_bypass.py`, and the one\n        # copy that cannot import its owner. This file is the installed standalone\n        # CLI: `source_root` above returns None when no charness source tree is\n        # present, so `scripts` is not importable here in the case this entry point\n        # exists to serve. The duplication is deliberate and load-bearing.\n        #\n        # It is still the same contract, so it keeps the same allowlist: bare\n        # truthiness would make `CHARNESS_NO_UPDATE_CHECK=0` -- the spelling an\n        # operator uses to keep the check ON -- switch it off. If the table in\n        # `scripts/core/env_bypass.py` ever changes, change it here too.\n        return os.environ.get(name, \"\").strip().lower() in {\"1\", \"true\", \"yes\", \"on\"}\n\n    def build_self_update_notice(latest_release: object) -> str | None:\n        if not isinstance(latest_release, dict):\n            return None\n        if (\n            latest_release.get(\"status\") != \"ok\"\n            or latest_release.get(\"update_available\") is not True\n        ):\n            return None\n        current_version = latest_release.get(\"current_version\") or \"unknown\"\n        latest = latest_release.get(\"latest_tag\") or latest_release.get(\"latest_version\")\n        if not isinstance(latest, str) or not latest:\n            return None\n        url = latest_release.get(\"html_url\")\n        suffix = f\" {url}\" if isinstance(url, str) and url else \"\"\n        return (\n            f\"charness release available: `{current_version}` -> `{latest}`. \"\n            f\"Upgrade with `charness update` from the installed CLI.{suffix}\"\n        )\n\n    def build_version_payload(\n        *,\n        home_root: Path,\n        repo_root: Path,\n        managed_checkout: bool,\n        cli_path: Path,\n        check: bool,\n    ) -> dict[str, object]:\n        provenance = build_version_provenance(\n            home_root=home_root,\n            repo_root=repo_root,\n            managed_checkout=managed_checkout,\n            cli_path=cli_path,\n        )\n        state = write_version_state(home_root, provenance=provenance)\n        if check:\n            state = refresh_self_release_state(\n                home_root=home_root,\n                current_version=provenance.get(\"current_version\")\n                if isinstance(provenance.get(\"current_version\"), str)\n                else None,\n            )\n        latest_release = state.get(\"latest_release\")\n        payload = {\n            \"package_id\": PACKAGE_ID,\n            \"current_version\": provenance.get(\"current_version\"),\n            \"current_git_head\": provenance.get(\"current_git_head\"),\n            \"repo_root\": str(repo_root),\n            \"managed_checkout\": managed_checkout,\n            \"version_state_path\": str(default_version_state_path(home_root)),\n            \"version_provenance\": provenance,\n            \"latest_release_check\": latest_release,\n            \"update_notice\": build_self_update_notice(latest_release),\n        }\n        return payload\n\n    def build_version_provenance(\n        *,\n        home_root: Path,\n        repo_root: Path,\n        managed_checkout: bool,\n        cli_path: Path,\n    ) -> dict[str, object]:\n        runtime_path = _bootstrap.SCRIPT_PATH.resolve()\n        configured_cli_path = cli_path.resolve()\n        checkout_present = has_source_manifest(repo_root)\n        invocation_kind = \"custom-cli\"\n        install_method: str | None = None\n\n        if runtime_path == configured_cli_path:\n            invocation_kind = \"installed-cli\"\n            install_method = \"managed-local-cli\" if managed_checkout else \"custom-cli\"\n        elif checkout_present and runtime_path == (repo_root / \"charness\").resolve():\n            invocation_kind = \"source-checkout\"\n            install_method = \"checkout\"\n\n        eligible = bool(\n            invocation_kind == \"installed-cli\"\n            and managed_checkout\n            and checkout_present\n            and packaging_version(repo_root)\n        )\n\n        return {\n            \"checked_at\": now_iso(),\n            \"repo_root\": str(repo_root),\n            \"managed_checkout\": managed_checkout,\n            \"checkout_present\": checkout_present,\n            \"current_version\": packaging_version(repo_root) if checkout_present else None,\n            \"current_git_head\": git_head(repo_root) if checkout_present else None,\n            \"runtime_path\": str(runtime_path),\n            \"configured_cli_path\": str(configured_cli_path),\n            \"invocation_kind\": invocation_kind,\n            \"install_method\": install_method,\n            \"eligible_for_auto_update_check\": eligible,\n        }\n    def compare_semver_like(left: object, right: object) -> int | None:\n        parsed_left = parse_semver_like(left)\n        parsed_right = parse_semver_like(right)\n        if parsed_left is None or parsed_right is None:\n            return None\n        left_core, left_prerelease = parsed_left\n        right_core, right_prerelease = parsed_right\n        max_length = max(len(left_core), len(right_core))\n        left_core_padded = left_core + (0,) * (max_length - len(left_core))\n        right_core_padded = right_core + (0,) * (max_length - len(right_core))\n        if left_core_padded < right_core_padded:\n            return -1\n        if left_core_padded > right_core_padded:\n            return 1\n        if left_prerelease == right_prerelease:\n            return 0\n        if not left_prerelease:\n            return 1\n        if not right_prerelease:\n            return -1\n        if left_prerelease < right_prerelease:\n            return -1\n        return 1\n\n    def compute_update_available(\n        current_version: str | None, latest_version: object\n    ) -> bool | None:\n        comparison = compare_semver_like(current_version, latest_version)\n        if comparison is None:\n            return None\n        return comparison < 0\n\n    def default_bootstrap_repo_url(home_root: Path, configured_repo_url: str) -> str:\n        return configured_repo_url\n\n    def default_claude_wrapper_path(home_root: Path) -> Path:\n        return home_root / \".local\" / \"bin\" / \"claude-charness\"\n\n    def default_cli_path(home_root: Path) -> Path:\n        return home_root / \".local\" / \"bin\" / \"charness\"\n\n    def default_codex_cache_root(home_root: Path) -> Path:\n        return home_root / \".codex\" / \"plugins\" / \"cache\"  # pragma: no cover - no fallback caller: codex cache refresh runs in phase 2 once imports unblock; the bundled copy exists for sync parity.\n\n    def default_codex_marketplace_path(home_root: Path) -> Path:\n        return home_root / \".agents\" / \"plugins\" / \"marketplace.json\"\n\n    def default_home_root() -> Path:\n        return Path.home().resolve()\n\n    def default_install_state_path(home_root: Path) -> Path:\n        return default_state_root(home_root) / \"install-state.json\"\n\n    def default_plugin_root(home_root: Path) -> Path:\n        return home_root / \".codex\" / \"plugins\" / PACKAGE_ID\n\n    def default_state_root(home_root: Path) -> Path:\n        return resolve_state_home(home_root) / PACKAGE_ID\n\n    def default_version_state_path(home_root: Path) -> Path:\n        return default_state_root(home_root) / \"version-state.json\"\n\n    def emit_progress(message: str) -> None:\n        \"\"\"Keep progress out of the public structured stdout stream.\"\"\"\n        print(message, file=sys.stderr, flush=True)\n\n    def emit_yaml(payload: object) -> None:\n        print(render_yaml(payload), end=\"\")\n\n    def enforce_managed_cli_contract(\n        *,\n        home_root: Path,\n        repo_root: Path,\n        managed_checkout: bool,\n        skip_cli_install: bool,\n    ) -> None:\n        if managed_checkout:\n            return\n        if skip_cli_install:\n            return\n        raise CharnessError(\n            \"official charness installs must use the managed checkout \"\n            f\"`{managed_checkout_root(home_root)}`; for proof-only runs from another checkout, rerun with `--skip-cli-install`.\"\n        )\n\n    def ensure_checkout(\n        repo_root: Path, *, managed: bool, repo_url: str, allow_clone: bool, allow_pull: bool\n    ) -> dict[str, object]:\n        if has_source_manifest(repo_root):\n            cloned = False\n            pulled = False\n            if allow_pull and managed:\n                if not is_git_checkout(repo_root):\n                    raise CharnessError(\n                        f\"`{repo_root}` contains a source manifest but is not a git checkout\"\n                    )\n                if git_has_tracked_changes(repo_root):\n                    raise CharnessError(\n                        f\"managed checkout `{repo_root}` has tracked local changes; stop and resolve them before `charness update`\"\n                    )\n                pull_result = run([\"git\", \"pull\", \"--ff-only\"], cwd=repo_root)\n                if pull_result.returncode != 0:\n                    divergence = git_upstream_divergence(repo_root)\n                    if divergence is not None:\n                        upstream, ahead, behind = divergence\n                        if ahead > 0 and behind > 0:\n                            detail = _diverged_checkout_detail(repo_root, upstream)\n                            raise CharnessError(\n                                \"managed checkout \"\n                                f\"`{repo_root}` diverged from `{upstream}` (ahead {ahead}, behind {behind}); \"\n                                \"`charness update` only fast-forwards managed checkouts. \"\n                                \"If the local commit is intentional dogfood, run \"\n                                \"`charness update --repo-root . --no-pull --skip-cli-install` from that checkout. \"\n                                f\"Otherwise rebase or reset the managed checkout onto `{upstream}` and retry.\\n\"\n                                f\"{detail}\\n\"\n                                f\"STDOUT:\\n{pull_result.stdout}\\nSTDERR:\\n{pull_result.stderr}\"\n                            )\n                expect_success(pull_result, f\"git pull in `{repo_root}`\")\n                pulled = True\n            return {\n                \"repo_root\": str(repo_root),\n                \"managed\": managed,\n                \"cloned\": cloned,\n                \"pulled\": pulled,\n            }\n\n        if repo_root.exists():\n            if any(repo_root.iterdir()):\n                raise CharnessError(\n                    f\"`{repo_root}` exists but is not a charness source checkout; pass `--repo-root` or clean that path first\"\n                )\n        elif not allow_clone:\n            raise CharnessError(f\"missing source checkout `{repo_root}`\")\n\n        if not managed and not allow_clone:\n            raise CharnessError(f\"missing explicit source checkout `{repo_root}`\")\n\n        repo_root.parent.mkdir(parents=True, exist_ok=True)\n        clone_result = run([\"git\", \"clone\", repo_url, str(repo_root)])\n        expect_success(clone_result, f\"git clone into `{repo_root}`\")\n        return {\"repo_root\": str(repo_root), \"managed\": managed, \"cloned\": True, \"pulled\": False}\n\n    def expect_success(result: subprocess.CompletedProcess[str], context: str) -> None:\n        if result.returncode != 0:\n            raise CharnessError(\n                f\"{context} failed with exit code {result.returncode}\\nSTDOUT:\\n{result.stdout}\\nSTDERR:\\n{result.stderr}\"\n            )\n\n    def extract_version(text: object) -> str | None:\n        if not isinstance(text, str):\n            return None\n        match = re.search(r\"(?<!\\d)(\\d+(?:\\.\\d+){1,}(?:-[0-9A-Za-z.-]+)?)(?![0-9A-Za-z.-])\", text)\n        return match.group(1) if match else None\n\n    def fixture_release(repo: str) -> dict[str, object] | None:\n        fixture_path = os.environ.get(\"CHARNESS_RELEASE_PROBE_FIXTURES\")\n        if not fixture_path:\n            return None\n        data = json.loads(Path(fixture_path).read_text(encoding=\"utf-8\"))\n        payload = data.get(repo)\n        return payload if isinstance(payload, dict) else None\n\n    def git_has_tracked_changes(path: Path) -> bool:\n        result = run([\"git\", \"status\", \"--short\", \"--untracked-files=no\"], cwd=path)\n        expect_success(result, f\"git status in `{path}`\")\n        return any(line.strip() for line in result.stdout.splitlines())\n\n    def git_head(path: Path) -> str | None:\n        if not is_git_checkout(path):\n            return None\n        result = run([\"git\", \"rev-parse\", \"--short\", \"HEAD\"], cwd=path)\n        if result.returncode != 0:\n            return None\n        head = result.stdout.strip()\n        return head or None\n\n    def git_upstream_divergence(path: Path) -> tuple[str, int, int] | None:\n        upstream = git_upstream_ref(path)\n        if upstream is None:\n            return None\n        result = run([\"git\", \"rev-list\", \"--left-right\", \"--count\", f\"HEAD...{upstream}\"], cwd=path)\n        if result.returncode != 0:\n            return None\n        counts = result.stdout.strip().split()\n        if len(counts) != 2:\n            return None\n        try:\n            ahead = int(counts[0])\n            behind = int(counts[1])\n        except ValueError:\n            return None\n        return upstream, ahead, behind\n\n    def git_upstream_ref(path: Path) -> str | None:\n        result = run(\n            [\"git\", \"rev-parse\", \"--abbrev-ref\", \"--symbolic-full-name\", \"@{upstream}\"], cwd=path\n        )\n        if result.returncode != 0:\n            return None\n        upstream = result.stdout.strip()\n        return upstream or None\n\n    def has_source_manifest(path: Path) -> bool:\n        return (path / \"packaging\" / f\"{PACKAGE_ID}.json\").is_file()\n\n    def is_git_checkout(path: Path) -> bool:\n        return (path / \".git\").exists()\n\n    def latest_release_cache_is_fresh(\n        latest_release: dict[str, object], current_version: str | None\n    ) -> bool:\n        checked_at = parse_iso_timestamp(latest_release.get(\"checked_at\"))\n        if checked_at is None:\n            return False\n        if checked_at < datetime.now(timezone.utc) - timedelta(hours=24):\n            return False\n        return normalize_version_token(\n            latest_release.get(\"current_version\")\n        ) == normalize_version_token(current_version)\n\n    def managed_checkout_root(home_root: Path) -> Path:\n        return home_root / \".agents\" / \"src\" / PACKAGE_ID\n\n    def maybe_record_self_version_state(args: argparse.Namespace) -> None:\n        if getattr(args, \"command\", None) == \"task\":\n            return\n        home_root = getattr(args, \"home_root\", default_home_root()).resolve()\n        repo_root, managed_checkout = resolve_repo_root(home_root, getattr(args, \"repo_root\", None))\n        cli_arg = getattr(args, \"cli_path\", None)\n        cli_path = cli_arg.resolve() if isinstance(cli_arg, Path) else default_cli_path(home_root)\n        provenance = build_version_provenance(\n            home_root=home_root,\n            repo_root=repo_root,\n            managed_checkout=managed_checkout,\n            cli_path=cli_path,\n        )\n        state = write_version_state(home_root, provenance=provenance)\n        latest_release = state.get(\"latest_release\")\n        current_version = provenance.get(\"current_version\")\n        if getattr(args, \"command\", None) == \"update\":\n            return\n        if should_auto_refresh_self_release(args, provenance):\n            if not isinstance(latest_release, dict) or not latest_release_cache_is_fresh(\n                latest_release, current_version\n            ):\n                state = refresh_self_release_state(\n                    home_root=home_root,\n                    current_version=current_version if isinstance(current_version, str) else None,\n                )\n                latest_release = state.get(\"latest_release\")\n            notice = build_self_update_notice(latest_release)\n            if notice:\n                print(notice, file=sys.stderr)\n\n    def maybe_reexec_refreshed_cli(\n        checkout_repo_root: Path,\n        *,\n        running_cli: Path | None = None,\n        execve: Callable[..., object] | None = None,\n    ) -> dict[str, object] | None:\n        checkout_cli = checkout_repo_root / \"charness\"\n        # Post-#873 this module is not the entrypoint: a bare `Path(__file__)`\n        # names the feature module, which never byte-matches the checkout CLI, so\n        # an omitted `running_cli` re-exec'd every run. Prefer the entry context\n        # the root shim publishes; `__file__` only serves direct unit use.\n        current_cli = (running_cli or SCRIPT_PATH or Path(__file__)).resolve()\n        reexec_child = os.environ.get(_CLI_REEXEC_GUARD_ENV) == str(os.getpid())\n        try:\n            if (\n                not checkout_cli.is_file()\n                or checkout_cli.resolve() == current_cli\n                or checkout_cli.read_bytes() == current_cli.read_bytes()\n            ):\n                if reexec_child:\n                    return {\"status\": \"reexecuted\", \"checkout_cli\": str(checkout_cli)}\n                return None\n        except OSError:\n            return None\n        if reexec_child:\n            emit_progress(\n                \"WARNING: running CLI still differs from the refreshed checkout after one re-exec; \"\n                \"continuing without another re-exec — if this run fails, re-run the command.\",\n            )\n            return {\n                \"status\": \"skipped\",\n                \"reason\": \"already re-executed once; loop guard active\",\n                \"checkout_cli\": str(checkout_cli),\n            }\n        # Coverage note: the lines below run but cannot be measured. A\n        # successful execve replaces the image without running atexit, so the\n        # parent's coverage shard is lost (slice E4 proves the behavior\n        # through the re-executed child's observable effects instead).\n        emit_progress(  # pragma: no cover - executes, unmeasurable; see above.\n            \"STEP: source checkout code differs from the running CLI; re-executing the checkout's CLI so the run matches its scripts\",\n        )\n        env = dict(os.environ)  # pragma: no cover - executes, unmeasurable; see above.\n        env[_CLI_REEXEC_GUARD_ENV] = str(os.getpid())  # pragma: no cover - executes, unmeasurable; see above.\n        try:  # pragma: no cover - executes, unmeasurable; see above.\n            (execve or os.execve)(  # pragma: no cover - executes, unmeasurable; see above.\n                sys.executable, [sys.executable, str(checkout_cli), *sys.argv[1:]], env\n            )\n        except OSError as exc:  # pragma: no cover - unreachable in practice: the kernel only refuses what the pre-flight stat/read already validated.\n            emit_progress(\n                f\"WARNING: re-exec of the refreshed CLI failed ({exc}); continuing with the running CLI — \"\n                \"if this run fails, re-run the command.\",\n            )\n            return {\n                \"status\": \"failed\",\n                \"reason\": f\"re-exec failed: {exc}\",\n                \"checkout_cli\": str(checkout_cli),\n            }\n        return None\n\n    def normalize_release_payload(repo: str, payload: dict[str, object]) -> dict[str, object]:\n        latest_tag = payload.get(\"tag_name\")\n        html_url = payload.get(\"html_url\")\n        published_at = payload.get(\"published_at\")\n        assets = payload.get(\"assets\", [])\n        asset_names = [\n            asset[\"name\"]\n            for asset in assets\n            if isinstance(asset, dict) and isinstance(asset.get(\"name\"), str)\n        ]\n        release = {\n            \"provider\": \"github\",\n            \"repo\": repo,\n            \"status\": \"ok\",\n            \"api_url\": f\"https://api.github.com/repos/{repo}/releases/latest\",\n            \"html_url\": html_url if isinstance(html_url, str) else None,\n            \"latest_tag\": latest_tag if isinstance(latest_tag, str) else None,\n            \"latest_version\": extract_version(latest_tag),\n            \"published_at\": published_at if isinstance(published_at, str) else None,\n            \"asset_names\": asset_names,\n            \"error\": None,\n        }\n        if isinstance(payload.get(\"status\"), str):\n            release[\"status\"] = payload[\"status\"]\n        if isinstance(payload.get(\"error\"), str):\n            release[\"error\"] = payload[\"error\"]\n        return release\n\n    def normalize_version_token(value: object) -> str | None:\n        if not isinstance(value, str):\n            return None\n        normalized = value.strip()\n        if not normalized:\n            return None\n        if normalized.startswith((\"v\", \"V\")) and len(normalized) > 1:\n            normalized = normalized[1:]\n        return normalized\n\n    def now_iso() -> str:\n        return datetime.now(timezone.utc).isoformat().replace(\"+00:00\", \"Z\")\n\n    def packaging_version(path: Path) -> str | None:\n        manifest_path = path / \"packaging\" / f\"{PACKAGE_ID}.json\"\n        if not manifest_path.is_file():\n            return None\n        data = json.loads(manifest_path.read_text(encoding=\"utf-8\"))\n        version = data.get(\"version\")\n        return version if isinstance(version, str) else None\n\n    def parse_iso_timestamp(value: object) -> datetime | None:\n        if not isinstance(value, str) or not value:\n            return None\n        normalized = value.replace(\"Z\", \"+00:00\")\n        try:\n            return datetime.fromisoformat(normalized)\n        except ValueError:\n            return None\n\n    def parse_semver_like(\n        value: object,\n    ) -> tuple[tuple[int, ...], tuple[tuple[int, int | str], ...]] | None:\n        normalized = normalize_version_token(value)\n        if normalized is None:\n            return None\n        core, _, prerelease = normalized.partition(\"-\")\n        try:\n            core_parts = tuple(int(part) for part in core.split(\".\"))\n        except ValueError:\n            return None\n        if not core_parts:\n            return None  # pragma: no cover - str.split never yields an empty tuple; non-numeric cores exit via ValueError above.\n        prerelease_parts = (\n            tuple(_parse_prerelease_identifier(part) for part in prerelease.split(\".\") if part)\n            if prerelease\n            else ()\n        )\n        return core_parts, prerelease_parts\n\n    def probe_self_release(repo: str | None = None) -> dict[str, object]:\n        # Imported here, not at module scope: `urllib.request` pulls in `http.client`,\n        # `ssl`, and `email.parser`, which measured 17ms of this CLI's ~114ms startup —\n        # paid by every `charness` invocation, while the one network path that needs it\n        # is this function, past the fixture short-circuit.\n        import urllib.error\n        import urllib.request\n\n        repo = repo or self_release_repo()\n        fixture = fixture_release(repo)\n        if fixture is not None:\n            return normalize_release_payload(repo, fixture)\n\n        request = urllib.request.Request(\n            f\"https://api.github.com/repos/{repo}/releases/latest\",\n            headers={\n                \"Accept\": \"application/vnd.github+json\",\n                \"User-Agent\": \"charness-self-update-check\",\n            },\n        )\n        try:\n            with urllib.request.urlopen(request, timeout=10) as response:\n                payload = json.loads(response.read().decode(\"utf-8\"))  # pragma: no cover - needs a live registry response body; offline runs use the fixture short-circuit or the error branches below.\n        except urllib.error.HTTPError as exc:\n            status = \"no-release\" if exc.code == 404 else \"error\"\n            return {\n                \"provider\": \"github\",\n                \"repo\": repo,\n                \"status\": status,\n                \"api_url\": f\"https://api.github.com/repos/{repo}/releases/latest\",\n                \"html_url\": None,\n                \"latest_tag\": None,\n                \"latest_version\": None,\n                \"published_at\": None,\n                \"asset_names\": [],\n                \"error\": f\"http {exc.code}\",\n            }\n        except (TimeoutError, urllib.error.URLError, json.JSONDecodeError) as exc:\n            return {\n                \"provider\": \"github\",\n                \"repo\": repo,\n                \"status\": \"error\",\n                \"api_url\": f\"https://api.github.com/repos/{repo}/releases/latest\",\n                \"html_url\": None,\n                \"latest_tag\": None,\n                \"latest_version\": None,\n                \"published_at\": None,\n                \"asset_names\": [],\n                \"error\": str(exc),\n            }\n        return normalize_release_payload(repo, payload)  # pragma: no cover - live-response-only; see above.\n\n    def read_install_state(home_root: Path) -> tuple[Path, bool] | None:\n        path = default_install_state_path(home_root)\n        if not path.is_file():\n            return None\n        try:\n            payload = json.loads(path.read_text(encoding=\"utf-8\"))\n        except (OSError, json.JSONDecodeError):\n            return None\n        repo_root = payload.get(\"repo_root\")\n        managed_checkout = payload.get(\"managed_checkout\")\n        if not isinstance(repo_root, str) or not isinstance(managed_checkout, bool):\n            return None\n        return Path(repo_root).resolve(), managed_checkout\n\n    def read_version_state(home_root: Path) -> dict[str, object]:\n        path = default_version_state_path(home_root)\n        if not path.is_file():\n            return {\"state_version\": 1}\n        try:\n            payload = json.loads(path.read_text(encoding=\"utf-8\"))\n        except (OSError, json.JSONDecodeError):\n            return {\"state_version\": 1}\n        if not isinstance(payload, dict):\n            return {\"state_version\": 1}\n        payload.setdefault(\"state_version\", 1)\n        return payload\n\n    def refresh_self_release_state(\n        *,\n        home_root: Path,\n        current_version: str | None,\n    ) -> dict[str, object]:\n        latest_release = probe_self_release()\n        latest_release[\"checked_at\"] = now_iso()\n        latest_release[\"current_version\"] = current_version\n        latest_release[\"update_available\"] = compute_update_available(\n            current_version, latest_release.get(\"latest_version\")\n        )\n        return write_version_state(home_root, latest_release=latest_release)\n\n    def render_yaml(payload: object) -> str:\n        \"\"\"Render one portable YAML document for the public CLI boundary.\"\"\"\n        normalized = json.loads(json.dumps(payload, ensure_ascii=False, allow_nan=False))\n        try:\n            import yaml\n        except ImportError:\n            # JSON is valid YAML. Keep the copied standalone CLI usable before the\n            # managed bootstrap runtime has provisioned PyYAML.\n            return json.dumps(normalized, ensure_ascii=False, separators=(\",\", \":\")) + \"\\n\"\n        return yaml.safe_dump(normalized, allow_unicode=True, sort_keys=False)\n\n    def resolve_repo_root(home_root: Path, explicit_repo_root: Path | None) -> tuple[Path, bool]:\n        if explicit_repo_root is not None:\n            return explicit_repo_root.resolve(), False\n        remembered = read_install_state(home_root)\n        if remembered is not None and remembered[1] is True:\n            return remembered\n        return managed_checkout_root(home_root), True\n\n    def resolve_runtime_paths(args: argparse.Namespace) -> tuple[Path, Path, Path, Path]:\n        home_root = args.home_root.resolve()\n        plugin_root = (\n            args.plugin_root.resolve() if args.plugin_root else default_plugin_root(home_root)\n        )\n        codex_marketplace_path = (\n            args.codex_marketplace_path.resolve()\n            if args.codex_marketplace_path\n            else default_codex_marketplace_path(home_root)\n        )\n        claude_wrapper_path = (\n            args.claude_wrapper_path.resolve()\n            if args.claude_wrapper_path\n            else default_claude_wrapper_path(home_root)\n        )\n        cli_path = args.cli_path.resolve() if args.cli_path else default_cli_path(home_root)\n        return plugin_root, codex_marketplace_path, claude_wrapper_path, cli_path\n\n    def resolve_state_home(home_root: Path) -> Path:\n        override = os.environ.get(\"CHARNESS_STATE_HOME\")\n        if override:\n            return Path(override).expanduser().resolve()\n        xdg_root = os.environ.get(\"XDG_STATE_HOME\")\n        if xdg_root:\n            return Path(xdg_root).expanduser().resolve()\n        return home_root / \".local\" / \"state\"\n\n    def resolve_target_repo_root(target_repo_root: Path | None) -> Path:\n        return target_repo_root.resolve() if target_repo_root is not None else Path.cwd().resolve()\n\n    def resolve_tool_repo_root(args: argparse.Namespace) -> tuple[Path, bool]:\n        home_root = args.home_root.resolve()\n        repo_root, managed_checkout = resolve_repo_root(home_root, args.repo_root)\n        ensure_checkout(\n            repo_root,\n            managed=managed_checkout,\n            repo_url=getattr(args, \"repo_url\", REPO_URL),\n            allow_clone=False,\n            allow_pull=False,\n        )\n        return repo_root, managed_checkout\n\n    def run(\n        command: list[str], *, cwd: Path | None = None, env: dict[str, str] | None = None\n    ) -> subprocess.CompletedProcess[str]:\n        from scripts.core.subprocess_guard import run_process\n\n        # The repo's one spawn primitive (#768). No timeout so callers keep the\n        # historical wait-forever contract; `None` cwd still inherits.\n        return run_process(command, cwd=cwd or Path.cwd(), env=env, timeout_seconds=None)\n    def self_release_repo() -> str:\n        match = re.search(r\"github\\.com/([^/]+/[^/]+?)(?:\\.git)?$\", REPO_URL)\n        return match.group(1) if match else \"corca-ai/charness\"\n\n    def should_auto_refresh_self_release(\n        args: argparse.Namespace, provenance: dict[str, object]\n    ) -> bool:\n        if provenance.get(\"eligible_for_auto_update_check\") is not True:\n            return False\n        if bool_env(\"CHARNESS_NO_UPDATE_CHECK\"):\n            return False\n        if bool_env(\"CI\"):\n            return False\n        if getattr(args, \"command\", None) == \"version\" and getattr(args, \"check\", False):\n            return False\n        if bool_env(\"CHARNESS_FORCE_UPDATE_CHECK\"):\n            return True\n        return sys.stdout.isatty() and sys.stderr.isatty()\n\n    def write_version_state(\n        home_root: Path,\n        *,\n        provenance: dict[str, object] | None = None,\n        latest_release: dict[str, object] | None = None,\n    ) -> dict[str, object]:\n        path = default_version_state_path(home_root)\n        state = read_version_state(home_root)\n        if provenance is not None:\n            state[\"version_provenance\"] = provenance\n        if latest_release is not None:\n            state[\"latest_release\"] = latest_release\n        try:\n            path.parent.mkdir(parents=True, exist_ok=True)\n            path.write_text(\n                json.dumps(state, ensure_ascii=False, indent=2) + \"\\n\", encoding=\"utf-8\"\n            )\n        except OSError:\n            # Version probes must stay usable even when host-local state is read-only.\n            return state\n        return state\n\n\ndef _load_feature(module_name: str, func_name: str, args=None, check=None):\n    \"\"\"Import a command payload from the target tree, setting entry context.\"\"\"\n    # Publish entry roots BEFORE importing the feature: features snapshot\n    # entry-bound names with `from ... import`, so the values must be set\n    # first (this also covers a just-cloned tree after cache invalidation).\n    try:\n        from scripts.cli import bootstrap as _bootstrap\n    except ImportError:\n        pass\n    else:\n        _bootstrap.set_entry_context(EMBEDDED_REPO_ROOT, SCRIPT_PATH)\n    try:\n        feature = importlib.import_module(f\"scripts.cli.{module_name}\")\n    except ImportError as exc:\n        if check is None or args is None:\n            raise  # pragma: no cover - no measured caller passes check=None with a failing payload import.\n        root = check(args)\n        if not isinstance(exc, ModuleNotFoundError) or exc.name != \"scripts\":\n            raise\n        # Standalone copy with no source tree on sys.path (#876): the check\n        # just resolved the checkout, so make it importable and retry once.\n        # Unembedded-only: measured runs resolve the embedded tree, so this\n        # branch is proven by mutant (charness:1026 kills\n        # test_standalone_copy_reaches_task_run_payload) rather than coverage.\n        if str(root) not in sys.path:  # pragma: no cover - unembedded-only; see above.\n            sys.path.insert(0, str(root))  # pragma: no cover - unembedded-only; see above.\n        feature = importlib.import_module(f\"scripts.cli.{module_name}\")  # pragma: no cover - unembedded-only; see above.\n    return getattr(feature, func_name)\n\n\ndef cmd_task_status(args: argparse.Namespace) -> int:\n    return _load_feature(\"cmd_task\", \"cmd_task_status\", args, _resolve_worktree_lib_root)(args=args)\n\n\ndef cmd_task_executors(args: argparse.Namespace) -> int:\n    return _load_feature(\"cmd_task\", \"cmd_task_executors\", args, _resolve_worktree_lib_root)(\n        args=args\n    )\n\n\ndef cmd_task_steer(args: argparse.Namespace) -> int:\n    return _load_feature(\"cmd_task\", \"cmd_task_steer\", args, _resolve_worktree_lib_root)(args=args)\n\n\ndef cmd_task_report(args: argparse.Namespace) -> int:\n    return _load_feature(\"cmd_task\", \"cmd_task_report\", args, _resolve_worktree_lib_root)(args=args)\n\n\ndef cmd_init(args: argparse.Namespace) -> int:\n    home_root = args.home_root.resolve()\n    repo_root, managed_checkout = resolve_repo_root(home_root, args.repo_root)\n    target_repo_root = resolve_target_repo_root(args.target_repo_root)\n    enforce_managed_cli_contract(\n        home_root=home_root,\n        repo_root=repo_root,\n        managed_checkout=managed_checkout,\n        skip_cli_install=args.skip_cli_install,\n    )\n    plugin_root, codex_marketplace_path, claude_wrapper_path, cli_path = resolve_runtime_paths(args)\n    checkout = ensure_checkout(\n        repo_root,\n        managed=managed_checkout,\n        repo_url=default_bootstrap_repo_url(home_root, args.repo_url),\n        allow_clone=True,\n        allow_pull=False,\n    )\n    # The entry script, not the helper's module: phase 1 runs before any\n    # entry-context re-publish, so the default cannot name the CLI here.\n    cli_reexec_state = maybe_reexec_refreshed_cli(\n        Path(checkout[\"repo_root\"]), running_cli=SCRIPT_PATH\n    )\n    # The checkout now exists (just cloned if needed). Put its root on the\n    # path so the phase-2 payload import below resolves against the checkout\n    # the run just ensured -- this keeps the standalone-copy contract where\n    # no source tree was importable before `ensure_checkout` ran.\n    checkout_root_text = str(Path(checkout[\"repo_root\"]))\n    if checkout_root_text not in sys.path:\n        sys.path.insert(0, checkout_root_text)\n    # The checkout may be newer than whatever `scripts.cli` tree this process\n    # already imported (e.g. a just-cloned managed checkout): drop cached\n    # payload modules so phase 2 loads the tree the run just ensured.\n    for _cached in [m for m in sys.modules if m == \"scripts.cli\" or m.startswith(\"scripts.cli.\")]:\n        del sys.modules[_cached]\n    from scripts.cli import bootstrap as _fresh_bootstrap\n    from scripts.cli.cmd_init import finish_init as _finish_init\n\n    # The purge above reloaded `scripts.cli` with default (None) entry-bound\n    # roots: re-publish the entry values so phase 2 reads them lazily.\n    _fresh_bootstrap.set_entry_context(EMBEDDED_REPO_ROOT, SCRIPT_PATH)\n\n    return _finish_init(\n        args,\n        home_root=home_root,\n        managed_checkout=managed_checkout,\n        target_repo_root=target_repo_root,\n        plugin_root=plugin_root,\n        codex_marketplace_path=codex_marketplace_path,\n        claude_wrapper_path=claude_wrapper_path,\n        cli_path=cli_path,\n        checkout=checkout,\n        cli_reexec_state=cli_reexec_state,\n        script_path=SCRIPT_PATH,\n        embedded_repo_root=EMBEDDED_REPO_ROOT,\n    )\n\n\ndef cmd_update(args: argparse.Namespace) -> int:\n    home_root = args.home_root.resolve()\n    repo_root, managed_checkout = resolve_repo_root(home_root, args.repo_root)\n    target_repo_root = resolve_target_repo_root(args.target_repo_root)\n    include_repo_onboarding = args.target_repo_root is not None\n    previous_checkout_version = packaging_version(repo_root) if repo_root.exists() else None\n    enforce_managed_cli_contract(\n        home_root=home_root,\n        repo_root=repo_root,\n        managed_checkout=managed_checkout,\n        skip_cli_install=args.skip_cli_install,\n    )\n    plugin_root, codex_marketplace_path, claude_wrapper_path, cli_path = resolve_runtime_paths(args)\n    emit_progress(\"STEP: refreshing source checkout\")\n    checkout = ensure_checkout(\n        repo_root,\n        managed=managed_checkout,\n        repo_url=args.repo_url,\n        allow_clone=False,\n        allow_pull=managed_checkout and not args.no_pull,\n    )\n    # Same entry-script rule as `cmd_init` above: name the CLI explicitly.\n    cli_reexec_state = maybe_reexec_refreshed_cli(\n        Path(checkout[\"repo_root\"]), running_cli=SCRIPT_PATH\n    )\n    # Same standalone-copy contract as `cmd_init`: the checkout now exists,\n    # so resolve the phase-2 payload against it before importing.\n    checkout_root_text = str(Path(checkout[\"repo_root\"]))\n    if checkout_root_text not in sys.path:\n        sys.path.insert(0, checkout_root_text)\n    # Same cache invalidation as `cmd_init`: load phase 2 from the ensured tree.\n    for _cached in [m for m in sys.modules if m == \"scripts.cli\" or m.startswith(\"scripts.cli.\")]:\n        del sys.modules[_cached]\n    from scripts.cli import bootstrap as _fresh_bootstrap\n    from scripts.cli.cmd_update import finish_update as _finish_update\n\n    # Same re-publish as `cmd_init`: the purge reset entry-bound roots.\n    _fresh_bootstrap.set_entry_context(EMBEDDED_REPO_ROOT, SCRIPT_PATH)\n\n    return _finish_update(\n        args,\n        home_root=home_root,\n        managed_checkout=managed_checkout,\n        target_repo_root=target_repo_root,\n        include_repo_onboarding=include_repo_onboarding,\n        previous_checkout_version=previous_checkout_version,\n        plugin_root=plugin_root,\n        codex_marketplace_path=codex_marketplace_path,\n        claude_wrapper_path=claude_wrapper_path,\n        cli_path=cli_path,\n        checkout=checkout,\n        cli_reexec_state=cli_reexec_state,\n    )\n\n\ndef cmd_doctor(args: argparse.Namespace) -> int:\n    return _load_feature(\"cmd_doctor\", \"cmd_doctor\", args)(args=args)\n\n\ndef cmd_version(args: argparse.Namespace) -> int:\n    home_root = args.home_root.resolve()\n    if args.repo_root is None and EMBEDDED_REPO_ROOT is not None:\n        repo_root, managed_checkout = EMBEDDED_REPO_ROOT, False\n    else:\n        repo_root, managed_checkout = resolve_repo_root(home_root, args.repo_root)\n    cli_path = args.cli_path.resolve() if args.cli_path else default_cli_path(home_root)\n    if not args.verbose and not args.check:\n        emit_yaml({\"version\": packaging_version(repo_root) or \"unknown\"})\n        return 0\n    payload = build_version_payload(\n        home_root=home_root,\n        repo_root=repo_root,\n        managed_checkout=managed_checkout,\n        cli_path=cli_path,\n        check=args.check,\n    )\n    emit_yaml(payload)\n    return 0\n\n\ndef cmd_uninstall(args: argparse.Namespace) -> int:\n    return _load_feature(\"cmd_meta\", \"cmd_uninstall\", args)(args=args)\n\n\ndef cmd_reset(args: argparse.Namespace) -> int:\n    return _load_feature(\"cmd_meta\", \"cmd_reset\", args)(args=args)\n\n\ndef cmd_capability_init(args: argparse.Namespace) -> int:\n    return _load_feature(\"cmd_capability\", \"cmd_capability_init\", args)(args=args)\n\n\ndef cmd_capability_resolve(args: argparse.Namespace) -> int:\n    return _load_feature(\"cmd_capability\", \"cmd_capability_resolve\", args)(args=args)\n\n\ndef cmd_capability_doctor(args: argparse.Namespace) -> int:\n    return _load_feature(\"cmd_capability\", \"cmd_capability_doctor\", args)(args=args)\n\n\ndef cmd_capability_env(args: argparse.Namespace) -> int:\n    return _load_feature(\"cmd_capability\", \"cmd_capability_env\", args)(args=args)\n\n\ndef cmd_capability_explain(args: argparse.Namespace) -> int:\n    return _load_feature(\"cmd_capability\", \"cmd_capability_explain\", args)(args=args)\n\n\ndef cmd_tool_doctor(args: argparse.Namespace) -> int:\n    return _load_feature(\"tool_commands\", \"cmd_tool_doctor\", args, resolve_tool_repo_root)(\n        args=args\n    )\n\n\ndef cmd_tool_repair(args: argparse.Namespace) -> int:\n    return _load_feature(\"tool_commands\", \"cmd_tool_repair\", args, resolve_tool_repo_root)(\n        args=args\n    )\n\n\ndef cmd_tool_sync_support(args: argparse.Namespace) -> int:\n    return _load_feature(\"tool_commands\", \"cmd_tool_sync_support\", args, resolve_tool_repo_root)(\n        args=args\n    )\n\n\ndef cmd_tool_install(args: argparse.Namespace) -> int:\n    return _load_feature(\"tool_commands\", \"cmd_tool_install\", args, resolve_tool_repo_root)(\n        args=args\n    )\n\n\ndef cmd_tool_update(args: argparse.Namespace) -> int:\n    return _load_feature(\"tool_commands\", \"cmd_tool_update\", args, resolve_tool_repo_root)(\n        args=args\n    )\n\n\ndef cmd_worktree_doctor(args: argparse.Namespace) -> int:\n    return _load_feature(\"cmd_worktree\", \"cmd_worktree_doctor\", args, _resolve_worktree_lib_root)(\n        args=args\n    )\n\n\ndef cmd_worktree_prepare(args: argparse.Namespace) -> int:\n    return _load_feature(\"cmd_worktree\", \"cmd_worktree_prepare\", args, _resolve_worktree_lib_root)(\n        args=args\n    )\n\n\ndef cmd_worktree_audit(args: argparse.Namespace) -> int:\n    return _load_feature(\"cmd_worktree\", \"cmd_worktree_audit\", args, _resolve_worktree_lib_root)(\n        args=args\n    )\n\n\ndef cmd_worktree_cleanup(args: argparse.Namespace) -> int:\n    return _load_feature(\"cmd_worktree\", \"cmd_worktree_cleanup\", args, _resolve_worktree_lib_root)(\n        args=args\n    )\n\n\ndef cmd_worktree_create(args: argparse.Namespace) -> int:\n    return _load_feature(\"cmd_worktree\", \"cmd_worktree_create\", args, _resolve_worktree_lib_root)(\n        args=args\n    )\n\n\ndef cmd_worktree_exec(args: argparse.Namespace) -> int:\n    return _load_feature(\"cmd_worktree\", \"cmd_worktree_exec\", args, _resolve_worktree_lib_root)(\n        args=args\n    )\n\n\ndef cmd_hooks_status(args: argparse.Namespace) -> int:\n    return _load_feature(\"cmd_hooks\", \"cmd_hooks_status\", args, _resolve_worktree_lib_root)(\n        args=args\n    )\n\n\ndef cmd_task_wait(args: argparse.Namespace) -> int:\n    return _load_feature(\"cmd_task\", \"cmd_task_wait\", args, _resolve_worktree_lib_root)(args=args)\n\n\ndef cmd_task_run(args: argparse.Namespace) -> int:\n    return _load_feature(\"cmd_task\", \"cmd_task_run\", args, _resolve_worktree_lib_root)(args=args)\n\n\ndef cmd_train(args: argparse.Namespace) -> int:\n    return _load_feature(\"cmd_train\", \"cmd_train\", args, _resolve_worktree_lib_root)(args=args)\n\n\ndef cmd_goal_run(args: argparse.Namespace) -> int:\n    return _load_feature(\"cmd_goal\", \"cmd_goal_run\", args)(args=args)\n\n\ndef cmd_catalog_list(args: argparse.Namespace) -> int:\n    return _load_feature(\"cmd_catalog\", \"cmd_catalog_list\", args)(args=args)\n\n\ndef cmd_catalog_refresh(args: argparse.Namespace) -> int:\n    return _load_feature(\"cmd_catalog\", \"cmd_catalog_refresh\", args)(args=args)\n\n\ndef cmd_catalog_resolve_skill_path(args: argparse.Namespace) -> int:\n    return _load_feature(\"cmd_catalog\", \"cmd_catalog_resolve_skill_path\", args)(args=args)\n\n\ndef build_parser() -> argparse.ArgumentParser:\n    parser = argparse.ArgumentParser(\n        description=\"Thin charness CLI for managed local install, capability resolution, and external tool install/update/doctor flows.\"\n    )\n    subparsers = parser.add_subparsers(dest=\"command\", required=True)\n\n    def add_common_runtime_args(command: argparse.ArgumentParser) -> None:\n        command.add_argument(\"--home-root\", type=Path, default=default_home_root())\n        command.add_argument(\n            \"--repo-root\",\n            type=Path,\n            help=\"Use an explicit existing source checkout instead of the managed default checkout.\",\n        )\n        command.add_argument(\n            \"--target-repo-root\",\n            type=Path,\n            help=(\n                \"Optional repo to inspect for post-install charness onboarding. \"\n                \"Defaults to the current working directory for init/doctor; update inspects only when this is explicit.\"\n            ),\n        )\n        command.add_argument(\"--repo-url\", default=REPO_URL)\n        command.add_argument(\"--plugin-root\", type=Path)\n        command.add_argument(\n            \"--codex-marketplace-path\",\n            type=Path,\n        )\n        command.add_argument(\n            \"--claude-wrapper-path\",\n            type=Path,\n        )\n        command.add_argument(\"--cli-path\", type=Path)\n        command.add_argument(\"--skip-cli-install\", action=\"store_true\")\n        command.add_argument(\"--skip-claude-wrapper\", action=\"store_true\")\n\n    def add_detail_output_arg(command: argparse.ArgumentParser) -> None:\n        command.add_argument(\n            \"--detail\",\n            action=\"store_true\",\n            help=\"Emit the full diagnostic YAML payload instead of the default compact operational summary.\",\n        )\n\n    init_parser = subparsers.add_parser(\n        \"init\",\n        help=\"Bootstrap or refresh the managed local install surface, cloning the managed checkout first when it is missing.\",\n    )\n    add_common_runtime_args(init_parser)\n    add_detail_output_arg(init_parser)\n    init_parser.set_defaults(func=cmd_init)\n\n    update_parser = subparsers.add_parser(\n        \"update\",\n        help=\"Refresh the installed surface, pulling the managed checkout first by default.\",\n    )\n    add_common_runtime_args(update_parser)\n    add_detail_output_arg(update_parser)\n    update_parser.add_argument(\n        \"--no-pull\",\n        action=\"store_true\",\n        help=\"Skip the default `git pull --ff-only` when the managed checkout already contains the exact source you want.\",\n    )\n    update_parser.add_argument(\n        \"--skip-codex-cache-refresh\",\n        action=\"store_true\",\n        help=\"Do not call Codex app-server `plugin/install` to refresh the enabled local plugin cache after updating the source plugin root.\",\n    )\n    update_parser.add_argument(\n        \"scope\",\n        nargs=\"?\",\n        choices=[\"all\"],\n        help=\"Also run `charness tool update` for all tracked external integrations after refreshing the charness install surface itself.\",\n    )\n    update_parser.set_defaults(func=cmd_update)\n\n    doctor_parser = subparsers.add_parser(\n        \"doctor\", help=\"Inspect the managed install surface and host-facing wrappers.\"\n    )\n    doctor_parser.add_argument(\"--home-root\", type=Path, default=default_home_root())\n    doctor_parser.add_argument(\n        \"--repo-root\",\n        type=Path,\n        help=\"Inspect an explicit source checkout instead of the managed default checkout.\",\n    )\n    doctor_parser.add_argument(\n        \"--target-repo-root\",\n        type=Path,\n        help=\"Optional repo to inspect for charness onboarding. Defaults to the current working directory.\",\n    )\n    doctor_parser.add_argument(\"--plugin-root\", type=Path)\n    doctor_parser.add_argument(\n        \"--codex-marketplace-path\",\n        type=Path,\n    )\n    doctor_parser.add_argument(\n        \"--claude-wrapper-path\",\n        type=Path,\n    )\n    doctor_parser.add_argument(\"--cli-path\", type=Path)\n    doctor_output_parser = doctor_parser.add_mutually_exclusive_group()\n    doctor_output_parser.add_argument(\n        \"--next-action\",\n        action=\"store_true\",\n        help=\"Print only the current primary next action message.\",\n    )\n    doctor_parser.add_argument(\n        \"--write-state\",\n        action=\"store_true\",\n        help=\"Persist the current doctor snapshot to the machine-local charness state directory for later proof comparison.\",\n    )\n    doctor_output_parser.add_argument(\n        \"--detail\",\n        action=\"store_true\",\n        help=\"Emit the full diagnostic YAML payload instead of the default compact operational summary.\",\n    )\n    doctor_parser.set_defaults(func=cmd_doctor)\n\n    version_parser = subparsers.add_parser(\n        \"version\", help=\"Report the current charness version and recorded install provenance.\"\n    )\n    version_parser.add_argument(\"--home-root\", type=Path, default=default_home_root())\n    version_parser.add_argument(\n        \"--repo-root\",\n        type=Path,\n        help=\"Inspect an explicit source checkout instead of the managed default checkout.\",\n    )\n    version_parser.add_argument(\"--cli-path\", type=Path)\n    version_parser.add_argument(\"--verbose\", action=\"store_true\")\n    version_parser.add_argument(\n        \"--check\",\n        action=\"store_true\",\n        help=\"Refresh the cached latest-release check now instead of only showing recorded state.\",\n    )\n    version_parser.set_defaults(func=cmd_version)\n\n    uninstall_parser = subparsers.add_parser(\n        \"uninstall\", help=\"Remove the managed local install surface.\"\n    )\n    uninstall_parser.add_argument(\"--home-root\", type=Path, default=default_home_root())\n    uninstall_parser.add_argument(\n        \"--repo-root\",\n        type=Path,\n        help=\"Use an explicit checkout path when `--delete-checkout` is set.\",\n    )\n    uninstall_parser.add_argument(\"--plugin-root\", type=Path)\n    uninstall_parser.add_argument(\n        \"--codex-marketplace-path\",\n        type=Path,\n    )\n    uninstall_parser.add_argument(\n        \"--claude-wrapper-path\",\n        type=Path,\n    )\n    uninstall_parser.add_argument(\"--cli-path\", type=Path)\n    uninstall_parser.add_argument(\"--delete-checkout\", action=\"store_true\")\n    uninstall_parser.add_argument(\"--delete-cli\", action=\"store_true\")\n    uninstall_parser.set_defaults(func=cmd_uninstall)\n\n    reset_parser = subparsers.add_parser(\n        \"reset\",\n        help=\"Remove host plugin state for Codex and Claude while preserving the managed checkout and CLI.\",\n    )\n    reset_parser.add_argument(\"--home-root\", type=Path, default=default_home_root())\n    reset_parser.add_argument(\n        \"--repo-root\",\n        type=Path,\n        help=\"Use an explicit checkout path when removing host plugin state.\",\n    )\n    reset_parser.add_argument(\"--plugin-root\", type=Path)\n    reset_parser.add_argument(\n        \"--codex-marketplace-path\",\n        type=Path,\n    )\n    reset_parser.add_argument(\n        \"--claude-wrapper-path\",\n        type=Path,\n    )\n    reset_parser.add_argument(\"--cli-path\", type=Path)\n    reset_parser.set_defaults(func=cmd_reset)\n\n    task_parser = subparsers.add_parser(\"task\", help=\"Run or inspect a bounded task lane.\")\n    task_subparsers = task_parser.add_subparsers(dest=\"task_command\", required=True)\n\n    task_status_parser = task_subparsers.add_parser(\n        \"status\",\n        help=\"Show one external task-run result, or list all task-run results.\",\n    )\n    task_status_parser.add_argument(\n        \"--repo-root\",\n        type=Path,\n        default=Path.cwd(),\n        help=\"Parent repo whose external task-run runtime is read.\",\n    )\n    task_status_parser.add_argument(\n        \"--all-repos\",\n        action=\"store_true\",\n        help=\"Report the compact running-task inventory across this repo's managed runtime tree.\",\n    )\n    task_status_parser.add_argument(\n        \"--commands\",\n        action=\"store_true\",\n        help=\"With a task id, report that lane's longest commands, starts per command \"\n        \"family, and phase times from its receive-time-stamped events log.\",\n    )\n    task_status_parser.add_argument(\"task_id\", nargs=\"?\")\n    task_status_parser.set_defaults(func=cmd_task_status)\n\n    task_report_parser = task_subparsers.add_parser(\n        \"report\",\n        help=\"Render the fixed-shape periodic status report from lane metrics, \"\n        \"the friction log, and the decision ledger.\",\n    )\n    task_report_parser.add_argument(\n        \"--repo-root\",\n        type=Path,\n        default=Path.cwd(),\n        help=\"Parent repo whose external task-run runtime is read.\",\n    )\n    task_report_parser.add_argument(\n        \"--window\",\n        default=\"30m\",\n        help=\"Trailing window for the period (30m, 3h, 1d, or bare hours).\",\n    )\n    task_report_parser.set_defaults(func=cmd_task_report)\n\n    task_executors_parser = task_subparsers.add_parser(\n        \"executors\",\n        help=\"Check executor executable availability without starting a lane.\",\n        description=(\n            \"Resolve the configured executor executables without launching them. \"\n            \"Provider quota remains unknown until an executor reports a usage limit.\"\n        ),\n    )\n    task_executors_parser.add_argument(\n        \"--repo-root\",\n        type=Path,\n        default=Path.cwd(),\n        help=\"Repo whose task-run environment is selected. Defaults to the current directory.\",\n    )\n    task_executors_parser.set_defaults(func=cmd_task_executors)\n\n    task_steer_parser = task_subparsers.add_parser(\n        \"steer\",\n        help=\"Queue a message for a running lane or amend its retained candidate scope.\",\n    )\n    task_steer_parser.add_argument(\n        \"--repo-root\",\n        type=Path,\n        default=Path.cwd(),\n        help=\"Parent repo whose external task-run runtime is read.\",\n    )\n    task_steer_parser.add_argument(\"task_id\")\n    task_steer_action = task_steer_parser.add_mutually_exclusive_group(required=True)\n    task_steer_action.add_argument(\n        \"--message\", help=\"Message to deliver at the next executor turn boundary.\"\n    )\n    task_steer_action.add_argument(\n        \"--amend-scope\",\n        action=\"append\",\n        help=\"Approve an additional scope and revalidate the same retained candidate; repeatable.\",\n    )\n    task_steer_parser.add_argument(\n        \"--reason\",\n        default=None,\n        help=\"Why this steer/amendment is issued; recorded as the envelope `reason` audit field.\",\n    )\n    task_steer_parser.add_argument(\n        \"--actor\",\n        default=None,\n        help=\"Who issues this steer/amendment; recorded as the envelope `actor` audit field.\",\n    )\n    task_steer_parser.set_defaults(func=cmd_task_steer)\n\n    task_run_parser = task_subparsers.add_parser(\n        \"run\",\n        help=\"Run one independently delegable lane in a clean named worktree and emit a compact receipt.\",\n        description=(\n            \"Run one independently delegable lane: shorthand derives a named branch, external \"\n            \"worktree, task id, and HEAD base; the explicit form remains available for diagnostics. \"\n            \"The parent worktree must be clean; the parent orchestrator owns parallel fan-out and integration.\\n\\n\"\n            \"Exit codes:\\n\"\n            \"  0 success\\n\"\n            \"  1 failed\\n\"\n            \"  2 premise-blocked\\n\"\n            \"  3 validated-partial\\n\"\n            \"  4 executor-unavailable\\n\"\n            \"  5 completed-needs-review\"\n        ),\n        formatter_class=argparse.RawDescriptionHelpFormatter,\n    )\n    task_run_parser.add_argument(\n        \"--repo-root\",\n        type=Path,\n        default=Path.cwd(),\n        help=\"Clean parent repo from which the linked worktree is created. Defaults to the current working directory.\",\n    )\n    task_run_parser.add_argument(\n        \"--lane\",\n        help=\"Safe lane id; derives the task id, task/<id> branch, and external worktree (HEAD base unless --base is given).\",\n    )\n    task_run_parser.add_argument(\n        \"--path\",\n        type=Path,\n        help=\"New linked worktree path outside the parent repo (explicit form).\",\n    )\n    task_run_parser.add_argument(\n        \"--branch\", help=\"Named local branch for the new worktree (explicit form).\"\n    )\n    task_run_parser.add_argument(\n        \"--base\",\n        help=\"Commit/ref the new worktree starts from (required with --path/--branch; overrides the lane HEAD base with --lane).\",\n    )\n    task_run_parser.add_argument(\n        \"--scope\",\n        action=\"append\",\n        required=True,\n        help=\"Repository-relative candidate path or quoted glob; repeatable, and a `{a,b}` group expands to one scope per alternative. Existing directories include descendants; a path absent from the base is an exact file, so enumerate planned files in a new directory. A glob that matches nothing warns and admits lane-created matching paths on refresh.\",\n    )\n    task_run_prompt = task_run_parser.add_mutually_exclusive_group(required=True)\n    task_run_prompt.add_argument(\n        \"--prompt\", help=\"Implementation instructions passed to the lane executor.\"\n    )\n    task_run_prompt.add_argument(\n        \"--prompt-file\", type=Path, help=\"Read implementation instructions from this file.\"\n    )\n    task_run_parser.add_argument(\n        \"--executor\",\n        default=\"codex\",\n        help=\"Ordered lane executors, comma-separated (for example codex,muse); usage-limit failures fall through in order. Default: codex. Effort must fit every listed executor.\",\n    )\n    task_run_parser.add_argument(\n        \"--effort\",\n        required=True,\n        help=\"Orchestrator-selected reasoning effort: medium, xhigh, or max for codex; medium, high, xhigh, or max for muse.\",\n    )\n    task_run_parser.add_argument(\n        \"--task-id\",\n        help=\"Optional receipt/log identifier for explicit runs; shorthand derives it from --lane.\",\n    )\n    task_run_parser.add_argument(\n        \"--prepare\",\n        action=\"store_true\",\n        default=None,\n        help=\"Run the worktree adapter prepare step before the lane executor.\",\n    )\n    task_run_parser.add_argument(\n        \"--require-change\",\n        action=\"store_true\",\n        default=None,\n        help=\"Fail unless the candidate changes at least one path.\",\n    )\n    task_run_parser.add_argument(\n        \"--skip-prepare\",\n        action=\"store_true\",\n        help=\"Shorthand diagnostic opt-out: skip the default preparation step.\",\n    )\n    task_run_parser.add_argument(\n        \"--allow-no-change\",\n        action=\"store_true\",\n        help=\"Shorthand diagnostic opt-out: allow an unchanged candidate.\",\n    )\n    task_run_parser.add_argument(\n        \"--report-only\",\n        action=\"store_true\",\n        help=\"Report-only lane: force require-change off, treat the delivered stdout report as the terminal artifact, and never classify parent progress as a writer conflict. Cannot be combined with --require-change.\",\n    )\n    task_run_parser.add_argument(\n        \"--self-review\",\n        dest=\"self_review_policy\",\n        action=\"store_const\",\n        const=\"always\",\n        default=\"never\",\n        help=\"Run an explicit read-only self-review pass; findings do not provide approval.\",\n    )\n    task_run_parser.add_argument(\n        \"--critical-lane\",\n        action=\"store_true\",\n        help=\"Require a committed failing acceptance skeleton before launch and green at completion.\",\n    )\n    task_run_parser.add_argument(\n        \"--acceptance-skeleton\",\n        help=\"Repository-relative pytest file that must fail before launch and pass before completion.\",\n    )\n    task_run_parser.add_argument(\n        \"--premise-check\",\n        action=\"append\",\n        nargs=3,\n        default=[],\n        metavar=(\"ID\", \"PREMISE\", \"DECISION\"),\n        help=\"Premise to check before launch and the decision a BLOCKED result needs; repeatable.\",\n    )\n    task_run_parser.add_argument(\n        \"--timeout-seconds\",\n        type=int,\n        default=None,\n        help=(\n            \"Optional hard wall-clock cap per executor attempt; none by default. A lane \"\n            \"is bounded by progress instead: CHARNESS_TASK_RUN_PROGRESS_WINDOW_SECONDS \"\n            \"(default 1200) asks for a checkpoint after a window with no commit, file \"\n            \"change, or new command result and stops the lane after a second one.\"\n        ),\n    )\n    task_run_parser.add_argument(\n        \"--no-progress-seconds\",\n        type=float,\n        default=None,\n        help=\"First-edit budget for require-change lanes: seconds from CONTRACT-READ to the first EDITING or scoped diff; 0 turns this stop off. Overrides CHARNESS_TASK_RUN_NO_PROGRESS_SECONDS and is recorded in progress_guard. Separate from the progress window.\",\n    )\n    task_run_parser.add_argument(\n        \"--dry-run\",\n        action=\"store_true\",\n        help=\"Validate inputs and show the planned lane without creating or running it.\",\n    )\n    task_run_parser.add_argument(\n        \"--rules-file\",\n        action=\"append\",\n        type=Path,\n        default=[],\n        help=\"Standing-rule file the lane executor must read by reference; repeatable. \"\n        \"Listed by absolute path in the lane prompt, never inlined, and never read by scope evidence.\",\n    )\n    task_run_parser.add_argument(\n        \"--grant-writable\",\n        action=\"append\",\n        type=Path,\n        default=[],\n        help=\"Absolute host-state directory a codex lane may write (mapped to codex --add-dir); \"\n        \"repeatable. Refused for muse lanes and for grants covering the repo root, $HOME, or /.\",\n    )\n    task_run_parser.add_argument(\n        \"--detach\",\n        action=\"store_true\",\n        help=\"Launch the lane detached and return once its carrier has started \"\n        \"(exit 0, printing the task id and result path), or with the task-run exit code \"\n        \"of a preflight or launch failure. Never returns 0 for a lane that did not start. \"\n        \"Cannot be combined with --dry-run.\",\n    )\n    task_run_parser.add_argument(\n        \"--home-root\", type=Path, default=default_home_root(), help=argparse.SUPPRESS\n    )\n    task_run_parser.add_argument(\"--charness-checkout\", type=Path, help=argparse.SUPPRESS)\n    task_run_parser.set_defaults(func=cmd_task_run)\n\n    task_wait_parser = task_subparsers.add_parser(\n        \"wait\",\n        help=\"Block until named lanes reach a terminal status.\",\n        description=(\n            \"Block until all (or with --any, the first) of the named lanes reach a \"\n            \"terminal status; print task_id and status for each finished lane. Exit \"\n            \"with the finished lane's task-run exit code (0 success, 1 failed, \"\n            \"2 premise-blocked, 3 validated-partial, 4 executor-unavailable, \"\n            \"5 completed-needs-review); with several lanes, the first non-success \"\n            \"in CLI order decides. An already-terminal lane returns immediately.\"\n        ),\n        formatter_class=argparse.RawDescriptionHelpFormatter,\n    )\n    task_wait_parser.add_argument(\n        \"--repo-root\",\n        type=Path,\n        default=Path.cwd(),\n        help=\"Parent repo whose external task-run runtime is read.\",\n    )\n    task_wait_parser.add_argument(\"task_ids\", nargs=\"+\", help=\"Lane task ids to wait for.\")\n    task_wait_parser.add_argument(\n        \"--any\",\n        action=\"store_true\",\n        help=\"Return when the first named lane ends; the others keep running.\",\n    )\n    task_wait_parser.add_argument(\n        \"--timeout-seconds\",\n        type=float,\n        default=0,\n        help=\"Bound the wait in seconds; 0 waits indefinitely.\",\n    )\n    task_wait_parser.set_defaults(func=cmd_task_wait)\n\n    hooks_parser = subparsers.add_parser(\n        \"hooks\",\n        help=\"Inspect host hook intents.\",\n    )\n    hooks_subparsers = hooks_parser.add_subparsers(dest=\"hooks_command\", required=True)\n    hooks_status_parser = hooks_subparsers.add_parser(\n        \"status\",\n        help=\"Report every host-hook intent per host.\",\n        description=(\n            \"Report every host-hook intent (the skill-anchor edit guard and \"\n            \"the three command-time orchestration guards) per host: declared \"\n            \"intent, installed actual, and whether they agree. Exit 0 when \"\n            \"every intent is in sync, 1 otherwise.\"\n        ),\n        formatter_class=argparse.RawDescriptionHelpFormatter,\n    )\n    hooks_status_parser.add_argument(\n        \"--repo-root\",\n        type=Path,\n        default=Path.cwd(),\n        help=\"Repo whose hook state is read. Defaults to the current directory.\",\n    )\n    hooks_status_parser.add_argument(\n        \"--adapter-file\",\n        type=Path,\n        default=None,\n        help=\"Adapter YAML declaring host-hook intents; absent means every intent disabled.\",\n    )\n    hooks_status_parser.add_argument(\n        \"--home-root\", type=Path, default=default_home_root(), help=argparse.SUPPRESS\n    )\n    hooks_status_parser.add_argument(\"--charness-checkout\", type=Path, help=argparse.SUPPRESS)\n    hooks_status_parser.set_defaults(func=cmd_hooks_status)\n\n    train_parser = subparsers.add_parser(\n        \"train\",\n        help=\"Stack, verify, and fast-forward an explicit queue of local lane branches.\",\n    )\n    train_parser.add_argument(\n        \"--repo-root\",\n        type=Path,\n        default=Path.cwd(),\n        help=\"Repository whose local main branch and lane branches are integrated.\",\n    )\n    train_parser.add_argument(\n        \"--main\",\n        default=\"main\",\n        help=\"Local branch to guard and fast-forward (default: main).\",\n    )\n    train_parser.add_argument(\n        \"--profile\",\n        type=Path,\n        help=\"Optional verify profile; defaults to .agents/train-verify.yaml or built-in standing pytest.\",\n    )\n    train_parser.add_argument(\n        \"branches\",\n        nargs=\"*\",\n        help=\"Local lane branches in queue order (empty with --stats).\",\n    )\n    train_parser.add_argument(\n        \"--stats\",\n        action=\"store_true\",\n        help=\"Report train throughput (landings, queue wait, waste) instead of landing.\",\n    )\n    train_parser.add_argument(\n        \"--window\",\n        default=\"3h\",\n        help=\"Trailing window for --stats (like 30m, 3h, 1d; default: 3h).\",\n    )\n    train_parser.set_defaults(func=cmd_train)\n\n    catalog_parser = subparsers.add_parser(\n        \"catalog\",\n        help=\"Inspect capability inventory, packaged consumer-validator adoption, or stale skill paths.\",\n    )\n    catalog_subparsers = catalog_parser.add_subparsers(dest=\"catalog_command\", required=True)\n\n    catalog_list_parser = catalog_subparsers.add_parser(\n        \"list\",\n        help=\"Read capability and packaged consumer-validator inventory without writing artifacts.\",\n    )\n    catalog_list_parser.add_argument(\"--repo-root\", type=Path, required=True)\n    catalog_list_parser.add_argument(\n        \"--summary\",\n        action=\"store_true\",\n        help=\"Project support/integration inventory while retaining the validator catalog contract.\",\n    )\n    catalog_list_parser.set_defaults(func=cmd_catalog_list)\n\n    catalog_refresh_parser = catalog_subparsers.add_parser(\n        \"refresh\", help=\"Write the canonical capability catalog current-pointer artifacts.\"\n    )\n    catalog_refresh_parser.add_argument(\"--repo-root\", type=Path, required=True)\n    catalog_refresh_parser.set_defaults(func=cmd_catalog_refresh)\n\n    catalog_resolve_parser = catalog_subparsers.add_parser(\n        \"resolve-skill-path\",\n        help=\"Resolve a stale host-reported skill path after plugin cache rotation.\",\n    )\n    catalog_resolve_parser.add_argument(\"--repo-root\", type=Path, required=True)\n    catalog_resolve_parser.add_argument(\"--skill-id\", required=True)\n    catalog_resolve_parser.add_argument(\"--reported-path\", type=Path, required=True)\n    catalog_resolve_parser.add_argument(\"--home\", type=Path, default=Path.home())\n    catalog_resolve_parser.add_argument(\n        \"--codex-home\",\n        type=Path,\n        default=Path(os.environ.get(\"CODEX_HOME\", Path.home() / \".codex\")),\n    )\n    catalog_resolve_parser.add_argument(\"--marketplace\", default=\"local\")\n    catalog_resolve_parser.add_argument(\"--plugin\", default=\"charness\")\n    catalog_resolve_parser.set_defaults(func=cmd_catalog_resolve_skill_path)\n\n    capability_parser = subparsers.add_parser(\n        \"capability\",\n        help=\"Resolve repo-local logical capabilities through `<repo-root>/.charness/local/capability.json` and inspect provider readiness.\",\n    )\n    capability_subparsers = capability_parser.add_subparsers(\n        dest=\"capability_command\", required=True\n    )\n\n    def add_common_capability_args(command: argparse.ArgumentParser) -> None:\n        command.add_argument(\n            \"--repo-root\",\n            type=Path,\n            help=\"Use an explicit charness source checkout instead of the managed default checkout.\",\n        )\n        command.add_argument(\"--repo-url\", default=REPO_URL)\n        command.add_argument(\n            \"--target-repo-root\",\n            type=Path,\n            help=\"Resolve repo-local capability config for this target repo. Defaults to the current working directory.\",\n        )\n        command.add_argument(\"logical_id\")\n\n    capability_init_parser = capability_subparsers.add_parser(\n        \"init\",\n        help=\"Scaffold repo-local capability config (`.charness/local/capability.json` + `.charness/capability.example.json`) and update `.gitignore`.\",\n    )\n    capability_init_parser.add_argument(\n        \"--target-repo-root\",\n        type=Path,\n        help=\"Scaffold capability config under this target repo. Defaults to the current working directory.\",\n    )\n    capability_init_parser.add_argument(\"--force\", action=\"store_true\")\n    capability_init_parser.set_defaults(func=cmd_capability_init)\n\n    capability_resolve_parser = capability_subparsers.add_parser(\n        \"resolve\",\n        help=\"Resolve one logical capability for the current repo into a profile and provider.\",\n    )\n    add_common_capability_args(capability_resolve_parser)\n    capability_resolve_parser.set_defaults(func=cmd_capability_resolve)\n\n    capability_doctor_parser = capability_subparsers.add_parser(\n        \"doctor\",\n        help=\"Resolve one logical capability and inspect the underlying provider state.\",\n    )\n    add_common_capability_args(capability_doctor_parser)\n    capability_doctor_parser.set_defaults(func=cmd_capability_doctor)\n\n    capability_env_parser = capability_subparsers.add_parser(\n        \"env\",\n        help=\"Emit shell exports that alias runtime env names from non-secret source env names declared in the repo-local capability config.\",\n    )\n    add_common_capability_args(capability_env_parser)\n    capability_env_parser.set_defaults(func=cmd_capability_env)\n\n    capability_explain_parser = capability_subparsers.add_parser(\n        \"explain\",\n        help=\"Explain which logical capabilities a public skill may need and what the current repo adapter adds.\",\n    )\n    capability_explain_parser.add_argument(\n        \"--repo-root\",\n        type=Path,\n        help=\"Use an explicit charness source checkout instead of the managed default checkout.\",\n    )\n    capability_explain_parser.add_argument(\"--repo-url\", default=REPO_URL)\n    capability_explain_parser.add_argument(\n        \"--target-repo-root\",\n        type=Path,\n        help=\"Inspect repo-local adapter context for this target repo. Defaults to the current working directory.\",\n    )\n    capability_explain_parser.add_argument(\"skill_id\")\n    capability_explain_parser.set_defaults(func=cmd_capability_explain)\n\n    goal_parser = subparsers.add_parser(\n        \"goal\",\n        help=\"Inspect and resume issue-native Goal Runs without local goal-file state.\",\n    )\n    goal_subparsers = goal_parser.add_subparsers(dest=\"goal_command\", required=True)\n\n    goal_run_parser = goal_subparsers.add_parser(\n        \"run\",\n        help=\"Read a provider-backed Goal Run and select its next executable child; no local artifact path is accepted.\",\n        description=\"Resume a provider-backed Goal Run; no local artifact path is accepted.\",\n    )\n    goal_run_parser.add_argument(\n        \"--repo-root\",\n        type=Path,\n        help=\"Target repository containing the Goal Run. Defaults to the current working directory.\",\n    )\n    goal_run_parser.add_argument(\n        \"--objective\",\n        required=True,\n        help=\"Exact issue-native objective, for example `/goal #N`.\",\n    )\n    goal_run_parser.add_argument(\"--home-root\", type=Path, default=default_home_root())\n    goal_run_parser.add_argument(\"--repo-url\", default=REPO_URL)\n    goal_run_parser.add_argument(\n        \"--charness-checkout\",\n        type=Path,\n        help=\"Explicit Charness source checkout containing the current Goal Run pickup helper. Defaults to this CLI checkout or the managed checkout.\",\n    )\n    goal_run_parser.set_defaults(func=cmd_goal_run)\n\n    tool_parser = subparsers.add_parser(\n        \"tool\",\n        help=\"Inspect, install, update, or sync external tool integrations that charness-managed skills depend on.\",\n    )\n    tool_subparsers = tool_parser.add_subparsers(dest=\"tool_command\", required=True)\n\n    def add_common_tool_args(command: argparse.ArgumentParser) -> None:\n        command.add_argument(\"--home-root\", type=Path, default=default_home_root())\n        command.add_argument(\n            \"--repo-root\",\n            type=Path,\n            help=\"Use an explicit existing source checkout instead of the managed default checkout.\",\n        )\n        command.add_argument(\"--repo-url\", default=REPO_URL)\n        command.add_argument(\n            \"--plugin-root\",\n            type=Path,\n            help=\"Installed plugin root where upstream support skills are materialized.\",\n        )\n        add_detail_output_arg(command)\n        command.add_argument(\"tool_ids\", nargs=\"*\")\n\n    def add_support_sync_args(command: argparse.ArgumentParser) -> None:\n        command.add_argument(\"--upstream-checkout\", action=\"append\", default=[])\n\n    tool_doctor_parser = tool_subparsers.add_parser(\n        \"doctor\",\n        help=\"Write machine-readable doctor state for one or more external tools.\",\n    )\n    add_common_tool_args(tool_doctor_parser)\n    tool_doctor_parser.add_argument(\n        \"--no-write-locks\",\n        action=\"store_true\",\n        help=\"Skip updating integrations/locks/*.json when you only want a read-only probe.\",\n    )\n    tool_doctor_parser.set_defaults(func=cmd_tool_doctor)\n\n    tool_repair_parser = tool_subparsers.add_parser(\n        \"repair\",\n        help=\"Run post-hoc repair actions for external tool runtime drift, then refresh doctor state.\",\n        description=(\n            \"Run repo-owned post-hoc repair actions for external tool runtime drift, \"\n            \"then refresh doctor state. For agent-browser this is mitigation only; \"\n            \"invocation-bound Chrome/profile teardown remains upstream/unproven.\"\n        ),\n    )\n    add_common_tool_args(tool_repair_parser)\n    tool_repair_parser.add_argument(\n        \"--execute\",\n        action=\"store_true\",\n        help=\"Execute the repair. Defaults to a dry-run preview.\",\n    )\n    tool_repair_parser.set_defaults(func=cmd_tool_repair)\n\n    tool_sync_support_parser = tool_subparsers.add_parser(\n        \"sync-support\",\n        help=\"Refresh cache-backed support skill materialization for one or more external tools.\",\n    )\n    add_common_tool_args(tool_sync_support_parser)\n    add_support_sync_args(tool_sync_support_parser)\n    tool_sync_support_parser.add_argument(\"--dry-run\", action=\"store_true\")\n    tool_sync_support_parser.set_defaults(func=cmd_tool_sync_support)\n\n    tool_install_parser = tool_subparsers.add_parser(\n        \"install\",\n        help=\"Attempt tool installation where the manifest allows it, otherwise persist install guidance and doctor state.\",\n    )\n    add_common_tool_args(tool_install_parser)\n    add_support_sync_args(tool_install_parser)\n    tool_install_parser.add_argument(\"--dry-run\", action=\"store_true\")\n    tool_install_parser.add_argument(\n        \"--skip-sync-support\",\n        action=\"store_true\",\n        help=\"Skip support skill rematerialization after install guidance or execution.\",\n    )\n    tool_install_parser.add_argument(\n        \"--recommend-for-skill\",\n        help=\"Install tools declared as supporting a public skill instead of passing explicit tool ids.\",\n    )\n    tool_install_parser.add_argument(\n        \"--recommendation-role\",\n        choices=(\"runtime\", \"validation\"),\n        help=\"Install tools with a recommendation role, optionally scoped by --next-skill-id.\",\n    )\n    tool_install_parser.add_argument(\n        \"--next-skill-id\",\n        default=\"quality\",\n        help=\"Public skill id used with --recommendation-role; defaults to quality.\",\n    )\n    tool_install_parser.set_defaults(func=cmd_tool_install)\n\n    tool_update_parser = tool_subparsers.add_parser(\n        \"update\",\n        help=\"Attempt manifest-declared external tool updates, then refresh support skill materialization and doctor state.\",\n    )\n    add_common_tool_args(tool_update_parser)\n    add_support_sync_args(tool_update_parser)\n    tool_update_parser.add_argument(\"--dry-run\", action=\"store_true\")\n    tool_update_parser.add_argument(\n        \"--skip-sync-support\",\n        action=\"store_true\",\n        help=\"Skip support skill rematerialization after update.\",\n    )\n    tool_update_parser.set_defaults(func=cmd_tool_update)\n\n    worktree_parser = subparsers.add_parser(\n        \"worktree\",\n        help=\"Create, inspect, prepare, and clean up git worktrees so mutate-phase work runs against installed dependencies and live hooks.\",\n    )\n    worktree_subparsers = worktree_parser.add_subparsers(dest=\"worktree_command\", required=True)\n\n    def add_worktree_lib_args(command: argparse.ArgumentParser) -> None:\n        command.add_argument(\n            \"--home-root\",\n            type=Path,\n            default=default_home_root(),\n            help=\"Home root used to locate the managed charness checkout when the entrypoint is a PATH shim.\",\n        )\n        command.add_argument(\n            \"--charness-checkout\",\n            type=Path,\n            help=\"Explicit charness source checkout to load worktree helpers from. Defaults to the embedded or managed checkout.\",\n        )\n\n    def add_worktree_create_parser(command_name: str, *, help_text: str) -> None:\n        command = worktree_subparsers.add_parser(command_name, help=help_text)\n        command.add_argument(\n            \"--repo-root\",\n            type=Path,\n            help=\"Repo root that the worktree should be created under. Defaults to the current working directory.\",\n        )\n        command.add_argument(\n            \"--path\", type=Path, required=True, help=\"Path for the new git worktree.\"\n        )\n        command.add_argument(\"--branch\", help=\"Create a new local branch for the worktree.\")\n        command.add_argument(\"--base\", help=\"Base ref passed to `git worktree add` after the path.\")\n        command.add_argument(\n            \"--detach\", action=\"store_true\", help=\"Create a detached-HEAD worktree.\"\n        )\n        command.add_argument(\n            \"--prepare\", action=\"store_true\", help=\"Run readiness prepare after creation.\"\n        )\n        command.add_argument(\n            \"--dry-run\",\n            action=\"store_true\",\n            help=\"Print the planned git command without creating the worktree.\",\n        )\n        command.add_argument(\n            \"--force\", action=\"store_true\", help=\"Pass --force to `git worktree add`.\"\n        )\n        lifetime = command.add_mutually_exclusive_group()\n        lifetime.add_argument(\n            \"--ephemeral\",\n            action=\"store_true\",\n            help=\"Mark the worktree disposable: create reclaims expired leftovers and caps residue.\",\n        )\n        lifetime.add_argument(\n            \"--owned\",\n            action=\"store_true\",\n            help=\"Keep the worktree until `charness worktree cleanup`; never auto-removed.\",\n        )\n        add_worktree_lib_args(command)\n        command.set_defaults(func=cmd_worktree_create)\n\n    add_worktree_create_parser(\n        \"create\",\n        help_text=\"Create a git worktree, then run readiness doctor and optional prepare.\",\n    )\n    add_worktree_create_parser(\n        \"add\",\n        help_text=\"Alias for `create`: wrap `git worktree add` with readiness doctor and optional prepare.\",\n    )\n\n    worktree_exec_parser = worktree_subparsers.add_parser(\n        \"exec\",\n        help=\"Run one command in an isolated worktree with external runtime caches.\",\n        description=\"Run one command in an isolated worktree with external runtime caches.\",\n    )\n    worktree_exec_parser.add_argument(\n        \"--repo-root\",\n        type=Path,\n        help=\"Worktree in which to run the command. Defaults to the current working directory.\",\n    )\n    worktree_exec_parser.add_argument(\n        \"--allow-main\",\n        action=\"store_true\",\n        help=\"Allow an intentional command in the primary worktree; parent writes are then possible.\",\n    )\n    worktree_exec_parser.add_argument(\n        \"command\", nargs=argparse.REMAINDER, help=\"Command after `--`.\"\n    )\n    add_worktree_lib_args(worktree_exec_parser)\n    worktree_exec_parser.set_defaults(func=cmd_worktree_exec)\n\n    worktree_doctor_parser = worktree_subparsers.add_parser(\n        \"doctor\",\n        help=\"Probe worktree readiness (isolation, hooksPath, lefthook shim resolution, husky directory, manifest checks).\",\n    )\n    worktree_doctor_parser.add_argument(\n        \"--repo-root\",\n        type=Path,\n        help=\"Worktree to inspect. Defaults to the current working directory.\",\n    )\n    worktree_doctor_parser.add_argument(\n        \"--require-isolation\",\n        action=\"store_true\",\n        help=(\n            \"Fail unless this checkout is a linked worktree rather than the main one. Pass it \"\n            \"before handing a WRITE-CAPABLE agent a checkout: without isolation that agent \"\n            \"shares the parent's tree and index, and a stray git op lands in the parent's \"\n            \"commit. Without the flag, isolation is reported as a fact and never enforced.\"\n        ),\n    )\n    add_worktree_lib_args(worktree_doctor_parser)\n    worktree_doctor_parser.set_defaults(func=cmd_worktree_doctor)\n\n    worktree_prepare_parser = worktree_subparsers.add_parser(\n        \"prepare\",\n        help=\"Run the worktree adapter's prepare commands and re-validate readiness.\",\n    )\n    worktree_prepare_parser.add_argument(\n        \"--repo-root\",\n        type=Path,\n        help=\"Worktree to prepare. Defaults to the current working directory.\",\n    )\n    worktree_prepare_parser.add_argument(\n        \"--force\",\n        action=\"store_true\",\n        help=\"Run prepare even if doctor already reports pass.\",\n    )\n    worktree_prepare_parser.add_argument(\n        \"--no-dependency-reuse\",\n        action=\"store_true\",\n        help=\"Do not link an installed dependency tree; the declared install command runs unless doctor coverage skips prepare (add --force to override that).\",\n    )\n    add_worktree_lib_args(worktree_prepare_parser)\n    worktree_prepare_parser.set_defaults(func=cmd_worktree_prepare)\n\n    worktree_audit_parser = worktree_subparsers.add_parser(\n        \"audit\",\n        help=\"Survey all worktrees registered to the repository and classify primary/active/prunable/stale.\",\n    )\n    worktree_audit_parser.add_argument(\n        \"--repo-root\",\n        type=Path,\n        help=\"Repo root whose worktree registry should be audited. Defaults to the current working directory.\",\n    )\n    worktree_audit_parser.add_argument(\n        \"--stale-days\",\n        type=int,\n        default=14,\n        help=\"Detached-HEAD worktrees older than this many days are reported as stale (default: 14).\",\n    )\n    worktree_audit_parser.add_argument(\n        \"--prune\",\n        action=\"store_true\",\n        help=\"After audit, reclaim expired ephemeral worktrees and prune metadata for missing ones.\",\n    )\n    worktree_audit_parser.add_argument(\n        \"--doctor\",\n        action=\"store_true\",\n        help=\"Run readiness doctor for existing worktrees and include per-worktree readiness summaries.\",\n    )\n    add_worktree_lib_args(worktree_audit_parser)\n    worktree_audit_parser.set_defaults(func=cmd_worktree_audit)\n\n    worktree_cleanup_parser = worktree_subparsers.add_parser(\n        \"cleanup\",\n        help=\"Safely remove a registered git worktree and optionally delete its merged local branch.\",\n    )\n    worktree_cleanup_parser.add_argument(\n        \"--repo-root\",\n        type=Path,\n        help=\"Repo root whose worktree should be operated on. Defaults to the current working directory.\",\n    )\n    worktree_cleanup_parser.add_argument(\n        \"--path\", type=Path, required=True, help=\"Registered worktree path to remove.\"\n    )\n    worktree_cleanup_parser.add_argument(\n        \"--delete-merged-branch\",\n        action=\"store_true\",\n        help=\"Delete the local branch only after it is contained in --branch-base.\",\n    )\n    worktree_cleanup_parser.add_argument(\n        \"--branch-base\",\n        default=\"HEAD\",\n        help=\"Local ref that must contain the target branch before branch deletion; defaults to HEAD.\",\n    )\n    worktree_cleanup_parser.add_argument(\n        \"--yes\",\n        action=\"store_true\",\n        help=\"Execute the planned cleanup. Defaults to dry-run.\",\n    )\n    worktree_cleanup_parser.add_argument(\n        \"--force\",\n        action=\"store_true\",\n        help=\"Pass --force to git worktree remove for dirty targets.\",\n    )\n    add_worktree_lib_args(worktree_cleanup_parser)\n    worktree_cleanup_parser.set_defaults(func=cmd_worktree_cleanup)\n\n    return parser\n\n\ndef main(argv: list[str] | None = None) -> int:\n    raw_argv = list(sys.argv[1:] if argv is None else argv)\n    if raw_argv == [\"--version\"]:\n        raw_argv = [\"version\"]\n    parser = build_parser()\n    args = parser.parse_args(raw_argv)\n    is_worktree_exec = (\n        getattr(args, \"command\", None) == \"worktree\"\n        and getattr(args, \"worktree_command\", None) == \"exec\"\n    )\n    is_task_run = (\n        getattr(args, \"command\", None) == \"task\" and getattr(args, \"task_command\", None) == \"run\"\n    )\n    runtime_configured = False\n    if not (is_worktree_exec or is_task_run):\n        runtime_configured = _configure_runtime_for_repo(\n            _runtime_repo_for_args(args), required=False\n        )\n    if not (\n        getattr(args, \"command\", None) == \"version\"\n        and not getattr(args, \"verbose\", False)\n        and not getattr(args, \"check\", False)\n    ) and not (is_worktree_exec or is_task_run):\n        maybe_record_self_version_state(args)\n    if _EARLY_BYTECODE_GUARD and runtime_configured:\n        sys.dont_write_bytecode = False\n    try:\n        return args.func(args)\n    finally:\n        if _EARLY_BYTECODE_GUARD:\n            sys.dont_write_bytecode = False\n\n\nif __name__ == \"__main__\":\n    try:\n        raise SystemExit(main())\n    except CharnessError as exc:\n        print(str(exc), file=sys.stderr)\n        raise SystemExit(1)\n",
    "prompt_encoding": "utf-8",
