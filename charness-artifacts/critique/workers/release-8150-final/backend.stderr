    "carrier_path": "/home/hwidong/.cache/tmp/charness/runtime/811b9f8f8a808bfa/scratch/critique-review/review-c55418ca492342351d27ff5ca42eedcf/semantic-input/0022-content.bin",
    "carrier_sha256": "844b810f66fdebe34fbb5cf106391be54e7d8276541f8cbf42307d8960ef7e8d",
    "content_sha256": "2c2b0173d12022a2e67f3fae255bf7ad9a66816c2f95eed7a81ae91db326c419",
    "disposition": "present",
    "path": "tests/charness_cli/test_task_run_progress_preemption.py",
    "prompt_content": "\"\"\"The progress rule reaches a running lane: preempt, resume with its message, or stop.\n\nThe fake executor owns a lower-level claim: it emits Codex-shaped events and\nwaits to be killed, and a `resume` invocation records the prompt it was\ngiven. It does not claim live Codex behavior (a SIGKILLed `codex exec`\nsession resuming with its context was probed by hand on codex-cli 0.163.0;\nsee charness-artifacts/spec/lane-progress-rule.md).\n\"\"\"\n\nfrom __future__ import annotations\n\nimport json\nimport os\nimport sys\nfrom pathlib import Path\n\nimport pytest\n\nfrom scripts.task_run import (\n    task_run_execution,\n    task_run_lane_runner,\n    task_run_progress,\n)\nfrom tests.charness_cli.test_task_run_fixtures import _git, _repo\n\npytestmark = pytest.mark.boundary_contract(\n    reason=\"the claim is that a real executor process is killed and resumed with the rule's message\"\n)\n\nTEST = \"pytest -q tests/test_a.py\"\n\n\ndef _event(kind: str, item_id: str) -> str:\n    return json.dumps(\n        {\"type\": kind, \"item\": {\"id\": item_id, \"type\": \"command_execution\",\n                                \"command\": TEST, \"exit_code\": 1}}\n    )\n\n\ndef _fake_codex(tmp_path: Path, first_turn: list[str]) -> Path:\n    fake = tmp_path / \"fake-codex\"\n    lines = \"\".join(f\"    print({line!r}, flush=True)\\n\" for line in first_turn)\n    fake.write_text(\n        f\"#!{sys.executable}\\n\"\n        \"import json, os, pathlib, sys, time\\n\"\n        \"args = sys.argv[1:]\\n\"\n        \"prompt = sys.stdin.read()\\n\"\n        \"log = pathlib.Path(os.environ['INVOCATIONS_LOG'])\\n\"\n        \"with log.open('a') as handle:\\n\"\n        \"    handle.write(json.dumps({'args': args, 'prompt': prompt}) + '\\\\n')\\n\"\n        \"output = pathlib.Path(args[args.index('--output-last-message') + 1])\\n\"\n        \"calls = len(log.read_text().splitlines())\\n\"\n        \"if 'resume' not in args:\\n\"\n        \"    print(json.dumps({'type': 'thread.started', 'thread_id': 'session-1'}), flush=True)\\n\"\n        f\"{lines}\"\n        \"    time.sleep(60)\\n\"\n        \"elif os.environ.get('RESUME_HANGS') == '1':\\n\"\n        \"    time.sleep(60)\\n\"\n        \"else:\\n\"\n        \"    output.write_text('resumed and finished\\\\n')\\n\",\n        encoding=\"utf-8\",\n    )\n    fake.chmod(0o755)\n    return fake\n\n\ndef _run(tmp_path: Path, fake: Path, **env: str) -> tuple[dict, list[dict], list[dict]]:\n    repo = _repo(tmp_path)\n    runtime = tmp_path / \"runtime\" / \"lane-1\"\n    runtime.mkdir(parents=True)\n    stdout_log, stderr_log = runtime / \"codex.stdout.log\", runtime / \"codex.stderr.log\"\n    invocations = tmp_path / \"invocations.jsonl\"\n    command = task_run_lane_runner.lane_command(\n        executor=\"codex\",\n        executable=str(fake),\n        effort=\"xhigh\",\n        prompt=\"Implement the lane request.\",\n        execution_runtime_path=runtime,\n        writable_dirs=(),\n        worktree=repo,\n    )\n    watch = task_run_progress.build_progress_watch(\n        require_change=False,\n        stdout_log=stdout_log,\n        stderr_log=stderr_log,\n        worktree=repo,\n        base_sha=_git(repo, \"rev-parse\", \"HEAD\").stdout.strip(),\n        scope_specs=[],\n    )\n    execution = task_run_execution._execute_codex(\n        command,\n        prompt=\"Implement the lane request.\",\n        target_path=repo,\n        configured_env={**os.environ, \"INVOCATIONS_LOG\": str(invocations), **env},\n        stdout_log=stdout_log,\n        stderr_log=stderr_log,\n        timeout_seconds=None,\n        lane_watch=watch,\n        executor=\"codex\",\n    )\n    calls = [json.loads(line) for line in invocations.read_text(encoding=\"utf-8\").splitlines()]\n    queue = task_run_lane_runner.read_steer_queue(runtime / \"steer.queue.jsonl\")\n    assert watch is not None\n    execution[\"progress_guard\"] = watch.receipt()\n    return execution, calls, queue\n\n\ndef test_a_third_identical_test_run_preempts_and_resumes_with_the_debug_request(\n    tmp_path: Path,\n) -> None:\n    fake = _fake_codex(\n        tmp_path,\n        [_event(kind, f\"c{n}\") for n in range(3) for kind in (\"item.started\", \"item.completed\")],\n    )\n\n    execution, calls, queue = _run(tmp_path, fake)\n\n    assert execution[\"exit_code\"] == 0\n    assert execution[\"preemptions\"] == 1\n    assert \"progress_stopped\" not in execution\n    assert len(calls) == 2\n    resumed = calls[1][\"args\"]\n    assert resumed[resumed.index(\"resume\") + 1] == \"session-1\"\n    assert \"switch to the debug skill\" in calls[1][\"prompt\"].lower()\n    (message,) = queue\n    assert message[\"actor\"] == \"charness-progress-rule\"\n    assert message[\"resume_path\"] == \"session-resume\"\n    rule = execution[\"progress_guard\"][\"progress_rule\"]\n    assert [item[\"reason_code\"] for item in rule[\"messages\"]] == [\"loop-debug\"]\n\n\ndef test_a_silent_lane_gets_a_checkpoint_request_then_is_stopped(\n    tmp_path: Path, monkeypatch: pytest.MonkeyPatch\n) -> None:\n    \"\"\"No wall clock bounds this lane: only the rule's two empty windows do.\"\"\"\n    monkeypatch.setenv(\"CHARNESS_TASK_RUN_PROGRESS_WINDOW_SECONDS\", \"0.3\")\n    monkeypatch.setenv(\"CHARNESS_TASK_RUN_PROGRESS_POLL_SECONDS\", \"0.05\")\n    fake = _fake_codex(tmp_path, [])\n\n    execution, calls, queue = _run(tmp_path, fake, RESUME_HANGS=\"1\")\n\n    assert len(calls) == 2  # the first turn, then the resumed request\n    assert \"commit it now\" in calls[1][\"prompt\"]\n    assert [item[\"actor\"] for item in queue] == [\"charness-progress-rule\"]\n    assert \"checkpoint request went unanswered\" in execution[\"progress_stopped\"]\n    rule = execution[\"progress_guard\"][\"progress_rule\"]\n    assert [check[\"progress\"] for check in rule[\"checks\"]] == [False, False]\n    assert [item[\"reason_code\"] for item in rule[\"messages\"]] == [\"no-progress\"]\n    assert rule[\"messages\"][0][\"answered\"] is False\n\n\ndef test_a_loop_that_ignores_both_requests_is_stopped_from_the_event_reader(\n    tmp_path: Path,\n) -> None:\n    repo = _repo(tmp_path)\n    runtime = tmp_path / \"runtime\" / \"lane-1\"\n    runtime.mkdir(parents=True)\n    watch = task_run_progress.build_progress_watch(\n        require_change=False,\n        stdout_log=runtime / \"codex.stdout.log\",\n        stderr_log=runtime / \"codex.stderr.log\",\n        worktree=repo,\n        base_sha=_git(repo, \"rev-parse\", \"HEAD\").stdout.strip(),\n        scope_specs=[],\n    )\n    assert watch is not None\n    completed = [json.loads(_event(\"item.completed\", f\"c{n}\")) for n in range(5)]\n    watch.observe_event(completed[0])  # before start: nothing to preempt yet\n    kills: list[str] = []\n    watch.start(emit=lambda *_args: None, kill=lambda: kills.append(\"kill\"))\n    preempted: list[bool] = []\n    try:\n        for event in completed[1:]:\n            watch.observe_event(event)\n            preempted.append(watch.take_preempted())  # the loop's per-invocation read\n    finally:\n        watch.stop()\n\n    # 3rd and 4th runs preempted with messages; the 5th stopped the lane.\n    assert preempted == [False, True, True, False]\n    assert watch.preemptions == 2\n    assert kills == [\"kill\", \"kill\", \"kill\"]\n    assert watch.stop_reason is not None and watch.stop_reason.startswith(\"loop:\")\n    stderr = (runtime / \"codex.stderr.log\").read_text(encoding=\"utf-8\")\n    assert \"NO-PROGRESS-STOP: loop:\" in stderr\n\n\ndef _started_watch(tmp_path: Path) -> tuple[task_run_progress.LaneProgressWatch, list[str], Path]:\n    repo = _repo(tmp_path)\n    runtime = tmp_path / \"runtime\" / \"lane-1\"\n    runtime.mkdir(parents=True)\n    watch = task_run_progress.build_progress_watch(\n        require_change=False,\n        stdout_log=runtime / \"codex.stdout.log\",\n        stderr_log=runtime / \"codex.stderr.log\",\n        worktree=repo,\n        base_sha=_git(repo, \"rev-parse\", \"HEAD\").stdout.strip(),\n        scope_specs=[],\n    )\n    assert watch is not None\n    kills: list[str] = []\n    watch.start(emit=lambda *_args: None, kill=lambda: kills.append(\"kill\"))\n    watch.stop()  # drive it by hand; no poll thread\n    return watch, kills, runtime / \"steer.queue.jsonl\"\n\n\ndef test_messages_in_one_invocation_share_one_preemption_and_lose_to_a_stop(\n    tmp_path: Path,\n) -> None:\n    from scripts.task_run.task_run_progress_rule import Action\n\n    watch, kills, queue = _started_watch(tmp_path)\n    watch._apply(Action(\"message\", \"first\", \"loop-debug\"))\n    watch._apply(Action(\"message\", \"second\", \"no-progress\"))\n    assert (watch.preemptions, kills) == (1, [\"kill\"])\n    assert len(task_run_lane_runner.read_steer_queue(queue)) == 2\n\n    # The stop wins before the resume delivers them: both are superseded and\n    # the preemption that never became a resume is not counted.\n    watch._stop_now(\"stopped by the rule\")\n    queued = task_run_lane_runner.read_steer_queue(queue)\n    assert {(item[\"disposition\"], item[\"reason_code\"]) for item in queued} == {\n        (\"nacked\", \"superseded-by-stop\")\n    }\n    assert (watch.preemptions, watch.take_preempted()) == (0, False)\n    watch._apply(Action(\"message\", \"too late\", \"no-progress\"))\n    assert watch.suppressed_actions == 3\n    assert len(task_run_lane_runner.read_steer_queue(queue)) == 2\n    assert watch.receipt()[\"suppressed_actions\"] == 3\n\n\ndef test_a_message_raised_after_the_rule_decided_to_stop_is_suppressed(\n    tmp_path: Path,\n) -> None:\n    from scripts.task_run.task_run_progress_rule import Action\n\n    watch, kills, queue = _started_watch(tmp_path)\n    watch._progress_rule.stop_reason = \"the rule stopped first\"  # watch not yet told\n    watch._apply(Action(\"message\", \"late\", \"loop-debug\"))\n\n    assert (watch.suppressed_actions, kills) == (1, [])\n    assert task_run_lane_runner.read_steer_queue(queue) == []\n\n\ndef test_failing_due_checks_stop_the_lane_even_with_quiet_polls_between(\n    tmp_path: Path, monkeypatch: pytest.MonkeyPatch\n) -> None:\n    watch, _kills, _queue = _started_watch(tmp_path)\n    calls = {\"n\": 0}\n\n    def due_checks_fail(_now: float) -> None:\n        calls[\"n\"] += 1\n        if calls[\"n\"] % 2 == 0:\n            raise RuntimeError(\"fingerprint exploded\")\n        return None  # an ordinary poll: no check was due\n\n    monkeypatch.setattr(watch._progress_rule, \"on_tick\", due_checks_fail)\n    reasons = [watch._tick_rule(float(n)) for n in range(2 * task_run_progress.MAX_RULE_FAILURES)]\n\n    assert all(reason is None for reason in reasons[:-1])\n    assert reasons[-1] is not None and \"cannot be bounded\" in reasons[-1]\n\n\ndef test_a_watch_that_cannot_check_stops_the_lane_instead_of_leaving_it_unbounded(\n    tmp_path: Path, monkeypatch: pytest.MonkeyPatch\n) -> None:\n    watch, _kills, _queue = _started_watch(tmp_path)\n\n    def broken_poll(_now: float) -> None:\n        raise RuntimeError(\"log unreadable\")\n\n    def broken_rule(_now: float) -> None:\n        raise RuntimeError(\"fingerprint exploded\")\n\n    monkeypatch.setattr(watch, \"_poll\", broken_poll)\n    monkeypatch.setattr(watch._progress_rule, \"on_tick\", broken_rule)\n    reasons = [watch.tick(float(n)) for n in range(task_run_progress.MAX_RULE_FAILURES)]\n\n    assert reasons[:-1] == [None] * (task_run_progress.MAX_RULE_FAILURES - 1)\n    assert reasons[-1] is not None and \"cannot be bounded\" in reasons[-1]\n\n\ndef test_a_stopped_watch_ignores_events_and_a_second_stop_and_its_poll_ends(\n    tmp_path: Path, monkeypatch: pytest.MonkeyPatch\n) -> None:\n    monkeypatch.setenv(\"CHARNESS_TASK_RUN_PROGRESS_POLL_SECONDS\", \"0.05\")\n    repo = _repo(tmp_path)\n    runtime = tmp_path / \"runtime\" / \"lane-1\"\n    runtime.mkdir(parents=True)\n    watch = task_run_progress.build_progress_watch(\n        require_change=False,\n        stdout_log=runtime / \"codex.stdout.log\",\n        stderr_log=runtime / \"codex.stderr.log\",\n        worktree=repo,\n        base_sha=_git(repo, \"rev-parse\", \"HEAD\").stdout.strip(),\n        scope_specs=[],\n    )\n    assert watch is not None\n    kills: list[str] = []\n    watch.start(emit=lambda *_args: None, kill=lambda: kills.append(\"kill\"))\n    watch._stop_now(\"first stop\")\n    watch._stop_now(\"second stop\")  # first wins\n    watch.observe_event(json.loads(_event(\"item.completed\", \"c1\")))  # ignored\n    watch._thread.join(timeout=30)  # the poll loop ends on its own once stopped\n\n    assert not watch._thread.is_alive()\n    assert (watch.stop_reason, kills) == (\"first stop\", [\"kill\"])\n    watch.stop()\n",
    "prompt_encoding": "utf-8",
    "size_bytes": 12067,
    "source": "working-tree:tests/charness_cli/test_task_run_progress_preemption.py"
  },
  {
    "carrier_path": "/home/hwidong/.cache/tmp/charness/runtime/811b9f8f8a808bfa/scratch/critique-review/review-c55418ca492342351d27ff5ca42eedcf/semantic-input/0023-content.bin",
    "carrier_sha256": "1b0eb485c07ea270a4d179a9b4214fbfd60f142e883a9bb7f75b7530d7cee85d",
    "content_sha256": "e8580c8f42e5b74274642c28a28dc82d20368335649bf9b465ce0c0b450c2f58",
    "disposition": "present",
    "path": "tests/charness_cli/test_task_run_progress_rule.py",
    "prompt_content": "\"\"\"The lane progress rule, driven on an injected clock and worktree fingerprint.\n\nNo test here reads wall time: `now` is passed in and the worktree state is a\nvalue the test sets, so every verdict follows from the inputs alone.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport json\nimport subprocess\nfrom pathlib import Path\n\nimport pytest\n\nfrom scripts.task_run import task_run_progress_rule as rule_owner\n\nfrom .test_task_run_fixtures import _repo\n\nTEST = \"/usr/bin/zsh -lc 'pnpm run test:changed'\"\n\n\nclass _Tree:\n    def __init__(self) -> None:\n        self.state: str | None = \"tree-0\"\n\n    def __call__(self) -> str | None:\n        return self.state\n\n\ndef _rule(window: float = 100.0) -> tuple[rule_owner.ProgressRule, _Tree]:\n    tree = _Tree()\n    rule = rule_owner.ProgressRule(window_seconds=window, fingerprint=tree)\n    rule.start(0.0)\n    return rule, tree\n\n\ndef _completed(command: str, item_id: str, exit_code: int = 1) -> dict[str, object]:\n    return {\n        \"type\": \"item.completed\",\n        \"item\": {\n            \"id\": item_id,\n            \"type\": \"command_execution\",\n            \"command\": command,\n            \"exit_code\": exit_code,\n        },\n    }\n\n\ndef test_a_window_with_progress_asks_nothing() -> None:\n    rule, tree = _rule()\n    tree.state = \"tree-1\"  # a file changed\n\n    assert rule.on_tick(99.0) is None  # inside the window: no check yet\n    assert rule.on_tick(100.0) is None\n    assert rule.receipt()[\"checks\"][-1][\"progress\"] is True\n\n\ndef test_an_empty_window_requests_a_checkpoint_and_the_next_one_stops() -> None:\n    rule, _tree = _rule()\n\n    request = rule.on_tick(100.0)\n    assert request is not None and request.kind == \"message\"\n    assert request.reason_code == \"no-progress\"\n    assert \"commit it now\" in request.text and \"never --no-verify\" in request.text\n    assert rule.snapshot(150.0)[\"checkpoint_request\"] == \"delivered\"\n\n    stop = rule.on_tick(200.0)\n    assert stop is not None and stop.kind == \"stop\"\n    assert \"checkpoint request went unanswered\" in stop.text\n    assert rule.receipt()[\"stop_reason\"] == stop.text\n\n\ndef test_answering_the_request_with_any_progress_clears_it() -> None:\n    rule, tree = _rule()\n    assert rule.on_tick(100.0) is not None\n\n    tree.state = \"tree-after-commit\"  # the lane committed\n    assert rule.on_tick(200.0) is None\n    assert rule.snapshot(200.0)[\"checkpoint_request\"] is None\n    assert rule.receipt()[\"messages\"][0][\"answered\"] is True\n    # A later empty window starts the sequence over with a request, not a stop.\n    request = rule.on_tick(300.0)\n    assert request is not None and request.kind == \"message\"\n\n\ndef test_a_new_command_outcome_is_progress_but_a_repeat_is_not() -> None:\n    rule, _tree = _rule()\n    rule.on_event(_completed(\"cat a.py\", \"c1\"))\n    assert rule.on_tick(100.0) is None  # one new outcome\n\n    rule.on_event(_completed(\"cat a.py\", \"c2\"))  # same command, same tree\n    assert rule.on_tick(200.0) is not None  # no new outcome: request\n\n\ndef test_an_unobservable_worktree_falls_back_to_the_executors_own_events() -> None:\n    rule, tree = _rule()\n    tree.state = None\n    edit = {\"type\": \"item.completed\", \"item\": {\"id\": \"f1\", \"type\": \"file_change\"}}\n\n    rule.on_event(edit)\n    assert rule.on_tick(100.0) is None  # the executor reported an edit\n    assert rule.receipt()[\"checks\"][-1][\"tree_observable\"] is False\n    # Silence with an unreadable tree is still silence: request, then stop.\n    assert rule.on_tick(200.0).kind == \"message\"\n    assert rule.on_tick(300.0).kind == \"stop\"\n\n\ndef test_a_command_in_flight_defers_the_request_instead_of_killing_it() -> None:\n    rule, _tree = _rule()\n    started = {\"type\": \"item.started\",\n               \"item\": {\"id\": \"c1\", \"type\": \"command_execution\", \"command\": TEST}}\n    rule.on_event(started)\n\n    assert rule.on_tick(100.0) is None  # deferred: the command may be long\n    assert rule.snapshot(100.0)[\"checkpoint_request\"] == \"deferred\"\n    # Still running at the next check: now it is interrupted with the request.\n    request = rule.on_tick(200.0)\n    assert request is not None and request.kind == \"message\"\n    assert \"was interrupted after running for at least\" in request.text\n    assert rule.on_tick(300.0).kind == \"stop\"\n\n\ndef test_a_deferred_request_is_withdrawn_when_the_long_command_finishes() -> None:\n    rule, _tree = _rule()\n    rule.on_event({\"type\": \"item.started\",\n                   \"item\": {\"id\": \"c1\", \"type\": \"command_execution\", \"command\": TEST}})\n    assert rule.on_tick(100.0) is None\n    rule.on_event(_completed(TEST, \"c1\"))  # a new outcome\n\n    assert rule.on_tick(200.0) is None\n    assert rule.snapshot(200.0)[\"checkpoint_request\"] is None\n\n\ndef test_a_deferred_request_is_delivered_at_a_repeat_completion() -> None:\n    rule, _tree = _rule()\n    rule.on_event(_completed(\"cat a.py\", \"c0\"))\n    assert rule.on_tick(100.0) is None  # that outcome was progress\n    rule.on_event({\"type\": \"item.started\",\n                   \"item\": {\"id\": \"c1\", \"type\": \"command_execution\", \"command\": \"cat a.py\"}})\n    assert rule.on_tick(200.0) is None  # deferred\n    request = rule.on_event(_completed(\"cat a.py\", \"c1\"))  # nothing new\n\n    assert request is not None and request.reason_code == \"no-progress\"\n    assert \"interrupted\" not in request.text\n\n\ndef test_the_third_identical_test_run_asks_for_debug_then_checkpoint_then_stops() -> None:\n    rule, _tree = _rule()\n\n    assert rule.on_event(_completed(TEST, \"c1\")) is None\n    assert rule.on_event(_completed(TEST, \"c2\")) is None\n    debug = rule.on_event(_completed(TEST, \"c3\", exit_code=1))\n    assert debug is not None and debug.reason_code == \"loop-debug\"\n    assert \"debug skill\" in debug.text and \"last exit code 1\" in debug.text\n    checkpoint = rule.on_event(_completed(TEST, \"c4\"))\n    assert checkpoint is not None and checkpoint.reason_code == \"loop-checkpoint\"\n    stop = rule.on_event(_completed(TEST, \"c5\"))\n    assert stop is not None and stop.kind == \"stop\" and stop.reason_code == \"loop-stop\"\n\n\ndef test_a_file_change_between_runs_resets_the_loop_count() -> None:\n    rule, tree = _rule()\n    for index in range(6):\n        tree.state = f\"tree-{index}\"  # an edit before every run\n        assert rule.on_event(_completed(TEST, f\"c{index}\")) is None\n\n\ndef test_repeats_outside_the_loop_families_never_message() -> None:\n    rule, _tree = _rule()\n    for index in range(6):\n        assert rule.on_event(_completed(\"cat a.py\", f\"c{index}\")) is None\n\n\ndef test_muse_bash_completions_feed_the_same_rule() -> None:\n    rule, _tree = _rule()\n\n    def bash(task_id: str) -> list[dict[str, object]]:\n        chunk = json.dumps({\"command\": \"python3 -m pytest tests/a.py\", \"exit_code\": 1})\n        return [\n            {\"payload_type\": \"task.lifecycle.proposed\",\n             \"payload\": {\"task_id\": task_id, \"event\": {\"task_kind\": \"tool.bash\"}}},\n            {\"payload_type\": \"task.lifecycle.started\", \"payload\": {\"task_id\": task_id}},\n            {\"payload_type\": \"task.lifecycle.output\",\n             \"payload\": {\"task_id\": task_id, \"event\": {\"chunk\": chunk}}},\n            {\"payload_type\": \"task.lifecycle.completed\", \"payload\": {\"task_id\": task_id}},\n        ]\n\n    actions = [rule.on_event(event) for task in (\"t1\", \"t2\", \"t3\") for event in bash(task)]\n    assert [action.reason_code for action in actions if action] == [\"loop-debug\"]\n\n\ndef test_a_non_positive_window_turns_the_stop_off() -> None:\n    rule, _tree = _rule(window=0)\n\n    assert rule.on_tick(10_000.0) is None\n    assert rule.receipt()[\"stop_enabled\"] is False\n\n\ndef test_worktree_fingerprint_sees_edits_commits_and_untracked_but_not_ignored(\n    tmp_path: Path,\n) -> None:\n    repo = _repo(tmp_path, ignored=True)\n    first = rule_owner.worktree_fingerprint(repo)\n    assert first is not None and rule_owner.worktree_fingerprint(repo) == first\n\n    (repo / \"ignored-output.txt\").write_text(\"cache\\n\", encoding=\"utf-8\")\n    assert rule_owner.worktree_fingerprint(repo) == first\n\n    (repo / \"module.py\").write_text(\"VALUE = 2\\n\", encoding=\"utf-8\")\n    edited = rule_owner.worktree_fingerprint(repo)\n    assert edited != first\n\n    (repo / \"new.py\").write_text(\"NEW = 1\\n\", encoding=\"utf-8\")\n    untracked = rule_owner.worktree_fingerprint(repo)\n    assert untracked != edited\n\n    for args in ((\"add\", \"-A\"), (\"-c\", \"user.email=t@e\", \"-c\", \"user.name=t\", \"commit\", \"-qm\", \"x\")):\n        subprocess.run([\"git\", *args], cwd=repo, check=True)\n    assert rule_owner.worktree_fingerprint(repo) not in {first, edited, untracked}\n    assert rule_owner.worktree_fingerprint(tmp_path / \"missing\") is None\n\n\ndef test_reruns_on_an_unreadable_tree_are_not_progress_and_never_claim_a_loop() -> None:\n    rule, tree = _rule()\n    tree.state = None\n    assert rule.on_event(_completed(TEST, \"c0\")) is None  # new: progress\n    assert rule.on_tick(100.0) is None\n    for index in range(1, 6):\n        assert rule.on_event(_completed(TEST, f\"c{index}\")) is None\n    assert rule.on_tick(200.0).kind == \"message\"\n\n\ndef test_a_command_started_after_the_request_is_not_killed_until_it_is_a_window_old() -> None:\n    rule, _tree = _rule()\n    assert rule.on_tick(100.0).kind == \"message\"  # delivered\n    rule.on_event({\"type\": \"item.started\",\n                   \"item\": {\"id\": \"late\", \"type\": \"command_execution\", \"command\": TEST}})\n\n    assert rule.on_tick(200.0) is None  # the command is younger than a window\n    assert rule.receipt()[\"checks\"][-1][\"deferred_for_young_command\"] is True\n    stop = rule.on_tick(300.0)  # still running a window later, nothing moved\n    assert stop is not None and stop.kind == \"stop\"\n\n\n@pytest.mark.parametrize(\n    (\"ended_normally\", \"answer\"), [(True, (True, \"lane-ended\")), (False, (False, \"lane-failed\"))]\n)\ndef test_only_a_clean_end_answers_a_checkpoint_request(\n    ended_normally: bool, answer: tuple[bool, str]\n) -> None:\n    rule, _tree = _rule()\n    assert rule.on_tick(100.0).kind == \"message\"\n    rule.finish(ended_normally=ended_normally)\n\n    message = rule.receipt()[\"messages\"][0]\n    assert (message[\"answered\"], message[\"answered_by\"]) == answer\n    assert rule.snapshot(100.0)[\"checkpoint_request\"] is None\n\n\ndef test_a_resumed_session_reusing_an_item_id_is_a_new_young_command() -> None:\n    \"\"\"Codex numbers items per turn, so `item_1` after a resume is a new command.\"\"\"\n    rule, _tree = _rule()\n    started = {\"type\": \"item.started\",\n               \"item\": {\"id\": \"item_1\", \"type\": \"command_execution\", \"command\": \"sleep 300\"}}\n    rule.on_event(started)\n    assert rule.on_tick(100.0) is None  # young: deferred\n    assert rule.on_tick(200.0).kind == \"message\"  # a window old: request, killing it\n    rule.start(210.0)  # the resumed invocation\n    rule.on_event(started)  # the lane restarts it under the same item id\n\n    assert rule.on_tick(300.0) is None\n    assert rule.receipt()[\"checks\"][-1][\"deferred_for_young_command\"] is True\n    assert rule.on_tick(400.0).kind == \"stop\"\n\n\ndef test_a_stopped_rule_raises_no_more_messages() -> None:\n    rule, _tree = _rule()\n    assert rule.on_tick(100.0).kind == \"message\"\n    assert rule.on_tick(200.0).kind == \"stop\"\n    for index in range(3):\n        assert rule.on_event(_completed(TEST, f\"c{index}\")) is None\n\n\ndef test_muse_edit_tools_are_outcomes_but_model_responses_are_not() -> None:\n    rule, _tree = _rule()\n\n    def task(task_id: str, kind: str) -> list[dict[str, object]]:\n        return [\n            {\"payload_type\": \"task.lifecycle.proposed\",\n             \"payload\": {\"task_id\": task_id, \"event\": {\"task_kind\": kind}}},\n            {\"payload_type\": \"task.lifecycle.completed\", \"payload\": {\"task_id\": task_id}},\n        ]\n\n    for event in task(\"r1\", \"model.meta.response\"):\n        rule.on_event(event)\n    assert rule.on_tick(100.0) is not None  # a model turn alone is not progress\n    for event in task(\"e1\", \"tool.edit\"):\n        rule.on_event(event)\n    assert rule.on_tick(200.0) is None\n\n\ndef test_worktree_fingerprint_is_none_outside_git_and_skips_vanished_files(\n    tmp_path: Path, monkeypatch: pytest.MonkeyPatch\n) -> None:\n    plain = tmp_path / \"not-a-repo\"\n    plain.mkdir()\n    assert rule_owner.worktree_fingerprint(plain) is None\n\n    repo = _repo(tmp_path)\n    (repo / \"gone.txt\").write_text(\"x\\n\", encoding=\"utf-8\")\n    import os as real_os\n\n    def vanished(path: object, **kwargs: object) -> object:\n        if str(path).endswith(\"gone.txt\"):\n            raise FileNotFoundError(path)\n        return real_os.stat(path, **kwargs)\n\n    # Rebinds only this module's `os`; the file vanishes between listing and stat.\n    monkeypatch.setattr(rule_owner, \"os\", type(\"Os\", (), {\"stat\": staticmethod(vanished)}))\n    assert rule_owner.worktree_fingerprint(repo) is not None\n\n\ndef test_bootstrap_shims_insert_the_repo_root_when_it_is_absent(\n    monkeypatch: pytest.MonkeyPatch,\n) -> None:\n    import sys\n\n    from scripts.task_run import task_run_lane_signals\n\n    root = Path(__file__).resolve().parents[2]\n    for module in (rule_owner, task_run_lane_signals):\n        stripped = [entry for entry in sys.path if entry and Path(entry).resolve() != root]\n        monkeypatch.setattr(sys, \"path\", stripped)\n        module._load_repo_runtime_bootstrap()\n        assert str(root) in sys.path\n",
    "prompt_encoding": "utf-8",
    "size_bytes": 13141,
    "source": "working-tree:tests/charness_cli/test_task_run_progress_rule.py"
  },
  {
    "carrier_path": "/home/hwidong/.cache/tmp/charness/runtime/811b9f8f8a808bfa/scratch/critique-review/review-c55418ca492342351d27ff5ca42eedcf/semantic-input/0024-content.bin",
    "carrier_sha256": "a923ffc4d6b7b43d72d5c1e6ca2469b08dd402687c1c9ebc0381af8698bfea56",
    "content_sha256": "d15e183a0b1f93b22a77bb13cd2567fab128a405cb73468390888d12d8da2704",
    "disposition": "present",
    "path": "tests/charness_cli/test_task_run_self_review.py",
    "prompt_content": "\"\"\"Self-review receipt states and unavailable-review non-claims.\"\"\"\n\nfrom __future__ import annotations\n\nimport json\nimport os\nimport subprocess\nimport sys\nfrom pathlib import Path\n\nimport pytest\n\nfrom scripts.task_run import task_run, task_run_execution, task_run_runtime, task_run_self_review\nfrom tests.charness_cli.test_task_run_fixtures import _codex\n\n\ndef test_self_review_findings_are_grouped_by_disposition() -> None:\n    block = task_run_self_review.self_review_block(\n        \"findings-received\",\n        findings=[\n            {\"summary\": \"The boundary is covered.\", \"disposition\": \"fixed\", \"evidence\": [\"src/a.py:2\"]},\n            {\"summary\": \"The follow-up remains open.\", \"disposition\": \"deferred\", \"evidence\": []},\n            {\"summary\": \"The reported risk does not apply.\", \"disposition\": \"disputed\", \"evidence\": []},\n        ],\n    )\n\n    assert block[\"kind\"] == \"charness.task_self_review.v1\"\n    assert [item[\"summary\"] for item in block[\"findings\"][\"fixed\"]] == [\n        \"The boundary is covered.\"\n    ]\n    assert [item[\"disposition\"] for item in block[\"findings\"][\"deferred\"]] == [\n        \"deferred\"\n    ]\n    assert [item[\"disposition\"] for item in block[\"findings\"][\"disputed\"]] == [\n        \"disputed\"\n    ]\n    assert \"independent review\" in block[\"non_claim\"]\n\n\n@pytest.mark.parametrize(\n    (\"state\", \"findings\", \"message\"),\n    [\n        (\"passed\", [], \"unknown self-review state\"),\n        (\"findings-received\", \"invalid\", \"must be a list\"),\n        (\"findings-received\", [{\"summary\": \"risk\", \"disposition\": \"open\"}], \"needs\"),\n        (\"findings-received\", [{\"summary\": \" \", \"disposition\": \"fixed\"}], \"non-empty\"),\n        (\n            \"findings-received\",\n            [{\"summary\": \"risk\", \"disposition\": \"fixed\", \"evidence\": [\"file.py\", 3]}],\n            \"evidence must be a list\",\n        ),\n        (\n            \"findings-received\",\n            [{\"summary\": \"risk\", \"disposition\": \"fixed\"}],\n            \"evidence must be a list\",\n        ),\n    ],\n)\ndef test_self_review_rejects_malformed_findings(state: str, findings: object, message: str) -> None:\n    with pytest.raises(ValueError, match=message):\n        task_run_self_review.self_review_block(state, findings=findings)\n\n\ndef test_self_review_filters_blank_evidence() -> None:\n    block = task_run_self_review.self_review_block(\n        \"findings-received\",\n        findings=[{\"summary\": \"Risk\", \"disposition\": \"fixed\", \"evidence\": [\"path:2\", \" \"]}],\n    )\n\n    assert block[\"findings\"][\"fixed\"][0][\"evidence\"] == [\"path:2\"]\n\n\ndef test_self_review_prompt_and_schema_use_list_evidence() -> None:\n    schema = task_run_self_review.self_review_schema()\n    finding_schema = schema[\"properties\"][\"findings\"][\"items\"]\n\n    assert schema[\"required\"] == list(schema[\"properties\"])\n    assert schema[\"properties\"][\"kind\"][\"enum\"] == [\"charness.task_self_review.v1\"]\n    assert finding_schema[\"properties\"][\"evidence\"] == {\n        \"type\": \"array\", \"items\": {\"type\": \"string\"}\n    }\n    prompt = task_run_self_review.self_review_prompt(\"Review.\", \"base\", [\"file.py\"])\n    assert finding_schema[\"required\"] == list(finding_schema[\"properties\"])\n    assert \"minLength\" not in json.dumps(schema)\n    assert \"use [] when there is no evidence\" in prompt\n    assert \"optional string evidence\" not in prompt\n\n\n@pytest.mark.parametrize(\n    (\"executor\", \"command\", \"reason_fragment\"),\n    [\n        (\"muse\", [\"/not-used/muse\"], \"read-only Codex reviewer is unavailable\"),\n        (\"codex\", None, \"reviewer command is unavailable\"),\n        (\"codex\", [\"/not-installed/codex\"], \"reviewer executable is unavailable\"),\n    ],\n)\ndef test_unavailable_self_review_is_a_reasoned_non_claim(\n    tmp_path: Path,\n    executor: str,\n    command: list[str] | None,\n    reason_fragment: str,\n) -> None:\n    block = task_run_execution.run_self_review(\n        {\n            \"self_review_policy\": \"always\",\n            \"_self_review_prompt\": \"Review this candidate.\",\n            \"executor\": {\"kind\": executor, \"command\": command},\n            \"candidate\": {\"changed_paths\": [\"src/module.py\"]},\n            \"execution_runtime_root\": str(tmp_path / \"runtime\"),\n            \"worktree_path\": str(tmp_path),\n        }\n    )\n\n    assert block[\"state\"] == \"unavailable-skip\"\n    assert reason_fragment in block[\"reason\"]\n    assert \"not review-passed\" in block[\"non_claim\"]\n    assert block[\"findings\"] == {\"fixed\": [], \"deferred\": [], \"disputed\": []}\n\n\ndef test_self_review_normalizes_runtime_failures(tmp_path: Path) -> None:\n    blocked_runtime = tmp_path.parent / f\"{tmp_path.name}-runtime-file\"\n    blocked_runtime.write_text(\"file\", encoding=\"utf-8\")\n    runtime_failure = task_run_execution.run_self_review(\n        {\n            \"self_review_policy\": \"always\",\n            \"_self_review_prompt\": \"Review this candidate.\",\n            \"executor\": {\"kind\": \"codex\", \"command\": [sys.executable]},\n            \"execution_runtime_root\": str(blocked_runtime),\n            \"worktree_path\": str(tmp_path),\n        }\n    )\n    assert runtime_failure[\"state\"] == \"unavailable-skip\"\n    assert \"reviewer could not run\" in runtime_failure[\"reason\"]\n\n\ndef test_self_review_maps_executor_and_invalid_result_failures() -> None:\n    failed = task_run_self_review.self_review_result({\"exit_code\": 2}, \"\")\n    invalid = task_run_self_review.self_review_result(\n        {\"exit_code\": 0},\n        '{\"kind\":\"charness.task_self_review.v1\",\"findings\":\"invalid\"}',\n    )\n\n    assert failed[\"state\"] == \"unavailable-skip\"\n    assert \"exited with code 2\" in failed[\"reason\"]\n    assert invalid[\"state\"] == \"unavailable-skip\"\n    assert \"invalid\" in invalid[\"reason\"]\n\n\ndef test_task_status_reads_the_self_review_receipt(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:\n    runtime = tmp_path / \"runtime\"\n    block = task_run_self_review.self_review_block(\n        \"unavailable-skip\", reason=\"read-only reviewer is unavailable\"\n    )\n    monkeypatch.setattr(task_run_runtime._git_owner, \"_require_git_root\", lambda _path: tmp_path)\n    monkeypatch.setattr(task_run_runtime, \"task_runtime_root\", lambda _repo: runtime)\n    task_run_runtime.write_task_result(\n        runtime, {\"task_id\": \"review-consumer\", \"runner_pid\": None, \"self_review\": block}\n    )\n\n    status = task_run_runtime.task_status(tmp_path, \"review-consumer\")\n\n    assert status[\"self_review\"] == block\n\n\ndef test_run_task_rejects_retired_auto_self_review_policy(tmp_path: Path) -> None:\n    result = task_run.run_task(\n        tmp_path, scopes=[\"module.py\"], prompt=\"Review this candidate.\", self_review_policy=\"auto\"\n    )\n\n    assert result[\"status\"] == \"fail\"\n    assert \"self_review_policy must be never or always\" in result[\"error\"]\n\n\ndef test_self_review_runs_a_read_only_codex_pass_and_records_findings(tmp_path: Path) -> None:\n    executable = _codex(\n        tmp_path,\n        \"cat >/dev/null\",\n        last_message=(\n            '{\"kind\":\"charness.task_self_review.v1\",'\n            '\"findings\":[{\"summary\":\"Keep the follow-up visible.\",'\n            '\"disposition\":\"deferred\",\"evidence\":[\"src/module.py:4\"]}]}'\n        ),\n        record_arguments=True,\n    )\n    runtime_root = tmp_path.parent / f\"{tmp_path.name}-runtime\"\n    block = task_run_execution.run_self_review(\n        {\n            \"self_review_policy\": \"always\",\n            \"_self_review_prompt\": \"Review the lane candidate.\",\n            \"executor\": {\"kind\": \"codex\", \"command\": [str(executable)], \"timeout_seconds\": 30},\n            \"candidate\": {\"changed_paths\": [\"src/module.py\"]},\n            \"base_sha\": \"base-sha\",\n            \"execution_runtime_root\": str(runtime_root),\n            \"worktree_path\": str(tmp_path),\n        }\n    )\n\n    assert block[\"state\"] == \"findings-received\"\n    assert block[\"findings\"][\"deferred\"][0][\"summary\"] == \"Keep the follow-up visible.\"\n    arguments = (tmp_path / \"args\").read_text(encoding=\"utf-8\").splitlines()\n    schema_path = Path(arguments[arguments.index(\"--output-schema\") + 1])\n    assert schema_path.is_file()\n    assert task_run_self_review.self_review_schema() == json.loads(\n        schema_path.read_text(encoding=\"utf-8\")\n    )\n    assert block[\"findings\"][\"deferred\"][0][\"evidence\"] == [\"src/module.py:4\"]\n\n\ndef test_default_policy_skips_gateway_path_and_push_prompt(tmp_path: Path) -> None:\n    marker = tmp_path / \"review-ran\"\n    executable = tmp_path / \"codex\"\n    executable.write_text(\n        f\"#!/bin/sh\\ntouch '{marker}'\\ncat >/dev/null\\nprintf '{{}}\\\\n'\\n\", encoding=\"utf-8\"\n    )\n    executable.chmod(0o755)\n\n    block = task_run_execution.run_self_review(\n        {\n            \"_self_review_prompt\": \"Push this branch to origin after the change.\",\n            \"executor\": {\"kind\": \"codex\", \"command\": [str(executable)], \"timeout_seconds\": 30},\n            \"scopes\": [\"gateway/lease.py\"],\n            \"candidate\": {\"changed_paths\": [\"gateway/lease.py\"]},\n            \"persistence\": {\"findings\": [], \"blocking\": False},\n            \"base_sha\": \"base-sha\",\n            \"execution_runtime_root\": str(tmp_path / \"runtime\"),\n            \"worktree_path\": str(tmp_path),\n        }\n    )\n\n    assert block[\"state\"] == \"not-requested\"\n    assert not marker.exists()\n\n\ndef test_self_review_module_imports_before_execution() -> None:\n    \"\"\"Either import order binds the same runner; no circular-import trap (#886).\"\"\"\n    repo_root = Path(__file__).resolve().parents[2]\n    probe = (\n        \"from scripts.task_run import task_run_self_review; \"\n        \"from scripts.task_run import task_run_execution; \"\n        \"assert task_run_execution.run_self_review \"\n        \"is task_run_self_review.run_self_review\"\n    )\n    env = {key: value for key, value in os.environ.items() if key != \"PYTHONPATH\"}\n    result = subprocess.run(\n        [sys.executable, \"-c\", probe],\n        cwd=repo_root,\n        env=env,\n        capture_output=True,\n        text=True,\n    )\n    assert result.returncode == 0, result.stderr\n\n\ndef test_self_review_stays_read_only_while_lanes_get_network(\n    tmp_path: Path, monkeypatch: pytest.MonkeyPatch\n) -> None:\n    \"\"\"Lanes run Codex workspace-write with network on (operator, 2026-10-20);\n    the reviewer swaps the sandbox mode to read-only, where the\n    workspace-write network key does not apply.\"\"\"\n    from scripts.task_run import task_run_runtime\n\n    lane = task_run_runtime.build_codex_command(\"codex\", effort=\"medium\")\n    assert lane[lane.index(\"--sandbox\") + 1] == \"workspace-write\"\n    assert lane[-3:] == [\"-c\", \"sandbox_workspace_write.network_access=true\", \"-\"]\n    captured: list[list[str]] = []\n\n    def capture(command, **_kwargs):  # noqa: ANN001, ANN202\n        captured.append(list(command))\n        return {\"exit_code\": 2, \"timed_out\": False, \"interrupted\": False}\n\n    monkeypatch.setattr(task_run_execution, \"_execute_codex\", capture)\n    (tmp_path / \"worktree\").mkdir()\n    block = task_run_execution.run_self_review(\n        {\n            \"self_review_policy\": \"always\",\n            \"_self_review_prompt\": \"Review this candidate.\",\n            \"executor\": {\"kind\": \"codex\", \"command\": [sys.executable]},\n            \"candidate\": {\"changed_paths\": [\"src/module.py\"]},\n            \"execution_runtime_root\": str(tmp_path / \"runtime\"),\n            \"worktree_path\": str(tmp_path / \"worktree\"),\n        }\n    )\n\n    assert len(captured) == 1, block\n    command = captured[0]\n    assert command[command.index(\"--sandbox\") + 1] == \"read-only\"\n    assert \"workspace-write\" not in command\n",
    "prompt_encoding": "utf-8",
