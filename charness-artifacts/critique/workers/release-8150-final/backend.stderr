    "carrier_path": "/home/hwidong/.cache/tmp/charness/runtime/811b9f8f8a808bfa/scratch/critique-review/review-c55418ca492342351d27ff5ca42eedcf/semantic-input/0004-content.bin",
    "carrier_sha256": "4d2eac10e09be063e5c958060134b36e929392d205c7190f08d2f66097a0687c",
