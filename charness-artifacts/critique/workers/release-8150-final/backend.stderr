m scripts.cli.bootstrap_state import (\n        _configure_runtime_for_repo,\n        _parse_prerelease_identifier,\n        _resolve_worktree_lib_root,\n        _runtime_bootstrap_module,\n        _runtime_repo_for_args,\n        _source_checkout_under_work,\n        bool_env,\n        build_self_update_notice,\n        build_version_payload,\n        build_version_provenance,\n        compare_semver_like,\n        compute_update_available,\n        default_home_root,\n        default_version_state_path,\n        emit_yaml,\n        extract_version,\n        fixture_release,\n        git_head,\n        latest_release_cache_is_fresh,\n        maybe_record_self_version_state,\n        normalize_release_payload,\n        normalize_version_token,\n        now_iso,\n        parse_iso_timestamp,\n        parse_semver_like,\n        probe_self_release,\n        read_version_state,\n        refresh_self_release_state,\n        render_yaml,\n        resolve_tool_repo_root,\n        self_release_repo,\n        should_auto_refresh_self_release,\n        write_version_state,\n    )\nexcept ImportError:\n    # Standalone copy without a source tree on `sys.path`: fall back to\n    # the bundled copies below. They are byte-checked against\n    # `scripts/cli/bootstrap*.py` by the bootstrap sync test; like the\n    # `bool_env` table, the duplication is deliberate and load-bearing.\n    class CharnessError(Exception):\n        pass\n\n    def _configure_runtime_for_repo(repo_root: Path, *, required: bool = True) -> bool:\n        runtime_bootstrap = _runtime_bootstrap_module(repo_root)\n        if runtime_bootstrap is None:\n            if required:  # pragma: no cover - standalone-only guard: the entry's sole caller passes required=False.\n                raise CharnessError(\n                    \"Charness runtime owner is unavailable; initialize the managed checkout first\"\n                )\n            return False  # pragma: no cover - needs a scriptless repo with no embedded tree or managed checkout; measured runs always resolve the embedded tree.\n        runtime_bootstrap.configure_runtime_environment(repo_root)\n        return True\n\n    def _diverged_checkout_detail(repo_root: Path, upstream: str, *, max_commits: int = 10) -> str:\n        \"\"\"Name unique local commits and their upstream equivalence, best-effort.\n\n        A diverged managed checkout keeps recurring when work lands in it\n        directly: the operator cannot tell redundant commits (already upstream\n        under another SHA, safe to reset away) from unique ones (migrate\n        first). This never raises; reporting must not break the refusal it\n        annotates.\n        \"\"\"\n        try:\n            log_result = run(\n                [\n                    \"git\",\n                    \"log\",\n                    \"--format=%h %s\",\n                    f\"{upstream}..HEAD\",\n                    \"--max-count\",\n                    str(max_commits + 1),\n                ],\n                cwd=repo_root,\n            )\n            cherry_result = run([\"git\", \"cherry\", upstream], cwd=repo_root)\n            if log_result.returncode != 0 or cherry_result.returncode != 0:\n                return \"\"\n            subjects = [line for line in log_result.stdout.splitlines() if line.strip()]\n            unique = sorted(\n                line[1:].strip()\n                for line in cherry_result.stdout.splitlines()\n                if line.startswith(\"+\")\n            )\n            listed = subjects[:max_commits]\n            lines = [\n                f\"Local commits not in `{upstream}`:\",\n                *[f\"- {subject}\" for subject in listed],\n            ]\n            if len(subjects) > max_commits:\n                lines.append(f\"- ... and {len(subjects) - max_commits} more\")\n            if not unique:\n                lines.append(\n                    f\"Every local commit already has a patch-equivalent commit in `{upstream}`,