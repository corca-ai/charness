  "findings": [
    {
      "id": "R-003",
      "severity": "medium",
      "summary": "The socket reachability claims are broader than the sandbox boundary.",
      "evidence": [
        "The release notes say a daemon on “any other socket path” and other host Unix sockets stay reachable; the docs similarly say other host Unix sockets stay reachable.",
        "In `sandbox_prefix`, the sandbox replaces `/tmp` with a private tmpfs and masks the entire `/run/user/<uid>` directory. Host sockets located under either path are therefore not reachable, even when they are not among the listed daemon socket paths."
      ],
      "action": "Qualify the reachability claims to exclude sockets under `/run/user/<uid>` and the replaced `/tmp`, as well as the explicitly masked daemon paths."
    }
  ],
  "counterweight_triage": [
    {
      "concern": "R-001: the home readability claim omits home `.env*` masks.",
      "bin": "resolved",
      "disposition": "The notes and docs now include home `.env*` files in the masks; `_credential_files` adds top-level home `.env*` files and `sandbox_prefix` masks them."
    },
    {
      "concern": "R-002: the OAuth fallback places a real token in the configured environment.",
      "bin": "resolved",
      "disposition": "`_run_executor_invocation` wraps each Claude invocation in `claude_auth_proxy`; the proxy removes real auth variables from the child environment and supplies a per-invocation placeholder."
    }
  ],
  "next_move": "Qualify the socket reachability sentences, then recheck those claims against the sandbox mounts.",
