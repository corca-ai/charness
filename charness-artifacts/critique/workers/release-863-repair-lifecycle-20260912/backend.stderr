  {
    "carrier_path": ".charness/scratch/critique-review/review-495690ab660833bfc740d2474fef144b/semantic-input/0001-content.bin",
    "carrier_sha256": "3d2bdfef615b0c3019c72694feb813ccfb8221fa366090aa5b22e44b4d4ed1f5",
    "content_sha256": "e40f52f526315c2414b2d15b4f43059f184d8f6ae8ba8e2fc2bd7e16926ffa74",
    "disposition": "present",
    "path": "skills/public/critique/scripts/run_review_carrier.py",
    "prompt_content": "\"\"\"Lifecycle and durable-path handling for one critique review carrier.\"\"\"\n\nfrom __future__ import annotations\n\nfrom pathlib import Path\nfrom typing import Any\n\nimport yaml\n\n\ndef refresh_manifest_integrity(\n    support: Any, storage: Any, root: Path, manifest_relative: str\n) -> dict[str, Any]:\n    \"\"\"Hash every promoted file after the final lifecycle bytes are written.\"\"\"\n    manifest = support.repo_path(\n        root, manifest_relative, label=\"promoted attempt manifest\", require_file=True\n    )\n    payload = support.load_mapping(manifest)\n    if not isinstance(payload, dict):\n        raise support.RunReviewError(\n            \"promotion-readback-failed\", \"promoted attempt manifest is not a mapping\"\n        )\n    files = payload.get(\"files\")\n    if not isinstance(files, dict):\n        raise support.RunReviewError(\n            \"promotion-readback-failed\", \"promoted attempt manifest has no file map\"\n        )\n    integrity: dict[str, dict[str, Any]] = {}\n    for name, relative in sorted(files.items()):\n        if not isinstance(name, str) or not isinstance(relative, str):\n            raise support.RunReviewError(\n                \"promotion-readback-failed\", \"promoted attempt manifest contains a malformed file\"\n            )\n        path = support.repo_path(root, relative, label=f\"promoted file {name}\", require_file=True)\n        integrity[name] = {\n            \"path\": relative,\n            \"bytes\": path.stat().st_size,\n            \"sha256\": support.sha256(path),\n        }\n    payload[\"file_integrity\"] = integrity\n    storage.write_json_atomically(manifest, payload)\n    readback = support.load_mapping(manifest)\n    if not isinstance(readback, dict) or readback.get(\"file_integrity\") != integrity:\n        raise support.RunReviewError(\n            \"promotion-readback-failed\", \"promoted attempt manifest integrity did not read back\"\n        )\n    return integrity\n\n\ndef write_promoted_yaml(\n    support: Any, storage: Any, root: Path, relative_path: str, payload: dict[str, Any]\n) -> None:\n    \"\"\"Atomically rewrite a promoted lifecycle carrier after path rebinding.\"\"\"\n    lexical_destination = root / relative_path\n    if lexical_destination.is_symlink():\n        raise support.RunReviewError(\n            \"stale-artifact-refused\",\n            f\"refusing to write through lifecycle symlink: {lexical_destination}\",\n        )\n    destination = lexical_destination.resolve()\n    try:\n        destination.relative_to(root.resolve())\n    except ValueError as exc:\n        raise support.RunReviewError(\n            \"path-invalid\", \"promoted lifecycle path escaped repository root\"\n        ) from exc\n    encoded = yaml.safe_dump(payload, allow_unicode=True, sort_keys=False).encode(\"utf-8\")\n    storage.write_bytes_atomically(destination, encoded)\n\n\ndef compare_report_stream(support: Any, stream_path: Path, report_path: Path) -> dict[str, Any]:\n    \"\"\"Record whether stdout and the durable report carry the same mapping.\"\"\"\n    stream = support.load_mapping(stream_path)\n    report = support.load_mapping(report_path)\n    if stream is None or report is None:\n        reason = \"runner stdout or canonical report is missing or unreadable\"\n        consistent = False\n    elif stream != report:\n        reason = \"runner stdout differs from the canonical report carrier\"\n        consistent = False\n    else:\n        reason = None\n        consistent = True\n    return {\n        \"consistent\": consistent,\n        \"reason\": reason,\n        \"runner_stdout_sha256\": support.sha256(stream_path) if stream_path.is_file() else None,\n        \"canonical_report_sha256\": support.sha256(report_path) if report_path.is_file() else None,\n    }\n\n\ndef failure_carrier(\n    packet_module: Any,\n    lifecycle: Any,\n    *,\n    scope: str,\n    lens: str,\n    error: str,\n    code: str,\n    details: dict[str, Any],\n) -> dict[str, Any]:\n    if lifecycle is None:\n        return {\n            \"schema_version\": \"charness.reviewer_lifecycle.v1\",\n            \"status\": \"runner-invalid\",\n            \"execution_state\": \"preflight-blocked\",\n            \"lifecycle_state\": \"preflight-blocked\",\n            \"reviewer_started\": False,\n            \"delivery_state\": \"none\",\n            \"verdict_state\": \"not-applicable\",\n            \"review_verdict\": None,\n            \"classification\": None,\n            \"approval_eligible\": False,\n            \"output\": {\"state\": \"none\", \"approval_eligible\": False, \"artifacts\": []},\n            \"output_state\": \"none\",\n            \"failure_identity\": None,\n            \"next_move\": \"repair the named preflight boundary and rerun; reviewer did not start\",\n            \"runner_returncode\": None,\n            \"runner_status\": \"runner-invalid\",\n            \"boundary_ok\": None,\n            \"boundary_reason\": None,\n            \"paths\": {},\n        }\n    carrier = lifecycle.build_lifecycle(\n        status=\"runner-invalid\", error=error, reviewer_started=False, paths={}\n    )\n    carrier.update(\n        {\n            \"ok\": False,\n            \"carrier_ok\": False,\n            \"reason_code\": code,\n            \"error\": error,\n            \"details\": details,\n            \"scope\": scope,\n            \"lens\": lens,\n        }\n    )\n    for field in packet_module.REFUSAL_DETAIL_FIELDS:\n        if field in details:\n            carrier[field] = details[field]\n    return carrier\n\n\ndef bind_promoted_paths(context: dict[str, Any], promoted: dict[str, str], promotion: Any) -> dict[str, str]:\n    \"\"\"Replace runtime-only paths with their durable receipt paths.\"\"\"\n    bound = context.setdefault(\"paths\", {})\n    old_paths = dict(bound)\n    for name, relative in promoted.items():\n        source_key = promotion.SOURCE_KEYS.get(name)\n        if source_key is not None:\n            bound[source_key] = relative\n    worker_report = promoted.get(\"worker-report.yaml\")\n    if worker_report is not None:\n        runtime_report = old_paths.get(\"report\")\n        if runtime_report is not None and runtime_report != worker_report:\n            bound[\"runtime_report\"] = runtime_report\n        bound[\"report\"] = worker_report\n        bound[\"durable_report\"] = worker_report\n    for name, source_key in promotion.LOG_SOURCE_KEYS.items():\n        relative = promoted.get(name)\n        if relative is not None:\n            bound[source_key] = relative\n    for key, value in list(bound.items()):\n        if isinstance(value, str) and Path(value).parts[:2] == (\".charness\", \"scratch\"):\n            bound.pop(key, None)\n    return bound\n\n\ndef rebind_partial_artifacts(\n    carrier: dict[str, Any], old_paths: dict[str, str], new_paths: dict[str, str], promotion: Any\n) -> None:\n    \"\"\"Keep lifecycle partial-output descriptors usable after scratch cleanup.\"\"\"\n    collections = [carrier.get(\"partial_outputs\")]\n    output = carrier.get(\"output\")\n    if isinstance(output, dict):\n        collections.extend((output.get(\"artifacts\"), output.get(\"partial_artifacts\")))\n    for collection in collections:\n        if not isinstance(collection, list):\n            continue\n        for descriptor in collection:\n            if not isinstance(descriptor, dict):\n                continue\n            path = descriptor.get(\"path\")\n            if not isinstance(path, str):\n                continue\n            for key in promotion.LOG_SOURCE_KEYS.values():\n                if path == old_paths.get(key) and key in new_paths:\n                    descriptor[\"path\"] = new_paths[key]\n                    break\n\n\ndef replace_exact_strings(value: Any, replacements: dict[str, str]) -> Any:\n    if isinstance(value, dict):\n        for key, nested in list(value.items()):\n            value[key] = replace_exact_strings(nested, replacements)\n        return value\n    if isinstance(value, list):\n        return [replace_exact_strings(item, replacements) for item in value]\n    if isinstance(value, str):\n        return replacements.get(value, value)\n    return value\n\n\ndef finalize_carrier(\n    support: Any,\n    promotion: Any,\n    root: Path,\n    promotion_attempt: str,\n    paths: dict[str, Path],\n    context: dict[str, Any],\n    carrier: dict[str, Any],\n    report: dict[str, Any] | None,\n    recovery_validation: dict[str, Any] | None = None,\n) -> None:\n    \"\"\"Promote all terminal bytes, then emit paths that survive owner cleanup.\"\"\"\n    old_paths = dict(context.setdefault(\"paths\", {}))\n    promoted = promotion.promote_attempt_metadata(\n        root,\n        promotion_attempt,\n        paths,\n        report,\n        finalize=True,\n        expected_identities={\n            \"packet_sha256\": context.get(\"packet_sha256\"),\n            \"reviewed_input_identity_sha256\": context.get(\"reviewed_input_identity_sha256\"),\n            \"parent_receipt_identity\": context.get(\"parent_receipt_identity\"),\n        },\n        final_carrier=carrier,\n        recovery_validation=recovery_validation,\n    )\n    semantic_replacements: dict[str, str] = {}\n    run_dir = paths.get(\"run_dir\")\n    source_dir = run_dir / \"semantic-input\" if run_dir is not None else None\n    if source_dir is not None and source_dir.is_dir():\n        for source in source_dir.rglob(\"*\"):\n            if not source.is_file() or source.is_symlink():\n                continue\n            relative = source.relative_to(source_dir)\n            promoted_key = f\"semantic-input/{relative.as_posix()}\"\n            durable = promoted.get(promoted_key)\n            if durable is not None:\n                semantic_replacements[support.relative(root, source)] = durable\n    if semantic_replacements:\n        carrier[\"semantic_input\"] = replace_exact_strings(\n            carrier.get(\"semantic_input\"), semantic_replacements\n        )\n    bound = bind_promoted_paths(context, promoted, promotion)\n    rebind_partial_artifacts(carrier, old_paths, bound, promotion)\n    carrier[\"paths\"] = dict(bound)\n    summary = promoted.get(\"lifecycle.yaml\")\n    if summary is not None:\n        write_promoted_yaml(support, promotion.STORAGE, root, summary, carrier)\n        saved_summary = support.load_mapping(root / summary)\n        if not isinstance(saved_summary, dict):\n            raise support.RunReviewError(\n                \"promotion-readback-failed\",\n                \"promoted lifecycle carrier could not be read back as a mapping\",\n            )\n        for key in (\n            \"schema_version\",\n            \"execution_state\",\n            \"lifecycle_state\",\n            \"delivery_state\",\n            \"approval_eligible\",\n            \"identity_check\",\n            \"runner_stream\",\n        ):\n            if key in carrier and saved_summary.get(key) != carrier.get(key):\n                raise support.RunReviewError(\n                    \"promotion-readback-failed\",\n                    f\"promoted lifecycle carrier changed at `{key}` during read-back\",\n                )\n    manifest_path = promoted.get(\"attempt-manifest.json\")\n    if manifest_path is not None:\n        promotion.refresh_manifest_integrity(root, manifest_path)\n    manifest = support.load_mapping(root / manifest_path) if manifest_path else None\n    if not isinstance(manifest, dict):\n        raise support.RunReviewError(\n            \"promotion-readback-failed\",\n            \"promoted reviewer attempt manifest could not be read back\",\n        )\n    approval, binding = promotion.approval_for(\n        report,\n        expected_identities={\n            \"packet_sha256\": context.get(\"packet_sha256\"),\n            \"reviewed_input_identity_sha256\": context.get(\"reviewed_input_identity_sha256\"),\n            \"parent_receipt_identity\": context.get(\"parent_receipt_identity\"),\n        },\n        final_carrier=carrier,\n    )\n    if approval is not (carrier.get(\"approval_eligible\") is True):\n        raise support.RunReviewError(\n            \"promotion-readback-failed\",\n            \"promoted reviewer manifest approval does not match the final lifecycle carrier\",\n        )\n    # This atomic replacement is the commit point. Every fallible lifecycle\n    # write and integrity readback above observes a non-approval manifest.\n    manifest.update(\n        approval_eligible=approval,\n        use_class=\"approval\" if approval else \"diagnostic-retryable\",\n        identity_binding=\"worker-report-bound\" if approval else \"consumer-required\",\n        identity_check=binding,\n    )\n    promotion.STORAGE.write_json_atomically(root / manifest_path, manifest)\n\n\ndef owner_terminal_state(status: str, carrier: dict[str, Any]) -> str:\n    \"\"\"Map reviewer execution state to the scratch owner's explicit terminal state.\"\"\"\n    delivery = carrier.get(\"delivery_state\")\n    if status == \"runner-timeout\" or delivery == \"timed-out\":\n        return \"timed-out\"\n    if status == \"runner-interrupted\" or delivery == \"interrupted\":\n        return \"cancelled\"\n    if carrier.get(\"execution_state\") == \"terminal\" and delivery == \"findings-received\":\n        return \"succeeded\"\n    return \"failed\"\n",
    "prompt_encoding": "utf-8",
    "size_bytes": 12771,
