  {
    "carrier_path": ".charness/scratch/critique-review/review-495690ab660833bfc740d2474fef144b/semantic-input/0003-content.bin",
    "carrier_sha256": "caebb52096dab1458fdd37613e26aee4055ae73f3d2a34211610a75ec54b3075",
    "content_sha256": "e1a59d702611954a5440a02e97448349980fe522c1142517da693904a9bd6ef5",
    "disposition": "present",
    "path": "skills/public/critique/scripts/run_review_hold_out.py",
    "prompt_content": "#!/usr/bin/env python3\n\"\"\"Hide named in-progress paths from a critique worker tree for one run.\"\"\"\n\nfrom __future__ import annotations\n\nimport shutil\nfrom collections.abc import Callable, Iterator\nfrom contextlib import contextmanager\nfrom pathlib import Path\n\ntry:\n    from scripts.runtime_scratch import owned_scratch\nexcept ImportError:  # direct file loading from an installed skill mirror\n    _repo_root = next(\n        ancestor\n        for ancestor in Path(__file__).resolve().parents\n        if (ancestor / \"scripts\" / \"runtime_scratch.py\").is_file()\n    )\n    import sys\n\n    if str(_repo_root) not in sys.path:\n        sys.path.insert(0, str(_repo_root))\n    from scripts.runtime_scratch import owned_scratch\n\n\n@contextmanager\ndef hold_out(\n    root: Path,\n    relative_paths: list[str],\n    *,\n    resolve_path: Callable[..., Path],\n    error_cls: type[Exception],\n) -> Iterator[None]:\n    owner = owned_scratch(root, \"critique-hold-out\")\n    with owner as staging_root:\n        staging = Path(staging_root)\n        moved: list[tuple[Path, Path]] = []\n        mappings: list[dict[str, str]] = []\n        try:\n            for index, value in enumerate(relative_paths):\n                src = resolve_path(root, value, label=\"hold-out path\")\n                if not src.exists():\n                    raise error_cls(\n                        \"hold-out-missing\",\n                        f\"hold-out path does not exist: {value}\",\n                        details={\"path\": value},\n                    )\n                dest = staging / f\"{index}-{src.name}\"\n                try:\n                    source_name = src.relative_to(root.resolve()).as_posix()\n                    staged_name = dest.relative_to(staging.resolve()).as_posix()\n                except ValueError as exc:\n                    raise error_cls(\n                        \"hold-out-invalid\",\n                        f\"hold-out path escaped its owner boundary: {value}\",\n                        details={\"path\": value},\n                    ) from exc\n                mapping = {\"source\": source_name, \"staged\": staged_name, \"state\": \"planned\"}\n                mappings.append(mapping)\n                # Record before the move: a process death between the move and\n                # the next receipt write must still leave enough information for\n                # the runtime registry to restore the source.\n                owner.update(hold_out_paths=mappings)\n                shutil.move(str(src), str(dest))\n                moved.append((src, dest))\n                mapping[\"state\"] = \"moved\"\n                owner.update(hold_out_paths=mappings)\n            yield\n        finally:\n            collisions = [\n                (src, dest)\n                for src, dest in moved\n                if dest.exists() and src.exists()\n            ]\n            if collisions:\n                # Never let the normal exit path delete the staging owner when\n                # a worker recreated a source path.  Keeping both copies is\n                # intentionally noisy; choosing one here would silently lose\n                # either the original or the worker's replacement.\n                for index, (src, dest) in enumerate(moved):\n                    if dest.exists() and src.exists():\n                        mappings[index][\"state\"] = \"collision\"\n                owner.retain_with(\n                    hold_out_paths=mappings,\n                    hold_out_recovery={\n                        \"status\": \"refused\",\n                        \"reason\": \"hold-out source and staged paths both exist\",\n                    },\n                )\n                src, dest = collisions[0]\n                raise error_cls(\n                    \"hold-out-collision\",\n                    \"hold-out cleanup refused because the worker recreated a source path\",\n                    details={\"source\": str(src), \"staged\": str(dest)},\n                )\n            for index, (src, dest) in reversed(list(enumerate(moved))):\n                if dest.exists() and not src.exists():\n                    try:\n                        shutil.move(str(dest), str(src))\n                        mappings[index][\"state\"] = \"restored\"\n                        owner.update(hold_out_paths=mappings)\n                    except BaseException:\n                        owner.retain_with(hold_out_paths=mappings)\n                        raise\n",
    "prompt_encoding": "utf-8",
    "size_bytes": 4370,
    "source": "working-tree:skills/public/critique/scripts/run_review_hold_out.py"
  },
  {
    "carrier_path": ".charness/scratch/critique-review/review-495690ab660833bfc740d2474fef144b/semantic-input/0004-content.bin",
    "carrier_sha256": "bc8a0fc212a13981a876401bafae6a7b0f031a219513ea85f12a0207ebed25a8",
    "content_sha256": "27d9ae13ffa0af5e9096c9bb08d592dd5177e479d445245a514d2226c34a4446",
    "disposition": "present",
    "path": "skills/public/critique/scripts/run_review_promotion.py",
    "prompt_content": "\"\"\"Promote a completed or failed reviewer carrier into visible knowledge.\"\"\"\n\nfrom __future__ import annotations\n\nimport hashlib\nimport importlib.util\nimport json\nimport sys\nfrom pathlib import Path\nfrom typing import Any\n\n\ndef _support() -> Any:\n    for name in (\"charness_run_review_support\", \"run_review_support\"):\n        module = sys.modules.get(name)\n        if module is not None:\n            return module\n    path = Path(__file__).with_name(\"run_review_support.py\")\n    spec = importlib.util.spec_from_file_location(\"charness_run_review_support\", path)\n    if spec is None or spec.loader is None:\n        raise RuntimeError(f\"cannot load run_review_support: {path}\")\n    module = importlib.util.module_from_spec(spec)\n    sys.modules[\"charness_run_review_support\"] = module\n    spec.loader.exec_module(module)\n    return module\n\n\nSUPPORT = _support()\nIDENTITY = SUPPORT.load_module(\n    Path(__file__).with_name(\"run_review_identity.py\"),\n    \"charness_run_review_identity\",\n)\nSTORAGE = SUPPORT.load_module(\n    Path(__file__).with_name(\"run_review_promotion_storage.py\"),\n    \"charness_run_review_promotion_storage\",\n)\nCARRIER = SUPPORT.load_module(\n    Path(__file__).with_name(\"run_review_carrier.py\"), \"charness_run_review_carrier\"\n)\nDURABLE_WORKER_REPORTS = STORAGE.DURABLE_WORKER_REPORTS\nPROMOTED_METADATA = STORAGE.PROMOTED_METADATA\nSOURCE_KEYS = STORAGE.SOURCE_KEYS\nLOG_SOURCE_KEYS = STORAGE.LOG_SOURCE_KEYS\nidentity_binding = IDENTITY.identity_binding\napproval_for = IDENTITY.approval_for\n\n\ndef promote_worker_report(root: Path, attempt: str, runtime_report: Path) -> Path | None:\n    return STORAGE.promote_worker_report(root, attempt, runtime_report)\n\n\ndef refresh_manifest_integrity(root: Path, manifest_relative: str) -> dict[str, Any]:\n    return CARRIER.refresh_manifest_integrity(SUPPORT, STORAGE, root, manifest_relative)\n\n\ndef promote_attempt_metadata(  # noqa: C901, PLR0915\n    root: Path,\n    attempt: str,\n    paths: dict[str, Path],\n    report: dict[str, Any] | None,\n    *,\n    finalize: bool = False,\n    expected_identities: dict[str, Any] | None = None,\n    final_carrier: dict[str, Any] | None = None,\n    recovery_validation: dict[str, Any] | None = None,\n) -> dict[str, str]:\n    \"\"\"Retain typed terminal metadata for both approval and retry paths.\n\n    Raw runner logs stay in the managed runtime and are referenced by the\n    lifecycle's partial-output descriptors. Small typed files are copied to the\n    durable attempt directory, with a manifest that explicitly says whether the\n    carrier is approval-eligible. A failed carrier can therefore be inspected or\n    retried after runtime GC without ever being mistaken for approval.\n    \"\"\"\n    lexical_dest_dir = root / DURABLE_WORKER_REPORTS / attempt\n    if lexical_dest_dir.is_symlink():\n        raise _support().RunReviewError(\n            \"stale-artifact-refused\",\n            f\"refusing to write through durable worker directory symlink: {lexical_dest_dir}\",\n        )\n    dest_dir = lexical_dest_dir.resolve()\n    try:\n        dest_dir.relative_to(root.resolve())\n    except ValueError as exc:\n        raise _support().RunReviewError(\n            \"path-invalid\", \"durable worker metadata directory escaped repository root\"\n        ) from exc\n    dest_dir.mkdir(parents=True, exist_ok=True)\n    promoted: dict[str, str] = {}\n    promoted.update(STORAGE.promote_semantic_inputs(root, paths, dest_dir))\n    pending_metadata: list[tuple[str, Path, Path]] = []\n    for name in PROMOTED_METADATA:\n        if name == \"worker-report.yaml\":\n            continue\n        source_key = SOURCE_KEYS.get(name)\n        source = paths.get(source_key) if source_key is not None else None\n        if source is None or not source.is_file():\n            continue\n        destination = dest_dir / name\n        promoted[name] = _support().relative(root, destination)\n        # Lifecycle is a derived projection, rewritten after durable paths\n        # are rebound. On retry its bytes may already be newer than scratch.\n        if name == \"lifecycle.yaml\" and finalize and destination.is_file():\n            continue\n        pending_metadata.append((name, source, destination))\n    logs: dict[str, dict[str, Any]] = {}\n    for name, source_key in LOG_SOURCE_KEYS.items():\n        source = paths.get(source_key)\n        if source is None or not source.is_file() or source.stat().st_size == 0:\n            continue\n        destination = dest_dir / name\n        logs[name] = STORAGE.promote_log(root, source, destination)\n        promoted[name] = logs[name][\"path\"]\n    report_source = paths.get(\"report\")\n    if report_source is not None and report_source.is_file():\n        report_destination = dest_dir / \"worker-report.yaml\"\n        durable_report = _support().relative(root, report_destination)\n        promoted[\"worker-report.yaml\"] = durable_report\n        pending_metadata.append((\"worker-report.yaml\", report_source, report_destination))\n    replacements = STORAGE.report_path_replacements(paths, promoted)\n    # Runtime reports normally carry repository-relative paths.  The storage\n    # helper also accepts absolute path spellings, but recovery must rebind both\n    # forms before validating the promoted chain.\n    for name, source_key in {**SOURCE_KEYS, **LOG_SOURCE_KEYS}.items():\n        source = paths.get(source_key)\n        durable = promoted.get(name)\n        if source is not None and durable is not None:\n            replacements[_support().relative(root, source)] = durable\n    report_source = paths.get(\"report\")\n    durable_report = promoted.get(\"worker-report.yaml\")\n    if report_source is not None and durable_report is not None:\n        replacements[_support().relative(root, report_source)] = durable_report\n    replacements.update(STORAGE.semantic_path_replacements(root, paths, promoted))\n    for name, source, destination in pending_metadata:\n        payload = source.read_bytes()\n        if name in {\n            \"worker-report.yaml\",\n            \"review-prompt.md\",\n            \"run-plan.json\",\n            \"lifecycle.yaml\",\n            \"receipt.json\",\n            \"delivery.json\",\n        }:\n            payload = STORAGE.rewrite_path_references(payload, replacements)\n        if name == \"receipt.json\" and destination.is_file():\n            # The first promotion may add a durable partial-output descriptor\n            # to the receipt.  A later lifecycle finalization re-reads the\n            # original scratch receipt; preserve that immutable join instead\n            # of treating the intentional enrichment as stale metadata.\n            try:\n                candidate_receipt = json.loads(payload.decode(\"utf-8\"))\n                existing_receipt = SUPPORT.load_mapping(destination)\n            except (UnicodeDecodeError, json.JSONDecodeError, OSError):\n                candidate_receipt = None\n                existing_receipt = None\n            if (\n                isinstance(candidate_receipt, dict)\n                and isinstance(existing_receipt, dict)\n                and \"retained_partial_output\" not in candidate_receipt\n                and isinstance(existing_receipt.get(\"retained_partial_output\"), dict)\n            ):\n                candidate_receipt[\"retained_partial_output\"] = existing_receipt[\n                    \"retained_partial_output\"\n                ]\n                payload = (\n                    json.dumps(candidate_receipt, ensure_ascii=False, indent=2, sort_keys=True)\n                    + \"\\n\"\n                ).encode(\"utf-8\")\n        STORAGE.write_or_verify(destination, payload)\n    partial_diagnostics: dict[str, Any] = {}\n    partial = STORAGE.extract_partial_review(\n        paths,\n        report,\n        partial_diagnostics,\n        expected_identities=expected_identities,\n    )\n    partial_descriptor: dict[str, Any] | None = None\n    if partial is not None:\n        candidate, source, validation = partial\n        partial_path = dest_dir / \"partial-result.json\"\n        if partial_path.is_symlink():\n            raise _support().RunReviewError(\n                \"stale-artifact-refused\",\n                f\"refusing to overwrite durable partial reviewer result: {partial_path}\",\n            )\n        if partial_path.exists():\n            try:\n                existing_partial = json.loads(partial_path.read_text(encoding=\"utf-8\"))\n            except (OSError, json.JSONDecodeError) as exc:\n                raise _support().RunReviewError(\n                    \"stale-artifact-refused\",\n                    f\"existing durable partial reviewer result is unreadable: {partial_path}\",\n                ) from exc\n            if existing_partial != candidate:\n                raise _support().RunReviewError(\n                    \"stale-artifact-refused\",\n                    f\"refusing to overwrite durable partial reviewer result: {partial_path}\",\n                )\n        else:\n            STORAGE.write_json_atomically(partial_path, candidate)\n        partial_bytes = partial_path.read_bytes()\n        partial_descriptor = {\n            \"schema_version\": \"charness.reviewer_partial_output/v1\",\n            \"kind\": \"bounded-review-result\",\n            \"path\": _support().relative(root, partial_path),\n            \"source\": next(\n                (\n                    promoted[name]\n                    for name, source_key in LOG_SOURCE_KEYS.items()\n                    if paths.get(source_key) == source and name in promoted\n                ),\n                _support().relative(root, source),\n            ),\n            \"bytes\": len(partial_bytes),\n            \"sha256\": hashlib.sha256(partial_bytes).hexdigest(),\n            \"validation\": validation,\n            \"approval_eligible\": False,\n        }\n        promoted[\"partial-result.json\"] = partial_descriptor[\"path\"]\n        retained_receipt = dest_dir / \"receipt.json\"\n        if retained_receipt.is_file() and not retained_receipt.is_symlink():\n            receipt_payload = SUPPORT.load_mapping(retained_receipt)\n            if isinstance(receipt_payload, dict):\n                receipt_payload[\"retained_partial_output\"] = partial_descriptor\n                STORAGE.write_json_atomically(retained_receipt, receipt_payload)\n    manifest = dest_dir / \"attempt-manifest.json\"\n    if manifest.is_symlink():\n        raise _support().RunReviewError(\n            \"stale-artifact-refused\",\n            f\"refusing to overwrite durable reviewer attempt manifest: {manifest}\",\n        )\n    existing_manifest: dict[str, Any] = {}\n    if manifest.exists():\n        if not finalize:\n            raise _support().RunReviewError(\n                \"stale-artifact-refused\",\n                f\"refusing to overwrite durable reviewer attempt manifest: {manifest}\",\n            )\n        try:\n            loaded_manifest = json.loads(manifest.read_text(encoding=\"utf-8\"))\n        except (OSError, json.JSONDecodeError) as exc:\n            raise _support().RunReviewError(\n                \"stale-artifact-refused\",\n                f\"existing durable reviewer attempt manifest is unreadable: {manifest}\",\n            ) from exc\n        if not isinstance(loaded_manifest, dict) or loaded_manifest.get(\"attempt_id\") != attempt:\n            raise _support().RunReviewError(\n                \"stale-artifact-refused\",\n                f\"existing durable reviewer attempt identity does not match: {manifest}\",\n            )\n        existing_manifest = loaded_manifest\n    previous_files = existing_manifest.get(\"files\")\n    previous_logs = existing_manifest.get(\"logs\")\n    merged_files = dict(previous_files) if isinstance(previous_files, dict) else {}\n    merged_files.update(promoted)\n    merged_logs = dict(previous_logs) if isinstance(previous_logs, dict) else {}\n    merged_logs.update(logs)\n    retained_partial = partial_descriptor\n    if retained_partial is None:\n        prior_partial = existing_manifest.get(\"partial_result\")\n        if isinstance(prior_partial, dict):\n            retained_partial = prior_partial\n    if report is not None:\n        approval_eligible, binding = approval_for(\n            report,\n            expected_identities=expected_identities,\n            final_carrier=None,  # Finalizer alone seals approval after readback.\n        )\n    else:\n        approval_eligible = False\n        binding = {\n            \"status\": \"unavailable\",\n            \"matches\": False,\n            \"checks\": {},\n            \"reason\": \"worker report unavailable\",\n        }\n    prior_unavailable = existing_manifest.get(\"partial_result_unavailable\")\n    partial_unavailable = None if partial is not None else partial_diagnostics\n    manifest_payload = {\n        \"schema_version\": \"charness.reviewer_attempt_manifest.v1\",\n        \"attempt_id\": attempt,\n        \"reusable\": True,\n        \"approval_eligible\": approval_eligible,\n        \"use_class\": \"approval\" if approval_eligible else \"diagnostic-retryable\",\n        \"packet_identity\": (\n            report.get(\"packet_identity\") if report is not None\n            else existing_manifest.get(\"packet_identity\")\n            or (expected_identities or {}).get(\"packet_sha256\")\n        ),\n        \"reviewed_input_identity\": (\n            report.get(\"reviewed_input_identity\") if report is not None\n            else existing_manifest.get(\"reviewed_input_identity\")\n            or (expected_identities or {}).get(\"reviewed_input_identity_sha256\")\n        ),\n        \"identity_binding\": \"worker-report-bound\" if approval_eligible else \"consumer-required\",\n        \"identity_check\": binding,\n        \"delivery_state\": (\n            report.get(\"delivery_state\") if report is not None\n            else existing_manifest.get(\"delivery_state\", \"unknown\")\n        ),\n        \"review_verdict\": (\n            report.get(\"review_verdict\") if report is not None\n            else existing_manifest.get(\"review_verdict\")\n        ),\n        \"reason\": (\n            report.get(\"reason\") if report is not None\n            else existing_manifest.get(\"reason\", \"worker report unavailable\")\n        ),\n        \"files\": merged_files,\n        \"logs\": merged_logs,\n        \"partial_result\": retained_partial,\n        \"partial_result_unavailable\": partial_unavailable or prior_unavailable,\n        \"recovery_validation\": (\n            recovery_validation\n            if recovery_validation is not None\n            else existing_manifest.get(\"recovery_validation\")\n        ),\n    }\n    STORAGE.write_json_atomically(manifest, manifest_payload)\n    promoted[\"attempt-manifest.json\"] = _support().relative(root, manifest)\n    refresh_manifest_integrity(root, promoted[\"attempt-manifest.json\"])\n    return promoted\n\n\ndef load_and_promote_report(\n    root: Path, attempt: str, paths: dict[str, Path], context: dict[str, Any]\n) -> dict[str, Any] | None:\n    support = _support()\n    report_path = paths.get(\"report\")\n    report = support.load_mapping(report_path) if report_path is not None else None\n    promoted = promote_attempt_metadata(\n        root,\n        attempt,\n        paths,\n        report,\n        expected_identities={\n            \"packet_sha256\": context.get(\"packet_sha256\"),\n            \"reviewed_input_identity_sha256\": context.get(\"reviewed_input_identity_sha256\"),\n            \"parent_receipt_identity\": context.get(\"parent_receipt_identity\"),\n        },\n    )\n    context[\"paths\"].update(promoted)\n    durable = promoted.get(\"worker-report.yaml\")\n    if durable is not None:\n        cited = durable\n        context[\"paths\"][\"runtime_report\"] = context[\"paths\"][\"report\"]\n        context[\"paths\"][\"report\"] = cited\n        context[\"paths\"][\"durable_report\"] = cited\n        partial_path = promoted.get(\"partial-result.json\")\n        if partial_path is not None and isinstance(report, dict):\n            report = dict(report)\n            partial_file = root / partial_path\n            partial_bytes = partial_file.read_bytes()\n            report[\"partial_output\"] = {\n                \"schema_version\": \"charness.reviewer_partial_output/v1\",\n                \"kind\": \"bounded-review-result\",\n                \"path\": partial_path,\n                \"bytes\": len(partial_bytes),\n                \"sha256\": hashlib.sha256(partial_bytes).hexdigest(),\n            }\n            report[\"partial_output_ok\"] = True\n            report[\"partial_output_reason\"] = (\n                \"matching bounded-review JSON preserved from runner logs\"\n            )\n        elif isinstance(report, dict) and (\n            report.get(\"delivery_state\") != \"findings-received\"\n            or report.get(\"approval_eligible\") is not True\n        ):\n            manifest = root / promoted[\"attempt-manifest.json\"]\n            try:\n                manifest_payload = json.loads(manifest.read_text(encoding=\"utf-8\"))\n            except (OSError, json.JSONDecodeError):\n                manifest_payload = {}\n            unavailable = manifest_payload.get(\"partial_result_unavailable\")\n            if isinstance(unavailable, dict):\n                report = dict(report)\n                report[\"partial_output_ok\"] = False\n                report[\"partial_output\"] = unavailable\n                report[\"partial_output_reason\"] = unavailable.get(\"reason\")\n    return report\n",
    "prompt_encoding": "utf-8",
