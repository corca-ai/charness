        encoding="utf-8",
    )
    context = {
        "paths": {"report": ".charness/reviewer-round-foreign/worker-report.yaml"},
        "packet_sha256": "packet-b",
        "reviewed_input_identity_sha256": "input-a",
        "parent_receipt_identity": "parent-a",
    }

    promotion.load_and_promote_report(tmp_path, "foreign", {"report": report}, context)
    manifest = json.loads(
