"""How the critique runner spells a DECLARED reviewed path.

Separate from the identity tests, which own what a path BINDS. This owns the step
before: turning a manifest line into the name the packet declares. The two must
agree, and they did not — the runner refused symlinks the identity had just been
taught to bind, then renamed the ones it allowed.
"""
from __future__ import annotations

import importlib.util
import json
import sys
from pathlib import Path

import pytest

from tests.module_eviction import evict_module

ROOT = Path(__file__).resolve().parent.parent


def _support():
    spec = importlib.util.spec_from_file_location(
        "run_review_support", ROOT / "skills/public/critique/scripts/run_review_support.py"
    )
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


def _promotion():
    if "run_review_support" not in sys.modules:
        _support()
    spec = importlib.util.spec_from_file_location(
        "run_review_promotion", ROOT / "skills/public/critique/scripts/run_review_promotion.py"
    )
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


def _pointer_repo(tmp_path: Path) -> Path:
    records = tmp_path / "charness-artifacts" / "quality"
    records.mkdir(parents=True)
    (records / "2026-08-30-record.md").write_text("# Record\n", encoding="utf-8")
    (records / "latest.md").symlink_to("2026-08-30-record.md")
    return tmp_path


def test_a_declared_current_pointer_keeps_its_own_name(tmp_path: Path) -> None:
    """`.resolve()` renamed the pointer to the record it points at.

    The declared set then carried the target while the reviewed range carried the
    pointer, so `changed-ref-path-mismatch` fired forever on any range that
    touched a `latest.md` — which is every range that files a record.
    """
    support = _support()
    root = _pointer_repo(tmp_path)

    resolved = support.repo_path(
        root, "charness-artifacts/quality/latest.md", label="reviewed path", allow_symlink=True
    )

    assert support.relative(root, resolved) == "charness-artifacts/quality/latest.md"


def test_hold_out_hides_the_path_during_the_run_and_restores_it(tmp_path: Path) -> None:
    support = _support()
    target = tmp_path / "in-progress.md"
    target.write_text("TODO\n", encoding="utf-8")
    seen_inside: list[bool] = []

    with support.hold_out(tmp_path, ["in-progress.md"]):
        seen_inside.append(target.exists())

    assert seen_inside == [False]
    assert target.read_text(encoding="utf-8") == "TODO\n"


def test_hold_out_refuses_a_missing_path(tmp_path: Path) -> None:
    support = _support()
    with pytest.raises(support.RunReviewError, match="hold-out path does not exist"):
        with support.hold_out(tmp_path, ["gone.md"]):
            pass


def test_hold_out_restores_the_path_after_a_failed_run(tmp_path: Path) -> None:
    support = _support()
    target = tmp_path / "in-progress.md"
    target.write_text("TODO\n", encoding="utf-8")

    with pytest.raises(RuntimeError, match="boom"):
        with support.hold_out(tmp_path, ["in-progress.md"]):
            raise RuntimeError("boom")

    assert target.read_text(encoding="utf-8") == "TODO\n"


def test_hold_out_retains_both_copies_when_the_worker_recreates_source(tmp_path: Path) -> None:
    support = _support()
    target = tmp_path / "in-progress.md"
    target.write_text("original\n", encoding="utf-8")

    with pytest.raises(support.RunReviewError, match="recreated a source path"):
        with support.hold_out(tmp_path, ["in-progress.md"]):
            target.write_text("replacement\n", encoding="utf-8")

    assert target.read_text(encoding="utf-8") == "replacement\n"
    from scripts.runtime_bootstrap import runtime_root

    staged = list((runtime_root(tmp_path) / "scratch" / "critique-hold-out").glob("*/0-in-progress.md"))
    assert len(staged) == 1
    assert staged[0].read_text(encoding="utf-8") == "original\n"


def test_new_run_owner_is_repo_relative_and_cleans_terminal_scratch(tmp_path: Path) -> None:
    support = _support()
    owner = support.new_run_owner(tmp_path, "attempt:with-colon")

    assert owner.path.is_dir()
    assert owner.path.is_relative_to(tmp_path / ".charness" / "scratch")
    assert (owner.path / ".charness-owner.json").is_file()
    owner.close(state="failed")

    assert not owner.path.exists()


def test_hold_out_keeps_original_when_restore_io_fails(tmp_path: Path, monkeypatch) -> None:
    import shutil
    from scripts.runtime_bootstrap import runtime_root

    support = _support()
    target = tmp_path / "in-progress.md"
    target.write_text("original\n", encoding="utf-8")
    move = shutil.move

    def fail_restore(src, dst):
        if Path(dst) == target:
            raise OSError("restore unavailable")
        return move(src, dst)

    monkeypatch.setattr(shutil, "move", fail_restore)
    with pytest.raises(OSError, match="restore unavailable"):
        with support.hold_out(tmp_path, ["in-progress.md"]):
            pass
    staged = list((runtime_root(tmp_path) / "scratch" / "critique-hold-out").glob("*/0-in-progress.md"))
    assert len(staged) == 1
    assert staged[0].read_text() == "original\n"
    receipt = json.loads((staged[0].parent / ".charness-owner.json").read_text())
    assert receipt["retention"] == "retained-evidence"
    assert receipt["hold_out_paths"][0]["source"] == "in-progress.md"


@pytest.mark.parametrize("fail_at", [1, 2])
def test_final_promotion_failure_never_approves_and_can_retry(tmp_path: Path, monkeypatch, fail_at) -> None:
    promotion = _promotion()
    support, carrier_module = promotion.SUPPORT, promotion.CARRIER
    runtime = tmp_path / ".charness" / "run"
    runtime.mkdir(parents=True)
    expected = {"packet_sha256": "packet", "reviewed_input_identity_sha256": "input", "parent_receipt_identity": "parent"}
    report = {
        "schema_version": "charness.reviewer_worker_report.v1", "delivery_state": "findings-received",
        "review_verdict": "pass", "approval_eligible": True,
        "packet_identity": "packet", "reviewed_input_identity": "input", "parent_receipt_identity": "parent",
    }
    final = {
        "schema_version": "charness.reviewer_lifecycle.v1", "execution_state": "terminal",
        "lifecycle_state": "terminal", "delivery_state": "findings-received", "verdict_state": "pass",
        "ok": True, "carrier_ok": True, "approval_eligible": True,
        "output": {"state": "terminal", "approval_eligible": True},
        "identity_check": {"matches": True}, "runner_stream": {"consistent": True},
    }
    paths = {"report": runtime / "report.yaml", "summary": runtime / "lifecycle.yaml"}
    support.write_yaml(paths["report"], report)
    support.write_yaml(paths["summary"], final)
    context = {**expected, "paths": {key: support.relative(tmp_path, value) for key, value in paths.items()}}
    refresh = carrier_module.refresh_manifest_integrity
    calls = 0

    def fail_refresh(*args):
        nonlocal calls
        calls += 1
        if calls == fail_at:
            raise OSError("integrity unavailable")
        return refresh(*args)

    monkeypatch.setattr(carrier_module, "refresh_manifest_integrity", fail_refresh)
    with pytest.raises(OSError, match="integrity unavailable"):
        carrier_module.finalize_carrier(support, promotion, tmp_path, "retry", paths, context, final, report)
    manifest_path = tmp_path / promotion.DURABLE_WORKER_REPORTS / "retry" / "attempt-manifest.json"
    assert json.loads(manifest_path.read_text())["approval_eligible"] is False
    monkeypatch.setattr(carrier_module, "refresh_manifest_integrity", refresh)
    carrier_module.finalize_carrier(support, promotion, tmp_path, "retry", paths, context, final, report)
    manifest = json.loads(manifest_path.read_text())
    assert manifest["approval_eligible"] is True
    for name, descriptor in manifest["file_integrity"].items():
        assert descriptor["sha256"] == support.sha256(tmp_path / manifest["files"][name])


def test_promote_worker_report_copies_the_combined_report_atomically(tmp_path: Path) -> None:
    promotion = _promotion()
    runtime = tmp_path / ".charness" / "reviewer-round-attempt-1"
    runtime.mkdir(parents=True)
    (runtime / "worker-report.yaml").write_text("schema_version: charness.reviewer_worker_report.v1\n", encoding="utf-8")
    (runtime / "runner.stderr").write_text("noise\n", encoding="utf-8")

    dest = promotion.promote_worker_report(tmp_path, "attempt-1", runtime / "worker-report.yaml")

    assert dest == tmp_path / "charness-artifacts" / "critique" / "workers" / "attempt-1" / "worker-report.yaml"
    assert dest.read_text(encoding="utf-8") == "schema_version: charness.reviewer_worker_report.v1\n"
    assert not (dest.parent / "runner.stderr").exists()
    assert promotion.promote_worker_report(tmp_path, "attempt-1", runtime / "missing.yaml") is None
    with pytest.raises(ValueError, match="overwrite existing durable worker report"):
        promotion.promote_worker_report(tmp_path, "attempt-1", runtime / "worker-report.yaml")


def test_load_and_promote_report_rewrites_the_emitted_report_path(tmp_path: Path) -> None:
    promotion = _promotion()
    runtime = tmp_path / ".charness" / "reviewer-round-ok"
    runtime.mkdir(parents=True)
    report = runtime / "worker-report.yaml"
    report.write_text("schema_version: v1\napproval_eligible: true\n", encoding="utf-8")
    paths = {"report": report}
    context = {"paths": {"report": ".charness/reviewer-round-ok/worker-report.yaml"}}

    loaded = promotion.load_and_promote_report(tmp_path, "ok", paths, context)

    assert loaded is not None and loaded["approval_eligible"] is True
    cited = "charness-artifacts/critique/workers/ok/worker-report.yaml"
    assert context["paths"]["report"] == cited
    assert context["paths"]["durable_report"] == cited
    assert context["paths"]["runtime_report"] == ".charness/reviewer-round-ok/worker-report.yaml"


def test_load_and_promote_report_retains_a_non_approval_report_for_retry(tmp_path: Path) -> None:
    promotion = _promotion()
    runtime = tmp_path / ".charness" / "reviewer-round-no"
    runtime.mkdir(parents=True)
    report = runtime / "worker-report.yaml"
    report.write_text("schema_version: v1\napproval_eligible: false\n", encoding="utf-8")
    context = {"paths": {"report": ".charness/reviewer-round-no/worker-report.yaml"}}

    promotion.load_and_promote_report(tmp_path, "no", {"report": report}, context)

    assert context["paths"]["report"] == "charness-artifacts/critique/workers/no/worker-report.yaml"
    assert context["paths"]["durable_report"] == "charness-artifacts/critique/workers/no/worker-report.yaml"
    manifest = tmp_path / "charness-artifacts" / "critique" / "workers" / "no" / "attempt-manifest.json"
    assert json.loads(manifest.read_text(encoding="utf-8"))["use_class"] == "diagnostic-retryable"
    assert json.loads(manifest.read_text(encoding="utf-8"))["reusable"] is True


def test_report_only_promotion_cannot_advertise_approval_without_final_carrier(tmp_path: Path) -> None:
    promotion = _promotion()
    runtime = tmp_path / ".charness" / "reviewer-round-report-only"
    runtime.mkdir(parents=True)
    report = runtime / "worker-report.yaml"
    report.write_text(
        "schema_version: charness.reviewer_worker_report.v1\n"
        "delivery_state: findings-received\nreview_verdict: pass\n"
        "approval_eligible: true\npacket_identity: packet-a\n"
        "reviewed_input_identity: input-a\nparent_receipt_identity: parent-a\n",
        encoding="utf-8",
    )
    context = {
        "paths": {"report": ".charness/reviewer-round-report-only/worker-report.yaml"},
        "packet_sha256": "packet-a",
        "reviewed_input_identity_sha256": "input-a",
        "parent_receipt_identity": "parent-a",
    }

    promotion.load_and_promote_report(tmp_path, "report-only", {"report": report}, context)

    manifest = tmp_path / "charness-artifacts" / "critique" / "workers" / "report-only" / "attempt-manifest.json"
    saved = json.loads(manifest.read_text(encoding="utf-8"))
    assert saved["approval_eligible"] is False
    assert saved["use_class"] == "diagnostic-retryable"


def test_load_and_promote_report_keeps_matching_partial_review_json(tmp_path: Path) -> None:
    promotion = _promotion()
    runtime = tmp_path / ".charness" / "reviewer-round-partial"
    runtime.mkdir(parents=True)
    packet = "a" * 64
    reviewed = "b" * 64
    report = runtime / "worker-report.yaml"
    report.write_text(
        f"delivery_state: timed-out\npacket_identity: {packet}\n"
        f"reviewed_input_identity: {reviewed}\napproval_eligible: false\n",
        encoding="utf-8",
    )
    (runtime / "runner.stderr").write_text(
        json.dumps(
            {
                "kind": "charness.bounded_review.v1",
                "lens": "causal",
                "packet_sha256": packet,
                "reviewed_input_identity_sha256": reviewed,
                "verdict": "defer",
                "findings": [],
                "counterweight_triage": [],
                "next_move": "retry",
                "non_claims": ["not approval"],
            }
        )
        + "\n",
        encoding="utf-8",
    )
    context = {"paths": {"report": ".charness/reviewer-round-partial/worker-report.yaml"}}

    loaded = promotion.load_and_promote_report(
        tmp_path,
        "partial",
        {"report": report, "runner_stderr": runtime / "runner.stderr"},
        context,
    )

    assert loaded is not None
    assert loaded["partial_output_ok"] is True
    partial = tmp_path / "charness-artifacts" / "critique" / "workers" / "partial" / "partial-result.json"
    assert json.loads(partial.read_text(encoding="utf-8"))["verdict"] == "defer"
    manifest = json.loads(
        (partial.parent / "attempt-manifest.json").read_text(encoding="utf-8")
    )
    assert manifest["partial_result"]["approval_eligible"] is False
    assert manifest["partial_result"]["validation"] == "model-shaped"
    assert manifest["packet_identity"] == packet
    assert manifest["reviewed_input_identity"] == reviewed
    durable_log = partial.parent / "runner.stderr"
    assert durable_log.is_file()
    assert manifest["logs"]["runner.stderr"]["path"].endswith("/runner.stderr")


def test_failed_carrier_without_report_keeps_logs_but_not_unbound_review_json(
    tmp_path: Path,
) -> None:
    promotion = _promotion()
    runtime = tmp_path / ".charness" / "reviewer-round-no-report"
    runtime.mkdir(parents=True)
    (runtime / "runner.stderr").write_text(
        '{"kind":"charness.bounded_review.v1","verdict":"pass"}\n',
        encoding="utf-8",
    )
    context = {"paths": {"report": ".charness/reviewer-round-no-report/worker-report.yaml"}}

    loaded = promotion.load_and_promote_report(
        tmp_path,
        "no-report",
        {"report": runtime / "worker-report.yaml", "runner_stderr": runtime / "runner.stderr"},
        context,
    )

    assert loaded is None
    durable = tmp_path / "charness-artifacts" / "critique" / "workers" / "no-report"
    manifest = json.loads((durable / "attempt-manifest.json").read_text(encoding="utf-8"))
    assert manifest["approval_eligible"] is False
    assert manifest["use_class"] == "diagnostic-retryable"
    assert manifest["partial_result"] is None
    assert (durable / "runner.stderr").is_file()


def test_partial_review_is_retained_when_the_canonical_report_is_missing(tmp_path: Path) -> None:
    promotion = _promotion()
    runtime = tmp_path / ".charness" / "reviewer-round-missing-report"
    runtime.mkdir(parents=True)
    packet = "q" * 64
    reviewed = "r" * 64
    result = {
        "kind": "charness.bounded_review.v1",
        "lens": "missing-report",
        "packet_sha256": packet,
        "reviewed_input_identity_sha256": reviewed,
        "verdict": "defer",
        "findings": [],
        "counterweight_triage": [],
        "next_move": "retry",
        "non_claims": ["not approval"],
    }
    (runtime / "runner.stderr").write_text(json.dumps(result) + "\n", encoding="utf-8")
    context = {
        "paths": {"report": ".charness/reviewer-round-missing-report/worker-report.yaml"},
        "packet_sha256": packet,
        "reviewed_input_identity_sha256": reviewed,
        "parent_receipt_identity": "parent-missing-report",
    }

    loaded = promotion.load_and_promote_report(
        tmp_path,
        "missing-report",
        {"report": runtime / "worker-report.yaml", "runner_stderr": runtime / "runner.stderr"},
        context,
    )

    assert loaded is None
    durable = tmp_path / "charness-artifacts" / "critique" / "workers" / "missing-report"
    partial = json.loads((durable / "partial-result.json").read_text(encoding="utf-8"))
    assert partial["packet_sha256"] == packet
    manifest = json.loads((durable / "attempt-manifest.json").read_text(encoding="utf-8"))
    assert manifest["packet_identity"] == packet
    assert manifest["reviewed_input_identity"] == reviewed
    assert manifest["partial_result"]["approval_eligible"] is False
    assert manifest["partial_result"]["validation"] == "model-shaped"


def test_partial_review_extractor_keeps_late_pretty_printed_identity_match(tmp_path: Path) -> None:
    promotion = _promotion()
    runtime = tmp_path / ".charness" / "reviewer-round-late"
    runtime.mkdir(parents=True)
    packet = "p" * 64
    reviewed = "i" * 64
    report = runtime / "worker-report.yaml"
    report.write_text(
        f"delivery_state: timed-out\npacket_identity: {packet}\n"
        f"reviewed_input_identity: {reviewed}\nparent_receipt_identity: parent-1\n"
        "approval_eligible: false\n",
        encoding="utf-8",
    )
    result = {
        "kind": "charness.bounded_review.v1",
        "lens": "late",
        "packet_sha256": packet,
        "reviewed_input_identity_sha256": reviewed,
        "verdict": "defer",
        "findings": [],
        "counterweight_triage": [],
        "next_move": "retry",
        "non_claims": ["not approval"],
        "capability_non_claims": [],
        "capability_non_claims_sha256": "d" * 64,
    }
    (runtime / "runner.stderr").write_text(
        "x" * (9 * 1024 * 1024) + "\n" + json.dumps(result, indent=2),
        encoding="utf-8",
    )

    context = {
        "paths": {"report": ".charness/reviewer-round-late/worker-report.yaml"},
        "packet_sha256": packet,
        "reviewed_input_identity_sha256": reviewed,
        "parent_receipt_identity": "parent-1",
    }
    loaded = promotion.load_and_promote_report(
        tmp_path,
        "late",
        {"report": report, "runner_stderr": runtime / "runner.stderr"},
        context,
    )

    assert loaded is not None and loaded["partial_output_ok"] is True
    partial = (
        tmp_path
        / "charness-artifacts"
        / "critique"
        / "workers"
        / "late"
        / "partial-result.json"
    )
    assert json.loads(partial.read_text(encoding="utf-8"))["next_move"] == "retry"


