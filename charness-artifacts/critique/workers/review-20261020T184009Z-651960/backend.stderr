    "carrier_path": "/home/hwidong/.cache/tmp/charness/runtime/811b9f8f8a808bfa/scratch/critique-review/review-83f8fe0777631e98e63a4c8e6ea73619/semantic-input/0002-content.bin",
    "carrier_sha256": "720699675dda8ced9bea455a4cf83d3fa5f8c9bb9275854d9f192ac7801778d2",
