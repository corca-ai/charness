    "carrier_path": ".charness/scratch/critique-review/review-7853dfbf270a729b74fac2cb33fb23d7/semantic-input/0001-content.bin",
    "carrier_sha256": "287efd2815eeec0659ea3a84607ee3e3c2e289f9e57295b8bc5a1bfdd6edc978",
