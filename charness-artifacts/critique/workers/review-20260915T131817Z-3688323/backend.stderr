    "prompt_content": "{\n  \"schema_version\": \"charness.prepush-quality-receipt.v1\",\n  \"status\": \"pass\",\n  \"scope\": \"release-full-superset\",\n  \"repo_root\": \"/home/hwidong/codes/charness\",\n  \"verified_head\": \"5d4d59eff391eadecc079e9099432c308c4b4071\",\n  \"verified_tree\": \"174686ee53f1e145cca4afd0efb3ca6deb8ca56b\",\n  \"quality_command\": \"./scripts/run-quality.sh --release --read-only\",\n  \"semantic_receipt_sha256\": \"4711acdd342dcb138149536663048b90cf2e6f8899e4d8775f814360c5836ee6\",\n  \"semantic_measured_scope\": [\n    \"pytest-release\",\n    \"validate-quality-reference-catalog\",\n    \"quality-tool-fixtures\",\n    \"validate-surfaces\",\n    \"validate-public-skill-validation\",\n    \"validate-public-skill-dogfood\",\n    \"validate-profiles\",\n    \"validate-presets\",\n    \"validate-integrations\",\n    \"validate-packaging\",\n    \"validate-debug-artifact\",\n    \"validate-debug-seam-index\",\n    \"validate-quality-artifact\",\n    \"validate-inventory-consumption\",\n    \"check-inventory-declaration-coverage\",\n    \"inventory-skill-script-references\",\n    \"validate-quality-closeout-contract\",\n    \"validate-critique-artifacts\",\n    \"validate-ideation-artifact\",\n    \"validate-retro-artifact\",\n    \"validate-current-pointer-freshness\",\n    \"validate-maintainer-setup\",\n    \"check-python-filenames\",\n    \"check-skill-contracts\",\n    \"check-skill-bootstrap-vars\",\n    \"check-timing-layer-completeness\",\n    \"check-runtime-budget-universe\",\n    \"check-command-dominance\",\n    \"check-export-safe-imports\",\n    \"check-plugin-dir-references\",\n    \"check-supply-chain\",\n    \"check-github-actions\",\n    \"check-regenerable-facts\",\n    \"check-plugin-asset-command-carriers\",\n    \"validate-adapters\",\n    \"check-references-link-inventory\",\n    \"validate-skills\",\n    \"check-test-completeness\",\n    \"check-consumer-validator-catalog\",\n    \"validate-lesson-ledger\",\n    \"check-public-doc-coupling\",\n    \"check-command-docs\",\n    \"validate-retro-lesson-index\",\n    \"ruff\",\n    \"check-closeout-classification-parity\",\n    \"check-python-lengths\",\n    \"py-compile\",\n    \"run-evals\",\n    \"validate-packaging-committed\",\n    \"doc-duplicates\",\n    \"check-test-production-ratio\",\n    \"check-rust\",\n    \"check-shell\",\n    \"validate-skill-ergonomics\",\n    \"check-python-runtime-inheritance\",\n    \"validate-inference-interpretation\",\n    \"check-cli-skill-surface\",\n    \"specdown\",\n    \"check-subprocess-form\",\n    \"check-bootstrap-shim-consistency\",\n    \"check-wall-clock-form\",\n    \"check-module-eviction-form\",\n    \"check-provenance-contract\",\n    \"check-temp-producer-inventory\",\n    \"check-documented-subcommands\",\n    \"check-spec-evidence-durability\",\n    \"check-script-lookup-form\",\n    \"validate-attention-state-visibility\",\n    \"check-docs\",\n    \"check-coverage\",\n    \"check-export-self-sufficiency\",\n    \"check-timeout-bound-form\",\n    \"check-plugin-import-smoke\",\n    \"check-documented-command-flags\",\n    \"check-secrets\",\n    \"check-artifact-referents\",\n    \"check-unreferenced-scripts\",\n    \"validate-inventory-consumption-declaration\",\n    \"dup-ratchet\",\n    \"inventory-ci-local-gate-parity\",\n    \"measure-startup-probes\",\n    \"check-current-pointer-writes\",\n    \"inventory-cli-ergonomics\",\n    \"inventory-sloc\",\n    \"inventory-gitignore-scan-hygiene\",\n    \"inventory-nose-clones\",\n    \"check-seed-fixture-budget\",\n    \"check-runtime-budget\",\n    \"release-changed-line-coverage\"\n  ],\n  \"materialized_root\": \"plugins/charness\",\n  \"materialized_sha256\": \"618ab4810e9c529feef411e9fcd67ac6263b8bf71f00fccf1bf5d64b99668627\",\n  \"issued_at\": \"2026-09-15T03:20:42.711687+00:00\"\n}\n",
