    "prompt_content": "{\n  \"counterweight_triage\": [\n    {\n      \"bin\": \"non-blocking-positive\",\n      \"concern\": \"The implementation-lane prompt shaping and focused tests appear directionally consistent with #815.\",\n      \"disposition\": \"The code and tests cover prompt shaping, marker parsing, typed blockers, stalls, successful editing, passthrough behavior, and Muse prompt transmission; this does not substitute for release-candidate-bound execution evidence.\"\n    },\n    {\n      \"bin\": \"not-a-defect\",\n      \"concern\": \"The v8.7.1 public observer correctly limits what unauthenticated HTTP establishes.\",\n      \"disposition\": \"Its non-claim is appropriately bounded, but it proves the previous release rather than 8.7.2.\"\n    },\n    {\n      \"bin\": \"insufficient-for-approval\",\n      \"concern\": \"A complete repository quality run may have passed during earlier preparation.\",\n      \"disposition\": \"The supplied receipt is bound to another head, so it cannot approve the reviewed target or an 8.7.2 candidate.\"\n    }\n  ],\n  \"findings\": [\n    {\n      \"action\": \"Prepare and bind the actual 8.7.2 version surfaces, release record, quality receipt, claims review, and observer/proof records to the final 8.7.2 candidate commit.\",\n      \"evidence\": [\n        \"Scope requests approval of “8.7.2 release content” over v8.7.1.\",\n        \"charness-artifacts/release/latest.md states target version 8.7.1 and tag v8.7.1.\",\n        \"charness-artifacts/release/8.7.1-prepush-quality.json identifies the 8.7.1 receipt and verifies head 5d4d59eff391eadecc079e9099432c308c4b4071, not the packet target 23dc82206dd5f18fdc4524f55ad48286b63f5820.\",\n        \"The observer and prepared claims-review records bind v8.7.1 and prepared commit 34e767973e60fff9fcadf054e165085356e44f6b.\"\n      ],\n      \"id\": \"release-version-surface-mismatch\",\n      \"severity\": \"blocking\",\n      \"summary\": \"The packet does not establish an approvable 8.7.2 release surface; its release records, quality receipt, observer evidence, and claims review all identify 8.7.1.\"\n    },\n    {\n      \"action\": \"Run and include fresh identity-bound critique and proportionate verification for #815 at the final release candidate, then regenerate the claims review against that same candidate.\",\n      \"evidence\": [\n        \"The reviewed delta is 34e767973e60fff9fcadf054e165085356e44f6b..23dc82206dd5f18fdc4524f55ad48286b63f5820.\",\n        \"The claims review binds only prepared commit 34e767973e60fff9fcadf054e165085356e44f6b.\",\n        \"Its narrative says code correctness is out of scope and owned by a critique artifact and standing suite, but no identity-bound #815 critique result or test execution receipt for target 23dc82206dd5f18fdc4524f55ad48286b63f5820 is included.\",\n        \"The quality receipt verifies head 5d4d59eff391eadecc079e9099432c308c4b4071 rather than the reviewed target commit.\"\n      ],\n      \"id\": \"fix-not-covered-by-bound-release-proof\",\n      \"severity\": \"blocking\",\n      \"summary\": \"The #815 implementation-lane change occurs after the commit bound by the supplied release claims review, while that review explicitly excludes code correctness.\"\n    }\n  ],\n  \"kind\": \"charness.bounded_review.v1\",\n  \"lens\": \"release critique\",\n  \"next_move\": \"Defer publication and prepare a coherent 8.7.2 packet whose version surfaces and all release, quality, claims-review, and #815 verification evidence bind the same final candidate commit.\",\n  \"non_claims\": [\n    \"This review does not infer workspace state beyond the inline semantic payload.\",\n    \"This review does not claim the #815 implementation is incorrect; it finds the release approval evidence unbound to the requested 8.7.2 candidate.\",\n    \"No Goal Run binding was supplied; the lineage is not-goal-bound.\",\n    \"No workspace files were edited and no commands were run.\"\n  ],\n  \"packet_sha256\