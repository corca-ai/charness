  {
    "carrier_path": ".charness/scratch/critique-review/review-5443ca561459a2245db5e7700c9c3422/semantic-input/0027-content.bin",
    "carrier_sha256": "ac75e16f88d465100e9f575435d0394d667ce1d081538089299df81815e316f1",
