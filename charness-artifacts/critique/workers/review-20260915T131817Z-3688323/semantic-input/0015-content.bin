    \"check-public-doc-coupling\",\n    \"check-command-docs\",\n    \"validate-retro-lesson-index\",\n    \"ruff\",\n    \"check-closeout-classification-parity\",\n    \"check-python-lengths\",\n    \"py-compile\",\n    \"run-evals\",\n    \"validate-packaging-committed\",\n    \"doc-duplicates\",\n    \"check-test-production-ratio\",\n    \"check-rust\",\n    \"check-shell\",\n    \"validate-skill-ergonomics\",\n    \"check-python-runtime-inheritance\",\n    \"validate-inference-interpretation\",\n    \"check-cli-skill-surface\",\n    \"specdown\",\n    \"check-subprocess-form\",\n    \"check-bootstrap-shim-consistency\",\n    \"check-wall-clock-form\",\n    \"check-module-eviction-form\",\n    \"check-provenance-contract\",\n    \"check-temp-producer-inventory\",\n    \"check-documented-subcommands\",\n    \"check-spec-evidence-durability\",\n    \"check-script-lookup-form\",\n    \"validate-attention-state-visibility\",\n    \"check-docs\",\n    \"check-coverage\",\n    \"check-export-self-sufficiency\",\n    \"check-timeout-bound-form\",\n    \"check-plugin-import-smoke\",\n    \"check-documented-command-flags\",\n    \"check-secrets\",\n    \"check-artifact-referents\",\n    \"check-unreferenced-scripts\",\n    \"validate-inventory-consumption-declaration\",\n    \"dup-ratchet\",\n    \"inventory-ci-local-gate-parity\",\n    \"measure-startup-probes\",\n    \"check-current-pointer-writes\",\n    \"inventory-cli-ergonomics\",\n    \"inventory-sloc\",\n    \"inventory-gitignore-scan-hygiene\",\n    \"inventory-nose-clones\",\n    \"check-seed-fixture-budget\",\n    \"check-runtime-budget\",\n    \"release-changed-line-coverage\"\n  ],\n  \"materialized_root\": \"plugins/charness\",\n  \"materialized_sha256\": \"618ab4810e9c529feef411e9fcd67ac6263b8bf71f00fccf1bf5d64b99668627\",\n  \"issued_at\": \"2026-09-15T03:20:42.711687+00:00\"\n}\n",
