[
  {
    "carrier_path": ".charness/scratch/critique-review/review-8a73d43c41542590baff151d0115f810/semantic-input/0000-content.bin",
    "carrier_sha256": "1cc81a0cb950e28745a9b07b0d8d9d8ff9fad193a7dcdcb202f953c8e15a7b17",
