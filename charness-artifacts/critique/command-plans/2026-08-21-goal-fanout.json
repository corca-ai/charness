      ]
    },
    {
      "id": "check-issue-ledger",
      "argv": [
        "python3",
        "{target:issue-ledger-validator}",
        "--repo-root",
        ".",
        "--ledger",
        "charness-artifacts/issues/2026-08-20-next-release-ledger.json"
      ]
    },
    {
      "id": "read-current-release",
      "argv": [
        "python3",
        "{target:release-reader}",
        "--repo-root",
        "."
      ]
    }
