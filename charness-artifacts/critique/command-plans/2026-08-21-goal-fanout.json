      "query": "skills/public/achieve/scripts/check_goal_artifact.py",
      "expected_path": "skills/public/achieve/scripts/check_goal_artifact.py"
    },
    {
      "id": "issue-ledger-test",
      "query": "tests/quality_gates/test_release_issue_ledger.py",
      "expected_path": "tests/quality_gates/test_release_issue_ledger.py"
    },
    {
      "id": "release-reader",
      "query": "skills/public/release/scripts/current_release.py",
      "expected_path": "skills/public/release/scripts/current_release.py"
    },
    {
      "id": "issue-ledger-validator",
      "query": "scripts/check_release_issue_ledger.py",
      "expected_path": "scripts/check_release_issue_ledger.py"
    }
  ],
  "refs": [
    {
      "id": "semantic-candidate-base",
      "ref": "38775dfeb8d1e5574663d7ef461d19a63e252841"
    }
  ],
  "commands": [
    {
      "id": "validate-critique",
      "argv": [
        "python3",
        "{target:critique-validator}",
        "--repo-root",
        ".",
        "--all"
      ]
    },
    {
      "id": "check-goal",
      "argv": [
        "python3",
        "{target:goal-validator}",
        "--repo-root",
        ".",
        "--goal-path",
        "charness-artifacts/goals/2026-08-20-repairs-that-carry-their-class.md",
