#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"
source "$REPO_ROOT/.githooks/runtime-env.sh"

# stdin is read ONCE, here, and replayed to every consumer below. Two consumers now
# want it (the close-keyword guard and the diff classifier) and a git hook's stdin is
# a pipe: whichever ran first would drain it and the second would silently see an
# empty range. An empty range is indistinguishable from "nothing to check" at both,
# so the failure mode is a guard that passes by reading nothing.
push_stdin="$(cat)"

# The IRREVERSIBLE check runs first, before any expensive lane. A close keyword in a
# pushed commit message closes a GitHub issue the moment it lands on the default
# branch, and pushing again does not undo it (#626 was closed exactly this way by
# prose describing a future release). Everything else this hook checks is recoverable
# by another commit; this is not, so it is not worth spending 10 minutes of quality
# lane before finding out.
echo "charness pre-push: scanning the push range for GitHub close keywords"
# `$1` is the remote git is pushing to. It is forwarded because the guard bounds a
# ref CREATION by what that remote already has: hard-coding `origin` would exclude
# the wrong commits on any push to a second remote, and skip the ones under review.
printf '%s\n' "$push_stdin" | python3 scripts/prepush_close_keyword_guard.py \
  --repo-root "$REPO_ROOT" --remote "${1:-origin}"

# A release publish already ran a strict superset of this hook's broad quality
# lane. Its child `git push` may carry a one-push receipt bound to the clean HEAD,
# tree, repo, exact release command, and every local object on hook stdin. The
# irreversible close-keyword scan above always runs; only the duplicated quality
# lane below is eligible for reuse. A missing, stale, or malformed receipt falls
# back to normal validation instead of weakening an ordinary push.
prepush_receipt="${CHARNESS_PREPUSH_QUALITY_RECEIPT:-}"
if [[ -n "$prepush_receipt" ]]; then
  if printf '%s\n' "$push_stdin" | python3 scripts/prepush_quality_receipt.py validate \
      --repo-root "$REPO_ROOT" --receipt "$prepush_receipt" --consume; then
    echo "charness pre-push: reusing release quality receipt; duplicate broad gate omitted"
    exit 0
  fi
  echo "charness pre-push: release quality receipt was not reusable; running normal gate" >&2
fi

# Slice 7 (#230 Waste 3): classify the pending push to decide whether to run
# the full broad gate or a smaller docs-only subset. Stop condition is
# mechanically enforced by classify_push_diff_lib.UNCONDITIONAL_FULL_GATE_PREFIXES
# (plugins/, .claude-plugin/, .agents/plugins/).
# Pre-push stdin format per `git help githooks`:
#   <local-ref> SP <local-sha> SP <remote-ref> SP <remote-sha> LF
# The hook collects all <remote-sha>..<local-sha> pairs and classifies the
# union of their diffs.
zero="0000000000000000000000000000000000000000"
classify_input=""
saw_ref=0
saw_new_or_delete=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
  # A here-string always yields one line, so an empty stdin arrives as a blank line
  # with empty shas. Left unguarded that sets saw_ref=1 and runs `git diff ..` on an
  # empty range, which fails under `set -e` and aborts the push over nothing.
  [[ -z "$local_sha" || -z "$remote_sha" ]] && continue
  saw_ref=1
  if [[ "$local_sha" == "$zero" || "$remote_sha" == "$zero" ]]; then
    # New ref creation (no remote-sha to diff against) or ref deletion;
    # force the full gate rather than guess.
    saw_new_or_delete=1
    break
  fi
  if [[ -n "$classify_input" ]]; then
    classify_input+=$'\n'
  fi
  classify_input+=$(git diff --name-only "${remote_sha}..${local_sha}")
done <<< "$push_stdin"

force_full="${CHARNESS_FORCE_FULL_GATE:-0}"
if [[ "$saw_new_or_delete" == "1" || "$saw_ref" == "0" || "$force_full" == "1" ]]; then
  classification="full-gate-required"
  reason="new/deleted ref, no refs on stdin, or CHARNESS_FORCE_FULL_GATE=1"
else
  classification_payload="$(printf '%s\n' "$classify_input" | python3 scripts/classify_push_diff.py --paths-stdin --repo-root "$REPO_ROOT")"
  # JSON first, then YAML -- the same tolerance the Python readers carry, because
  # `render_yaml` emits compact JSON on an interpreter without PyYAML. A yaml-only
  # parse here would abort the push with a traceback on exactly that interpreter.
  read_field='import json,sys\nraw=sys.stdin.read()\ntry: d=json.loads(raw)\nexcept json.JSONDecodeError:\n    import yaml; d=yaml.safe_load(raw)\nprint(d[sys.argv[1]])'
  classification="$(printf '%s' "$classification_payload" | python3 -c "$(printf '%b' "$read_field")" classification)"
  reason="$(printf '%s' "$classification_payload" | python3 -c "$(printf '%b' "$read_field")" reason)"
fi

# Docs-only quality subset that still runs when classification = docs-artifact-only.
# These check the things a pure docs/artifact change could break and would
# otherwise land on remote unchecked (slice-7 critique F1). Order does not matter.
# `docs-graph` is here because reachability is the ONE property a docs-only push can
# break by itself: adding an unlinked page, or deleting the only link into an existing
# one, is exactly a docs-artifact-only change. Leaving it out meant the lane that
# catches orphans never ran on the change class that creates them. It is safe to add:
# it costs ~0.07s, and on a machine without `awiki` it reports UNPROVEN and blocks
# nothing rather than failing the push.
DOCS_ONLY_LABELS="$(
  python3 scripts/run_quality_engine.py \
    --repo-root "$REPO_ROOT" \
    --gates "$REPO_ROOT/.agents/quality-gates.yaml" \
    --print-docs-only-labels |
    python3 -c 'import sys; print(",".join(line.strip() for line in sys.stdin if line.strip()))'
)"

if [[ "$classification" == "docs-artifact-only" ]]; then
  echo "charness pre-push: docs/artifact-only push detected ($reason)"
  echo "charness pre-push: running docs-only quality subset (set CHARNESS_FORCE_FULL_GATE=1 to force full)"
  # Name the regime (#544). This subset is RECURRING and fixed, so its samples are
  # worth keeping comparable to each other under `<profile>.docs-only` rather than
  # falling into the shared `filtered` bucket an ad hoc label filter gets. All
  # fourteen also run in the full queue, where they measured 2.1x-4.8x slower;
  # three of them carry budgets, so for those the pooled window moved the
  # enforcement median for reasons unrelated to any change to the checked code.
  CHARNESS_RUNTIME_REGIME=docs-only \
    CHARNESS_QUALITY_LABELS="$DOCS_ONLY_LABELS" ./scripts/run-quality.sh --read-only
else
  echo "charness pre-push: running full ./scripts/run-quality.sh --read-only ($reason)"
  ./scripts/run-quality.sh --full --read-only
fi

if ! git diff --quiet -- charness-artifacts; then
  echo "charness pre-push: charness-artifacts/ mutated during a read-only quality run"
  echo "this is a structural bug — read-only mode should not touch git-tracked artifacts:"
  echo "review the offending phase against quality_phases.writes_git_tracked_artifact in"
  echo "skills/public/quality/references/adapter-contract.md, then add a read-only branch."
  git diff --stat -- charness-artifacts
  exit 1
fi
