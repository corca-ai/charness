#!/usr/bin/env bash
set -euo pipefail
REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

MUTATION_RECOVERY_DIR="$(git rev-parse --git-dir)/charness-mutation-recovery"
if [[ -e "$MUTATION_RECOVERY_DIR" || -e "$REPO_ROOT/.charness/mutation-recovery" ]]; then
  echo "charness pre-commit: interrupted mutation recovery is REQUIRED; run python3 scripts/mutate_and_restore.py --repo-root . --check-recovery, then --recover" >&2
  exit 2
fi

# Commit-time validation is intentionally local and cheap.  Slice closeout is an
# opt-in proof surface for changes that need it; making every commit build a
# closeout ledger was the largest source of friction in ordinary implementation.
if ! git diff --cached --check; then
  echo "charness pre-commit: staged whitespace errors" >&2
  exit 2
fi
