#!/usr/bin/env bash
set -euo pipefail
REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"
source "$REPO_ROOT/.githooks/runtime-env.sh"

MUTATION_RECOVERY_DIR="$(git rev-parse --git-dir)/charness-mutation-recovery"
if [[ -e "$MUTATION_RECOVERY_DIR" || -e "$REPO_ROOT/.charness/mutation-recovery" ]]; then
  echo "charness pre-commit: interrupted mutation recovery is REQUIRED; run python3 scripts/mutate_and_restore.py --repo-root . --check-recovery, then --recover" >&2
  exit 2
fi

python3 scripts/run_slice_closeout.py --repo-root "$REPO_ROOT" --predict-commit
