#!/usr/bin/env bash
set -euo pipefail
REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

MUTATION_RECOVERY_DIR="$(git rev-parse --git-dir)/charness-mutation-recovery"
if [[ -e "$MUTATION_RECOVERY_DIR" || -e "$REPO_ROOT/.charness/mutation-recovery" ]]; then
  echo "charness pre-commit: interrupted mutation recovery is REQUIRED; run python3 scripts/mutate_and_restore.py --repo-root . --check-recovery, then --recover" >&2
  exit 2
fi

# Commit-time validation is intentionally local and cheap; broader release proof
# belongs to the explicit release quality lane.
if ! git diff --cached --check; then
  echo "charness pre-commit: staged whitespace errors" >&2
  exit 2
fi

# This is advisory-only: it reads staged Python test hunks in two batched Git
# queries and names direct process/Git fixture construction without blocking a
# commit. A non-empty pytest.mark.boundary_contract(reason="...") records why a
# delivery boundary is intentional; this staged advisory makes new direct
# crossings visible without blocking the commit.
if ! python3 -B scripts/check_staged_test_boundaries.py --repo-root "$REPO_ROOT"; then
  echo "ADVISORY: staged test boundary review unavailable; commit was not blocked." >&2
fi

# This is an advisory boundary: the conditional consumes the checker's failure
# status while preserving its finding or unavailable-check output.
if ! python3 -B skills/public/quality/scripts/check_regenerable_facts.py --repo-root "$REPO_ROOT" --staged-paths; then
  echo "ADVISORY: regenerable-facts checker unavailable; commit was not blocked." >&2
fi

# Commit identity is stamped here and becomes expensive to repair after push.
# This existing checker caught the historical 62-commit `.invalid` incident;
# keep it wired directly to the cheap commit boundary instead of hiding it in a
# broad quality lane.
# Preserve every identity override Git exposes to the hook. `-B` prevents this
# small stdlib-only checker from leaving bytecode in the worktree without
# clearing Git configuration variables first.
python3 -B scripts/gates/check_git_identity.py --repo-root "$REPO_ROOT"

# The first-read instruction router is shared state for every future session, and
# the prose rule asking an agent to stop before editing it did not hold on its
# own. This refusal makes stopping the default; CHARNESS_ALLOW_ROUTER_CHANGE=1 is
# how the operator's approval takes effect.
python3 -B scripts/check_staged_router_change.py --repo-root "$REPO_ROOT"
