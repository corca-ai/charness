#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"
source "$REPO_ROOT/.githooks/runtime-env.sh"

python3 scripts/gates/check_issue_closeout_commit_msg.py --repo-root "$REPO_ROOT" --commit-msg-file "$1"
python3 scripts/hooks/check_release_lane_receipt.py --repo-root "$REPO_ROOT" --commit-msg-file "$1"
